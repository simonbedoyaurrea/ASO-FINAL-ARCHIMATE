        <property key="Origen" value="V1 del equipo (2026-10-15)"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Liquidar según fórmulas contractuales con soportes" id="id-85bcec586abb5f0997e4bb68c138cf71">
        <documentation>Elemento de la V1 del equipo.</documentation>
        <property key="Origen" value="V1 del equipo (2026-10-15)"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Proteger datos personales y de tarjeta" id="id-125db40fad8f5c488d76e029345b1cb0">
        <documentation>Elemento de la V1 del equipo.</documentation>
        <property key="Origen" value="V1 del equipo (2026-10-15)"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Registrar quién propuso, aprobó y cuándo" id="id-bd8bc9cc82c150419be37e1ee2c5d440">
        <documentation>Elemento de la V1 del equipo.</documentation>
        <property key="Origen" value="V1 del equipo (2026-10-15)"/>
      </element>
      <element xsi:type="archimate:Constraint" name="las trifas son fijadas por la autoridad" id="id-194a5572882358f4b824a87f7ffd8472">
        <documentation>Elemento de la V1 del equipo.</documentation>
        <property key="Origen" value="V1 del equipo (2026-10-15)"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Contratos de largo plazo y contratación pública" id="id-7d46bdcd5f3a57499d565f51d5096e86">
        <documentation>Elemento de la V1 del equipo.</documentation>
        <property key="Origen" value="V1 del equipo (2026-10-15)"/>
      </element>
      <element xsi:type="archimate:Principle" name="El saldo del usuario no es ingreso" id="id-63df6044f61455f4b47cc019f1bb93fc">
        <documentation>Elemento de la V1 del equipo.</documentation>
        <property key="Origen" value="V1 del equipo (2026-10-15)"/>
      </element>
      <element xsi:type="archimate:Principle" name="Doble verificación: sistema contra banco" id="id-11d10f2b12bf5ddb89f8f27415ed4f7e">
        <documentation>Elemento de la V1 del equipo.</documentation>
        <property key="Origen" value="V1 del equipo (2026-10-15)"/>
      </element>
      <element xsi:type="archimate:Principle" name="Nada se cuenta dos veces" id="id-3244df4f8e9255ac95ce97ee4bd11758">
        <documentation>Elemento de la V1 del equipo.</documentation>
        <property key="Origen" value="V1 del equipo (2026-10-15)"/>
      </element>
      <element xsi:type="archimate:Principle" name="Segregación de funciones" id="id-27fe014978ce5415977c47151517d20e">
        <documentation>Elemento de la V1 del equipo.</documentation>
        <property key="Origen" value="V1 del equipo (2026-10-15)"/>
      </element>
      <element xsi:type="archimate:Principle" name="Todo peso tiene dueño y rastro" id="id-8894faee08065296b38993aa359796f2">
        <documentation>Elemento de la V1 del equipo.</documentation>
        <property key="Origen" value="V1 del equipo (2026-10-15)"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Pasajeros (de la ciudad y visitantes)" id="id-bbb0d9f850055e1b99fdbe08154788fe">
        <documentation>Qué espera del recaudo: Cobrar bien, recargar fácil, no perder saldo, transbordar sin pagar dos veces y resolver reclamos rápido.</documentation>
        <property key="Fuente" value="Entrevista B1.1 (l. 49-57); T4"/>
        <property key="Nombre técnico" value="Usuarios (residentes y visitantes)"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Autoridad de transporte" id="id-5ea9c14fc08652009fa2db8dc2737966">
        <documentation>Qué espera del recaudo: Cifras confiables de demanda e ingresos para fijar tarifas, planear y rendir cuentas.</documentation>
        <property key="Fuente" value="Entrevista B1.1 (l. 49-57); Entrevista B2.4 (l. 144-149)"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Ente gestor" id="id-608148ed3ee0520ca88f18e3da202ee7">
        <documentation>Qué espera del recaudo: Planear, contratar, supervisar y conciliar con cifras verificables; es quien opera el sistema integrado y pide el software.</documentation>
        <property key="Fuente" value="Entrevista B2.1 (l. 119-128); T4"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Operadores de transporte" id="id-35434d2179f453d187ac7fcc7face8f7">
        <documentation>Qué espera del recaudo: Que se les liquide lo que les corresponde, a tiempo y de forma verificable.</documentation>
        <property key="Fuente" value="Entrevista B1.1 (l. 49-57)"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Alcaldía, Hacienda y Nación" id="id-97149074a688557294a23f2b91c5048b">
        <documentation>Qué espera del recaudo: Saber cuánto subsidio se necesita y que los recursos públicos no se pierdan.</documentation>
        <property key="Fuente" value="Entrevista B1.1 (l. 49-57)"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Fiduciaria y bancos" id="id-200b7f05760a5f3bb0caf4ab5f5c7fcb">
        <documentation>Qué espera del recaudo: Conciliar y dispersar dinero sin descuadres.</documentation>
        <property key="Fuente" value="Entrevista B1.1 (l. 49-57)"/>
        <property key="Nombre técnico" value="Fiduciaria y entidades financieras"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Tiendas y puntos de recarga" id="id-d821c9e97d4a556c9001d1ce3475a4b6">
        <documentation>Qué espera del recaudo: Comisión justa y pago oportuno.</documentation>
        <property key="Fuente" value="Entrevista B1.1 (l. 49-57)"/>
        <property key="Nombre técnico" value="Comercios y puntos de recarga"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Entes de control" id="id-4e5c658b6e475345b51e8118c40fca0e">
        <documentation>Qué espera del recaudo: Trazabilidad y cumplimiento.</documentation>
        <property key="Fuente" value="Entrevista B1.1 (l. 49-57)"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Veedurías y grupos ciudadanos" id="id-ac364e03d66a51adb3469cc5a9dea6b0">
        <documentation>Qué espera del recaudo: Transparencia y equidad.</documentation>
        <property key="Fuente" value="Entrevista B1.1 (l. 49-57)"/>
        <property key="Nombre técnico" value="Veedurías y organizaciones ciudadanas"/>
      </element>
      <element xsi:type="archimate:Driver" name="Necesidad de plata para operar el sistema" id="id-c0f6808e1692552989fdeb241b8c3776">
        <documentation>La tarifa al usuario suele ser menor que el costo técnico y la demanda cayó [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.2 (l. 58-64)"/>
        <property key="Nombre técnico" value="Presión financiera"/>
      </element>
      <element xsi:type="archimate:Driver" name="Gente que no paga y plata que se pierde" id="id-6b31940d2f9b581b9fd6cd8672e97f49">
        <documentation>Colados, uso indebido de tarifas diferenciales y fraude con tarjetas.</documentation>
        <property key="Fuente" value="Entrevista B1.2 (l. 58-64)"/>
        <property key="Nombre técnico" value="Evasión y fugas de ingreso"/>
      </element>
      <element xsi:type="archimate:Driver" name="Nuevas formas de pagar el pasaje" id="id-8fd25c8195ec59fbad92b4262c12580d">
        <documentation>El usuario espera pagar con su tarjeta bancaria sin comprar antes un medio propio [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.2 (l. 58-64)"/>
        <property key="Nombre técnico" value="Cambio tecnológico en medios de pago"/>
      </element>
      <element xsi:type="archimate:Driver" name="Leyes y normas que hay que cumplir" id="id-fa0a1642ceb758208bc0c0fba010995c">
        <documentation>Protección del consumidor, datos personales, interoperabilidad y control del gasto público.</documentation>
        <property key="Fuente" value="Entrevista B1.2 (l. 58-64)"/>
        <property key="Nombre técnico" value="Regulación"/>
      </element>
      <element xsi:type="archimate:Driver" name="Tarifas justas para quien lo necesita" id="id-951ac8f4e2215aa5acef60b4f62e823e">
        <documentation>Tarifas diferenciales, subsidios focalizados y accesibilidad para quien no tiene cuenta bancaria.</documentation>
        <property key="Fuente" value="Entrevista B1.2 (l. 58-64)"/>
        <property key="Nombre técnico" value="Equidad"/>
      </element>
      <element xsi:type="archimate:Driver" name="Lo que exige la gente" id="id-1eb5240150d55ecdb2af800beae599ca">
        <documentation>Menos tolerancia a las filas, a los saldos «perdidos» y a la falta de explicaciones.</documentation>
        <property key="Fuente" value="Entrevista B1.2 (l. 58-64)"/>
        <property key="Nombre técnico" value="Exigencia ciudadana"/>
      </element>
      <element xsi:type="archimate:Assessment" name="Sin plata no hay buses: el recaudo es la caja del sistema" id="id-7eaa02f16021503e9a7ee148bbec6d7b">
        <documentation>Urgencia 1 según el experto [Supuesto, su criterio].</documentation>
        <property key="Fuente" value="Entrevista B1.3 (l. 65-69)"/>
        <property key="Nombre técnico" value="Sin caja no hay operación: el recaudo es la caja"/>
      </element>
      <element xsi:type="archimate:Assessment" name="Muchos reclamos: recargas que no aparecen, cobros dobles y transbordos que no se reconocen" id="id-c82c840fb374586d9e4b9d533ce724f2">
        <documentation>Problemas más frecuentes [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B2.6 (l. 154-166); Entrevista B6.1 (l. 448-457)"/>
        <property key="Nombre técnico" value="Reclamos frecuentes por recargas no reflejadas, cobros dobles y transbordos no reconocidos"/>
      </element>
      <element xsi:type="archimate:Assessment" name="Errores al cobrar el transbordo o la tarifa con descuento" id="id-c3e0cac62c0757b7b45ffde639977ab7">
        <documentation>Fuente de pérdida de dinero y de reclamos [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B3.6 (l. 252-267); Entrevista B6.3 (l. 465-474)"/>
        <property key="Nombre técnico" value="Errores en la aplicación del transbordo o de la tarifa diferencial"/>
      </element>
      <element xsi:type="archimate:Assessment" name="Diferencias de plata sin cuadrar y cuadres casi a mano con terceros que usan formatos distintos" id="id-caac69bda99455db96d6f5225b624e6c">
        <documentation>Donde más tiempo se pierde [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B3.6 (l. 252-267); Entrevista B8.2 (l. 632-641)"/>
        <property key="Nombre técnico" value="Diferencias sin conciliar y conciliación semimanual con terceros de formatos distintos"/>
      </element>
      <element xsi:type="archimate:Assessment" name="El sistema central de recaudo lo maneja un tercero y hay sistemas viejos" id="id-b9186b7879bc50019019ef63f5842407">
        <documentation>«Es el corazón y no es mío»; cambiarla exige negociar el contrato [Supuesto].</documentation>
        <property key="Fuente" value="Entrevista B8.2 (l. 632-641); Entrevista B8.5 (l. 670-679)"/>
        <property key="Nombre técnico" value="Plataforma central de recaudo en manos de un tercero y sistemas heredados"/>
      </element>
      <element xsi:type="archimate:Assessment" name="Pagar con tarjeta del banco facilita viajar, pero trae cobros rechazados y devoluciones después del viaje" id="id-d5f8044a6dc65c2aa5fdb93a25f73409">
        <documentation>[Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.3 (l. 65-69); Entrevista B2.5 (l. 150-153)"/>
        <property key="Nombre técnico" value="El pago con tarjeta bancaria baja barreras, pero trae rechazos y contracargos después del viaje"/>
      </element>
      <element xsi:type="archimate:Assessment" name="Descuentos usados por otras personas o con certificados vencidos" id="id-a4f6109a826552cd8fb9b227aa6b6c5f">
        <documentation>Uso indebido de tarifas especiales [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B2.6 (l. 154-166); Entrevista B6.5 (l. 483-496)"/>
        <property key="Nombre técnico" value="Beneficios usados por terceros o con certificados vencidos"/>
      </element>
      <element xsi:type="archimate:Goal" name="Residentes y visitantes pagan su viaje de forma ágil y con la tarifa que les corresponde" id="id-63ea7c03c0df5ff48c45324059448cf9">
        <documentation>Solicitud literal del Tema 4.</documentation>
        <property key="Fuente" value="T4"/>
      </element>
      <element xsi:type="archimate:Goal" name="Que cada peso que paga el pasajero llegue completo, a tiempo y con soporte a quien le corresponde" id="id-83f1215f95a35ebfb7f16ef27604bdb5">
        <documentation>Lo que busca la gerencia con el recaudo.</documentation>
        <property key="Fuente" value="Entrevista B1.4 (l. 70-80)"/>
        <property key="Nombre técnico" value="Cada peso pagado por el pasajero llega a quien corresponde, completo, a tiempo y con evidencia"/>
      </element>
      <element xsi:type="archimate:Goal" name="Que los descuentos los reciba solo quien cumple las condiciones" id="id-70411d2053ec5e7d907fdcb6cc06ad40">
        <documentation>Alcance del Tema 4 («validación de que el usuario cumple las condiciones») y control de uso indebido.</documentation>
        <property key="Fuente" value="T4; Entrevista B5.2 (l. 372-380); Entrevista B6.5 (l. 483-496)"/>
        <property key="Nombre técnico" value="Los beneficios tarifarios los reciben solo quienes cumplen las condiciones de su perfil"/>
      </element>
      <element xsi:type="archimate:Goal" name="Que los problemas de saldo y cobro se resuelvan rápido y dejando rastro" id="id-5354d33793d85ec1887321aad20280f0">
        <documentation>Necesidad común a todos los usuarios: saber el saldo, no ser cobrados dos veces y obtener respuesta con plazo.</documentation>
        <property key="Fuente" value="Entrevista B4.5 (l. 325-331); Entrevista B6.7 (l. 503-515)"/>
        <property key="Nombre técnico" value="Los problemas de saldo y cobro del usuario se resuelven con rapidez y trazabilidad"/>
      </element>
      <element xsi:type="archimate:Outcome" name="Cada pasada por el validador queda cobrada con la tarifa y el transbordo vigentes" id="id-7beffbb353d15db99fd8532ab6fbef81">
        <documentation>Resultado que se busca. Se mide con: Reclamos por cobro doble o transbordo no reconocido, por causa raíz (B7.1). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
        <property key="Indicador" value="Reclamos por cobro doble o transbordo no reconocido, por causa raíz (B7.1)"/>
        <property key="Fuente" value="Entrevista B6.3 (l. 465-474); Entrevista B7.1 (l. 533-559)"/>
        <property key="Nombre técnico" value="Cada validación queda cobrada con la tarifa y la integración vigentes"/>
      </element>
      <element xsi:type="archimate:Outcome" name="Los visitantes viajan sin tener que comprar una tarjeta" id="id-f0e9b1d2a62a5b5aa0ab8757a9cfa49f">
        <documentation>Resultado que se busca. Se mide con: Participación de las tarjetas bancarias en las validaciones [indicador propuesto por el diseño; el experto no lo nombró]. Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
        <property key="Indicador" value="Participación de las tarjetas bancarias en las validaciones [indicador propuesto por el diseño; el experto no lo nombró]"/>
        <property key="Fuente" value="T4; Entrevista B2.5 (l. 150-153)"/>
        <property key="Nombre técnico" value="Los visitantes viajan sin adquirir una tarjeta propia"/>
      </element>
      <element xsi:type="archimate:Outcome" name="La plata que entra cuadra con la que debía entrar según las validaciones" id="id-992e0708ded350cfbe267e58a3608852">
        <documentation>Resultado que se busca. Se mide con: Recaudo efectivo ÷ valor de validaciones y recargas del periodo (B7.2). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
        <property key="Indicador" value="Recaudo efectivo ÷ valor de validaciones y recargas del periodo (B7.2)"/>
        <property key="Fuente" value="Entrevista B1.4 (l. 70-80); Entrevista B7.2 (l. 560-571)"/>
        <property key="Nombre técnico" value="El recaudo efectivo coincide con el esperado según las validaciones"/>
      </element>
      <element xsi:type="archimate:Outcome" name="Llegan completas, a tiempo y sin repetir las transacciones de los tres modos" id="id-13a28167b0705e2db6d33d37b46d3ac5">
        <documentation>Resultado que se busca. Se mide con: Equipos que reportaron en el plazo ÷ equipos en servicio (B7.2). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
        <property key="Indicador" value="Equipos que reportaron en el plazo ÷ equipos en servicio (B7.2)"/>
        <property key="Fuente" value="Entrevista B6.4 (l. 475-482); Entrevista B7.2 (l. 560-571)"/>
        <property key="Nombre técnico" value="Las transacciones de los tres modos se reciben completas, a tiempo y sin duplicados"/>
      </element>
      <element xsi:type="archimate:Outcome" name="La base consolidada por modo, ruta y operador se entrega cerrada y a tiempo, y cada diferencia que devuelve la conciliación se resuelve con un ajuste" id="id-662a281a8fa35574a6957d7d8a234ca5">
        <documentation>Resultado que se busca. Se mide con: Días cerrados entregados a tiempo; valor y antigüedad de las diferencias que devuelve la conciliación; ajustes manuales (B7.1, B7.5). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
        <property key="Indicador" value="Días cerrados entregados a tiempo; valor y antigüedad de las diferencias que devuelve la conciliación; ajustes manuales (B7.1, B7.5)"/>
        <property key="Fuente" value="T4; Entrevista B7.1 (l. 533-559); Entrevista B7.5 (l. 592-600)"/>
      </element>
      <element xsi:type="archimate:Outcome" name="Solo quien tiene el certificado vigente paga tarifa con descuento" id="id-e273da232e4f5fa39b005e505fcd8f73">
        <documentation>Resultado que se busca. Se mide con: Uso de tarifas especiales por perfil y casos sospechosos revisados (B7.1). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
        <property key="Indicador" value="Uso de tarifas especiales por perfil y casos sospechosos revisados (B7.1)"/>
        <property key="Fuente" value="Entrevista B6.5 (l. 483-496); Entrevista B7.1 (l. 533-559)"/>
        <property key="Nombre técnico" value="Solo los titulares con certificación vigente usan tarifas especiales"/>
      </element>
      <element xsi:type="archimate:Outcome" name="Los reclamos de saldo y cobro se resuelven dentro del plazo" id="id-c410b7e848f151e9939838c05e6a04ef">
        <documentation>Resultado que se busca. Se mide con: Reclamos respondidos en plazo ÷ radicados; reclamos por 100.000 validaciones (B7.2). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
        <property key="Indicador" value="Reclamos respondidos en plazo ÷ radicados; reclamos por 100.000 validaciones (B7.2)"/>
        <property key="Fuente" value="Entrevista B6.7 (l. 503-515); Entrevista B7.2 (l. 560-571)"/>
      </element>
      <element xsi:type="archimate:Principle" name="No mezclar la plata: el recaudo no entra a la caja de nadie" id="id-19fab029df085a79b7b7dc3164ee174a">
        <documentation>«Regla de oro» con dinero público de pasajeros [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.6 (l. 90-98)"/>
        <property key="Nombre técnico" value="Separación de dineros: el recaudo no se mezcla con la caja de nadie"/>
      </element>
      <element xsi:type="archimate:Principle" name="Cada peso tiene dueño y deja rastro" id="id-5966fd1f1cdd5a31b50699ad08c3293a">
        <documentation>«Regla de oro» con dinero público de pasajeros [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.6 (l. 90-98)"/>
        <property key="Nombre técnico" value="Todo peso tiene dueño y rastro"/>
      </element>
      <element xsi:type="archimate:Principle" name="Doble revisión: lo que dicen las validaciones se compara con el banco" id="id-a45b0fdfe9195a518d555fa871bc2b86">
        <documentation>«Regla de oro» con dinero público de pasajeros [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.6 (l. 90-98)"/>
        <property key="Nombre técnico" value="Doble verificación: lo que dice la validación se contrasta con el banco"/>
      </element>
      <element xsi:type="archimate:Principle" name="Cierres diarios y cortes claros" id="id-80e0a8c33bcc576a99ee0e06e3c0cf24">
        <documentation>«Regla de oro» con dinero público de pasajeros [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.6 (l. 90-98)"/>
      </element>
      <element xsi:type="archimate:Principle" name="Quien opera, quien liquida y quien audita son personas distintas" id="id-b5680912ca41568c859b52c0b927030d">
        <documentation>«Regla de oro» con dinero público de pasajeros [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.6 (l. 90-98)"/>
        <property key="Nombre técnico" value="Segregación de funciones: quien opera, quien liquida y quien audita son distintos"/>
      </element>
      <element xsi:type="archimate:Principle" name="El saldo del usuario no es ganancia: es plata ajena" id="id-ba107a466f365c2295b0b43fd325856e">
        <documentation>«Regla de oro» con dinero público de pasajeros [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.6 (l. 90-98)"/>
        <property key="Nombre técnico" value="El saldo del usuario no es un ingreso: es dinero ajeno"/>
      </element>
      <element xsi:type="archimate:Principle" name="Nada se cuenta dos veces ni se pierde; cada corrección deja rastro" id="id-10941d4d77205c5e9b271d129306c01e">
        <documentation>«Regla de oro» con dinero público de pasajeros [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.6 (l. 90-98)"/>
        <property key="Nombre técnico" value="Nada se cuenta dos veces ni se pierde; toda corrección deja huella"/>
      </element>
      <element xsi:type="archimate:Principle" name="Cuentas claras ante la autoridad y los operadores" id="id-95a5a363656a57e19c932c2ff9978cc4">
        <documentation>«Regla de oro» con dinero público de pasajeros [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.6 (l. 90-98)"/>
        <property key="Nombre técnico" value="Transparencia hacia la autoridad y los operadores"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Recaudar en los tres modos con VAMOS y con tarjetas débito y crédito" id="id-6364f857fddf5beeba44345c1180dab6">
        <documentation>Alcance literal del Tema 4.</documentation>
        <property key="Fuente" value="T4"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Gestionar la tarjeta VAMOS: emisión, recargas, consulta de saldo y bloqueo por pérdida" id="id-ca11ad822ab6573db32566d916e0119a">
        <documentation>Alcance literal del Tema 4.</documentation>
        <property key="Fuente" value="T4"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Gestionar la tarifa plena y las tarifas especiales para estudiantes de colegio, universitarios, adultos mayores y personas con movilidad reducida, validando que el usuario cumple las condiciones de su perfil" id="id-5ac6b0a263ef54baba36839e5839b215">
        <documentation>Alcance literal del Tema 4.</documentation>
        <property key="Fuente" value="T4"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Aplicar la tarifa correcta en cada validación, considerando la integración entre modos" id="id-dc8f1c3f82b158d39c5558ebe77520fb">
        <documentation>Alcance literal del Tema 4.</documentation>
        <property key="Fuente" value="T4"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Consolidar el recaudo por modo, ruta y operador como base para la distribución y la conciliación" id="id-00d315235aa157aca4bbe201615e7282">
        <documentation>Alcance literal del Tema 4.</documentation>
        <property key="Fuente" value="T4"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Registrar cada transacción una sola vez y en el día de servicio en que pasó" id="id-802d616e654357b1a53b50a747d0314f">
        <documentation>Derivado de lo que dijo el experto (la entrevista no preguntó requerimientos).</documentation>
        <property key="Fuente" value="Entrevista B6.4 (l. 475-482); Entrevista B8.4 (l. 654-669)"/>
        <property key="Nombre técnico" value="Registrar cada transacción una sola vez y asignarla al día de servicio en que ocurrió"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Corregir saldos y transacciones solo con ajustes autorizados que dejan rastro, nunca editándolos" id="id-745c4e30845a57c997f3122bbfab2c27">
        <documentation>Derivado de lo que dijo el experto (la entrevista no preguntó requerimientos).</documentation>
        <property key="Fuente" value="Entrevista B8.4 (l. 654-669); Entrevista B4.3 (l. 311-318)"/>
        <property key="Nombre técnico" value="Corregir saldos y transacciones solo con ajustes autorizados que dejan huella, nunca editándolos"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Que quien propone un ajuste, una devolución o un desbloqueo no sea quien lo aprueba" id="id-aeef26ab26e25356bcdbc0ac2625f716">
        <documentation>Derivado de lo que dijo el experto (la entrevista no preguntó requerimientos).</documentation>
        <property key="Fuente" value="Entrevista B4.3 (l. 311-318); Entrevista B9.7 (l. 784-788)"/>
        <property key="Nombre técnico" value="Separar quien propone un ajuste, una devolución o un desbloqueo de quien lo aprueba"/>
      </element>
      <element xsi:type="archimate:Requirement" name="No guardar el número completo de las tarjetas del banco: usar un código que lo reemplace (token)" id="id-f7fcda4c792c5dee9e1fa25d2afd73dd">
        <documentation>Derivado de lo que dijo el experto (la entrevista no preguntó requerimientos).</documentation>
        <property key="Fuente" value="Entrevista B9.8 (l. 789-798); Entrevista B10.3 (l. 903-917)"/>
        <property key="Nombre técnico" value="No conservar el número completo de las tarjetas bancarias: usar un identificador tokenizado"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Enviar a los equipos las tarifas, los perfiles y las tarjetas bloqueadas para que funcionen sin internet" id="id-0e5e2d0057c85e6cbd0fd4c05392772e">
        <documentation>Derivado de lo que dijo el experto (la entrevista no preguntó requerimientos).</documentation>
        <property key="Fuente" value="Entrevista B9.11 (l. 817-829); Entrevista B9.13 (l. 841-852)"/>
        <property key="Nombre técnico" value="Publicar tarifas, perfiles y listas de bloqueo para que los equipos operen sin conexión"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Guardar el soporte de cada certificado de perfil y de cada decisión sobre él" id="id-2d005d38f1e357bf91889870ded688bc">
        <documentation>Derivado de lo que dijo el experto (la entrevista no preguntó requerimientos).</documentation>
        <property key="Fuente" value="Entrevista B9.9 (l. 799-807); Entrevista B5.3 (l. 381-387)"/>
        <property key="Nombre técnico" value="Conservar la evidencia de cada certificación de perfil y de cada decisión sobre él"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Avisar al usuario de sus recargas, bloqueos y cobros, y al titular antes de que venza su perfil o cuando se le revoque" id="id-5fe661715eba54279be05041af1330a3">
        <documentation>Derivado de lo que dijo el experto (la entrevista no preguntó requerimientos).</documentation>
        <property key="Fuente" value="Entrevista B9.12 (l. 830-840); Entrevista B5.3 (l. 381-387); Entrevista B5.8 (l. 418-427)"/>
      </element>
      <element xsi:type="archimate:Constraint" name="La tarifa la fija la autoridad; el recaudo no la decide" id="id-f8b7b7b90f0f5553b0fcee48895018b6">
        <documentation>Limita cómo se pueden cumplir los requerimientos.</documentation>
        <property key="Fuente" value="Entrevista B1.5 (l. 81-89); Entrevista B4.4 (l. 319-324)"/>
        <property key="Nombre técnico" value="La tarifa al usuario la fija la autoridad; el recaudo no la decide"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Los validadores, lectores y demás aparatos no son parte de la aplicación: solo se reciben sus transacciones" id="id-c2937893139d5212b91eaa988328c045">
        <documentation>Limita cómo se pueden cumplir los requerimientos.</documentation>
        <property key="Fuente" value="T4"/>
        <property key="Nombre técnico" value="Los validadores, lectores, dispositivos e IoT están fuera del alcance: solo se reciben sus transacciones"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Es plata pública: tiene control fiscal, contratación pública y control interno [normas por verificar]" id="id-985901f1bd0950d1a8afabd0f9a423e1">
        <documentation>Limita cómo se pueden cumplir los requerimientos.</documentation>
        <property key="Fuente" value="Entrevista B1.5 (l. 81-89); Entrevista B10.4 (l. 918-928)"/>
        <property key="Nombre técnico" value="Recursos públicos sujetos a control fiscal, contratación pública y control interno [normas por verificar]"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Protección de datos personales (Ley 1581 de 2012), incluidos datos sensibles de perfiles y de menores" id="id-47dbfbcf46fc5ff5908d390330884910">
        <documentation>Limita cómo se pueden cumplir los requerimientos.</documentation>
        <property key="Fuente" value="Entrevista B1.5 (l. 81-89); Entrevista B10.3 (l. 903-917); contrastada con el texto de la ley publicado por la Rama Judicial (H-41)"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Plazos de ley para responder peticiones (Ley 1755 de 2015: 15 días en general, 10 para documentos, 30 para consultas)" id="id-9e4202f5e6125735af15815db24c0d3d">
        <documentation>Limita cómo se pueden cumplir los requerimientos.</documentation>
        <property key="Fuente" value="Entrevista B10.5 (l. 929-937); contrastada con el texto de la ley publicado por entidades públicas (H-42)"/>
        <property key="Nombre técnico" value="Plazos legales de respuesta a peticiones (Ley 1755 de 2015: 15 días como regla general, 10 para documentos, 30 para consultas)"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Contratos largos con el concesionario y formatos de otros que el ente gestor no define" id="id-31b47fd6c4b250debb685167ce6e4a52">
        <documentation>Limita cómo se pueden cumplir los requerimientos.</documentation>
        <property key="Fuente" value="Entrevista B8.5 (l. 670-679)"/>
        <property key="Nombre técnico" value="Contratos de largo plazo con el concesionario y formatos externos que no define el ente gestor"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Mala conexión en estaciones y buses, y hora pico con miles de personas por validador" id="id-1532473414e5588bbb8f59d5373f5c68">
        <documentation>Limita cómo se pueden cumplir los requerimientos.</documentation>
        <property key="Fuente" value="Entrevista B1.5 (l. 81-89); Entrevista B6.4 (l. 475-482)"/>
        <property key="Nombre técnico" value="Conectividad imperfecta en estaciones y buses, y hora pico con miles de personas por validador"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Reglas de las franquicias de tarjetas y norma PCI-DSS para sus datos (norma del sector, no ley)" id="id-3b24906aa01658478ab3d5787b26cdfa">
        <documentation>Limita cómo se pueden cumplir los requerimientos.</documentation>
        <property key="Fuente" value="Entrevista B3.3 (l. 217-228); Entrevista B10.3 (l. 903-917)"/>
        <property key="Nombre técnico" value="Reglas de franquicias y estándar PCI-DSS para datos de tarjeta (estándar del sector, no ley)"/>
      </element>
      <element xsi:type="archimate:Value" name="Pagar rápido, con la tarifa correcta y sabiendo dónde está cada peso" id="id-af0f54603b915d09a662360e30450e96">
        <documentation>Valor que entrega la cadena al usuario y al ente gestor.</documentation>
        <property key="Fuente" value="T4; Entrevista B1.4 (l. 70-80)"/>
        <property key="Nombre técnico" value="Pago ágil con la tarifa correcta y cada peso trazable"/>
      </element>
    </folder>
    <folder name="Fase 3 · Dominios y lenguaje ubicuo" id="id-b6b1792c3270580b90e54426c7ba5ed2">
      <element xsi:type="archimate:Meaning" name="Pasar el medio de pago por un equipo para entrar; deja una transacción." id="id-25233cc108a55452a90dabdc8f6a5ee5">
        <documentation>Definición de «Validación».</documentation>
        <property key="Término" value="Validación"/>
        <property key="Contexto" value="BC-TRX, BC-TAR"/>
        <property key="Ejemplo" value="Pasar la VAMOS por el validador del alimentador."/>
        <property key="Nombre técnico" value="Uso del medio de pago en un equipo para acceder a un servicio: genera una transacción."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Cada subida al sistema, vista como parte de un viaje." id="id-044e3c8a85e452b8996b23f89ec3d262">
        <documentation>Definición de «Abordaje».</documentation>
        <property key="Término" value="Abordaje"/>
        <property key="Contexto" value="BC-TAR"/>
        <property key="Ejemplo" value="Un viaje alimentador + articulado tiene dos abordajes."/>
        <property key="Nombre técnico" value="Cada validación vista como parte de un viaje."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Varias subidas con el mismo medio que se unen por el transbordo." id="id-3d7a5081a8635ffb80898078dadb5a23">
        <documentation>Definición de «Viaje».</documentation>
        <property key="Término" value="Viaje"/>
        <property key="Contexto" value="BC-TAR"/>
        <property key="Ejemplo" value="Alimentador a las 7:05 y articulado a las 7:30 con una sola tarifa."/>
        <property key="Nombre técnico" value="Conjunto de abordajes del mismo medio enlazados por la integración tarifaria."/>
      </element>
      <element xsi:type="archimate:Meaning" name="La siguiente subida, dentro del tiempo permitido, que no paga la tarifa completa." id="id-0ed9019c33955b33ba7b536ef51370f5">
        <documentation>Definición de «Transbordo».</documentation>
        <property key="Término" value="Transbordo"/>
        <property key="Contexto" value="BC-TAR"/>
        <property key="Ejemplo" value="Cambiar de alimentador a articulado."/>
        <property key="Nombre técnico" value="Abordaje siguiente dentro de la ventana que no paga tarifa completa."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Tiempo desde la primera subida en el que vale el transbordo [valor configurable]." id="id-582b19ec936c5631851c46e76b443397">
        <documentation>Definición de «Ventana de transbordo».</documentation>
        <property key="Término" value="Ventana de transbordo"/>
        <property key="Contexto" value="BC-TAR"/>
        <property key="Ejemplo" value="El experto mencionó 60 a 90 minutos como supuesto."/>
        <property key="Nombre técnico" value="Tiempo desde el primer abordaje en el que aplica la integración [valor configurable]."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Tarifa normal, sin descuento." id="id-438029447412518cb1edc6a0008874a6">
        <documentation>Definición de «Tarifa plena».</documentation>
        <property key="Término" value="Tarifa plena"/>
        <property key="Contexto" value="BC-TAR"/>
        <property key="Ejemplo" value="La que paga un visitante con tarjeta bancaria."/>
        <property key="Nombre técnico" value="Tarifa al usuario sin beneficio."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Tarifa con descuento para un perfil autorizado por la autoridad." id="id-3223d33575c45cd592de8812ba8af383">
        <documentation>Definición de «Tarifa especial».</documentation>
        <property key="Término" value="Tarifa especial"/>
        <property key="Contexto" value="BC-TAR, BC-PER"/>
        <property key="Ejemplo" value="Estudiante universitario."/>
        <property key="Nombre técnico" value="Tarifa reducida de un perfil autorizado por la autoridad."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Lo que descontó el equipo en el momento de pasar el medio de pago." id="id-3c8d7e3dc72f5035b1c3428af5e30c08">
        <documentation>Definición de «Tarifa aplicada».</documentation>
        <property key="Término" value="Tarifa aplicada"/>
        <property key="Contexto" value="BC-TRX"/>
        <property key="Ejemplo" value="El validador descontó una tarifa plena."/>
        <property key="Nombre técnico" value="Valor que descontó el equipo en el momento de la validación."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Lo que debía cobrarse según la versión tarifaria, el perfil y el transbordo; la calcula la aplicación." id="id-95aadad562205dfdbe15ba65d4538968">
        <documentation>Definición de «Tarifa correcta».</documentation>
        <property key="Término" value="Tarifa correcta"/>
        <property key="Contexto" value="BC-TAR"/>
        <property key="Ejemplo" value="Debía ser transbordo y el equipo cobró completo: diferencia detectada."/>
        <property key="Nombre técnico" value="Valor que corresponde según la versión tarifaria, el perfil y la integración; la determina la aplicación."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Tarifas y reglas de transbordo que rigen desde una fecha, según una decisión de la autoridad." id="id-d708d9ec310c57a39ba926b02830a9cd">
        <documentation>Definición de «Versión tarifaria».</documentation>
        <property key="Término" value="Versión tarifaria"/>
        <property key="Contexto" value="BC-TAR"/>
        <property key="Ejemplo" value="La versión que entra en vigencia el primer día hábil del año."/>
        <property key="Nombre técnico" value="Conjunto de tarifas y reglas de integración con una vigencia, según un acto de la autoridad."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Derecho de una persona a tarifa con descuento: estudiante de colegio, universitario, adulto mayor o persona con movilidad reducida (Tema 4), con vigencia y estado." id="id-19c4d0c2bd1e5a349189dd1d0f422fd8">
        <documentation>Definición de «Perfil especial».</documentation>
        <property key="Término" value="Perfil especial"/>
        <property key="Contexto" value="BC-PER"/>
        <property key="Ejemplo" value="Perfil adulto mayor activo."/>
        <property key="Nombre técnico" value="Derecho de un titular a una tarifa especial: estudiante de colegio, universitario, adulto mayor o persona con movilidad reducida (T4), con vigencia y estado."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Soporte de una entidad certificadora de que la persona cumple las condiciones." id="id-cc56487a60795e2a8fe67f3503c4cf28">
        <documentation>Definición de «Certificación».</documentation>
        <property key="Término" value="Certificación"/>
        <property key="Contexto" value="BC-PER"/>
        <property key="Ejemplo" value="Listado de matrícula de una universidad."/>
        <property key="Nombre técnico" value="Evidencia de una entidad certificadora de que el titular cumple las condiciones."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Tarjeta de pago propia de la ciudad, anónima o personalizada." id="id-a6a732b5d7535b95b9de314a47eec222">
        <documentation>Definición de «Tarjeta VAMOS».</documentation>
        <property key="Término" value="Tarjeta VAMOS"/>
        <property key="Contexto" value="BC-MED"/>
        <property key="Ejemplo" value="Tarjeta comprada en una taquilla."/>
        <property key="Nombre técnico" value="Medio de pago propio de la ciudad, anónimo o personalizado."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Tarjeta VAMOS a nombre de una persona; permite perfil y reposición con saldo." id="id-b82be760c7bc5de1b0e9f3192f97b7d9">
        <documentation>Definición de «Tarjeta personalizada».</documentation>
        <property key="Término" value="Tarjeta personalizada"/>
        <property key="Contexto" value="BC-MED, BC-PER"/>
        <property key="Ejemplo" value="La del estudiante con su documento."/>
        <property key="Nombre técnico" value="Tarjeta VAMOS registrada a nombre de un titular; permite perfil y reposición con saldo."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Persona dueña de una tarjeta personalizada." id="id-9bdac85588915de8bdf3941bb1be6ef0">
        <documentation>Definición de «Titular».</documentation>
        <property key="Término" value="Titular"/>
        <property key="Contexto" value="BC-MED, BC-PER"/>
        <property key="Ejemplo" value="Quien reporta la pérdida."/>
        <property key="Nombre técnico" value="Persona registrada en una tarjeta personalizada."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Último saldo que la aplicación conoce por las transacciones que le llegan; el saldo real está en la tarjeta." id="id-f61f4f6a26dc5ddeb74395e62c3daedc">
        <documentation>Definición de «Saldo conocido».</documentation>
        <property key="Término" value="Saldo conocido"/>
        <property key="Contexto" value="BC-MED"/>
        <property key="Ejemplo" value="Consulta en la app: «saldo a las 18:40 de ayer»."/>
        <property key="Nombre técnico" value="Último saldo de una tarjeta que la aplicación conoce por las transacciones recibidas; el saldo real está en la tarjeta."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Recarga por internet ya pagada que todavía no se ha escrito en la tarjeta." id="id-2f4469ca15b15edcafdc9cd17658e401">
        <documentation>Definición de «Recarga pendiente».</documentation>
        <property key="Término" value="Recarga pendiente"/>
        <property key="Contexto" value="BC-MED"/>
        <property key="Ejemplo" value="«Pagué y no tengo saldo»."/>
        <property key="Nombre técnico" value="Recarga virtual pagada que aún no se escribió en la tarjeta."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Tarjeta que los equipos deben rechazar, con su causa (pérdida, fraude o deuda)." id="id-13f37efa6ef750b5af258e20d8800aac">
        <documentation>Definición de «Bloqueo».</documentation>
        <property key="Término" value="Bloqueo"/>
        <property key="Contexto" value="BC-MED, BC-PAB"/>
        <property key="Ejemplo" value="Tarjeta reportada como robada."/>
        <property key="Nombre técnico" value="Estado de un medio que los equipos deben rechazar, con causa (pérdida, fraude o deuda)."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Tarjeta personalizada nueva con el saldo que tenía la anterior a la hora en que el bloqueo ya regía en los equipos; se calcula cuando cerraron esos días." id="id-18d59fadd6c95577a5f700c9e35a0607">
        <documentation>Definición de «Reposición».</documentation>
        <property key="Término" value="Reposición"/>
        <property key="Contexto" value="BC-MED"/>
        <property key="Ejemplo" value="Tras la pérdida, con documento."/>
        <property key="Nombre técnico" value="Entrega de una nueva tarjeta personalizada con el saldo conocido a la hora del bloqueo efectivo, calculado cuando ya cerraron esos días de servicio."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Código que reemplaza el número de la tarjeta del banco." id="id-f96c19ad72335b13a0cc44c00f79442d">
        <documentation>Definición de «Token».</documentation>
        <property key="Término" value="Token"/>
        <property key="Contexto" value="BC-PAB"/>
        <property key="Ejemplo" value="Nunca se ve el número completo."/>
        <property key="Nombre técnico" value="Identificador que reemplaza el número de la tarjeta bancaria."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Cargo a la tarjeta del banco por los viajes acumulados: al cierre del día o antes si se pasa el umbral; puede haber más de un cargo al día, hasta el máximo configurado." id="id-9a20a235c6f5539ea45192ba07eae6d9">
        <documentation>Definición de «Cobro agrupado».</documentation>
        <property key="Término" value="Cobro agrupado"/>
        <property key="Contexto" value="BC-PAB"/>
        <property key="Ejemplo" value="Tres abordajes del día se cobran juntos en el cargo del cierre."/>
        <property key="Nombre técnico" value="Cargo a una tarjeta bancaria por los viajes acumulados: al cierre del día de servicio o antes si se supera el umbral; puede haber más de un cargo al día, hasta el máximo configurado."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Viajes ya hechos cuyo cobro fue rechazado." id="id-5a46cbdb519a5aaa94fca4c715520e6c">
        <documentation>Definición de «Deuda».</documentation>
        <property key="Término" value="Deuda"/>
        <property key="Contexto" value="BC-PAB"/>
        <property key="Ejemplo" value="Fondos insuficientes al cierre."/>
        <property key="Nombre técnico" value="Valor de viajes ya prestados cuyo cobro fue rechazado."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Cuando el dueño de la tarjeta le pide a su banco devolver un cobro, semanas después." id="id-24d7af8751d25a2c9a1e9e3fb458a048">
        <documentation>Definición de «Contracargo».</documentation>
        <property key="Término" value="Contracargo"/>
        <property key="Contexto" value="BC-PAB"/>
        <property key="Ejemplo" value="El titular desconoce el cargo."/>
        <property key="Nombre técnico" value="Reversión de un cobro que pide el titular a su banco, semanas después."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Jornada de operación con su hora de cierre; no es igual al día del calendario." id="id-7e1f00b118b054ef87d164d033e774dc">
        <documentation>Definición de «Día de servicio».</documentation>
        <property key="Término" value="Día de servicio"/>
        <property key="Contexto" value="BC-TRX, BC-CON, BC-RED"/>
        <property key="Ejemplo" value="Un viaje a las 00:30 puede pertenecer al día anterior."/>
        <property key="Nombre técnico" value="Jornada de operación con su hora de corte; no coincide con el día calendario."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Transacción que llega después del cierre de su día de servicio." id="id-6661e44b7c495b368e0fadddec65222a">
        <documentation>Definición de «Transacción tardía».</documentation>
        <property key="Término" value="Transacción tardía"/>
        <property key="Contexto" value="BC-TRX, BC-CON"/>
        <property key="Ejemplo" value="Bus que transmite al llegar a patio."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Transacción con un código que ya había llegado; se descarta." id="id-35c7cd35211554daa5d552e37be0c2cb">
        <documentation>Definición de «Transacción duplicada».</documentation>
        <property key="Término" value="Transacción duplicada"/>
        <property key="Contexto" value="BC-TRX"/>
        <property key="Ejemplo" value="Reintento del equipo."/>
        <property key="Nombre técnico" value="Transacción con un identificador ya recibido; se descarta."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Lo recaudado en un día de servicio, sumado por modo, ruta y operador." id="id-ac8491660c9f51d4a8bc1b0ecd15fbc1">
        <documentation>Definición de «Consolidado».</documentation>
        <property key="Término" value="Consolidado"/>
        <property key="Contexto" value="BC-CON"/>
        <property key="Ejemplo" value="El cierre del martes."/>
        <property key="Nombre técnico" value="Recaudo de un día de servicio por modo, ruta y operador."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Consumo consolidado de días cerrados por modo, ruta y operador que la aplicación entrega para cuadrar y liquidar; todavía no está conciliado." id="id-2fb669acbac15423a460710dece2fa13">
        <documentation>Definición de «Base de distribución».</documentation>
        <property key="Término" value="Base de distribución"/>
        <property key="Contexto" value="BC-CON"/>
        <property key="Ejemplo" value="La que recibe el analista de liquidación."/>
        <property key="Nombre técnico" value="Consumo consolidado de días cerrados por modo, ruta y operador que la aplicación entrega para conciliar y liquidar; todavía no está conciliado."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Corrección autorizada de un saldo o de una transacción, que deja rastro." id="id-45a233f9908f556ba8ae00ffd0e4d71b">
        <documentation>Definición de «Ajuste».</documentation>
        <property key="Término" value="Ajuste"/>
        <property key="Contexto" value="BC-AJU"/>
        <property key="Ejemplo" value="Abono por cobro doble."/>
        <property key="Nombre técnico" value="Corrección autorizada de un saldo o de una transacción que deja huella."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Recorrido de un modo, con el operador que tiene asignado en cada periodo." id="id-12f3edbf9f28512ca911fff17a87b384">
        <documentation>Definición de «Ruta».</documentation>
        <property key="Término" value="Ruta"/>
        <property key="Contexto" value="BC-RED, BC-CON"/>
        <property key="Ejemplo" value="Ruta alimentadora A12."/>
        <property key="Nombre técnico" value="Recorrido de un modo con un operador asignado por periodo."/>
      </element>
      <element xsi:type="archimate:Meaning" name="[Contexto Consolidación] Empresa de transporte a la que se le asignan los pasajeros de una ruta." id="id-908d449abd7056d0959c9c3de5242811">
