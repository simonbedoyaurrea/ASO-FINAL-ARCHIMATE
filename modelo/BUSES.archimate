    <folder name="Fase 5 · Contextos e interoperabilidad" id="id-213367f61a965ceb8ad1066f66b5f875">
      <element xsi:type="archimate:ApplicationComponent" name="Contexto Tarifas y transbordos" id="id-fbdd857cfde15f2881d313951803bfef">
        <documentation>Guarda las versiones de tarifas y reglas, las envía a los equipos y calcula la tarifa correcta de cada viaje.</documentation>
        <property key="Dominio" value="DOM-TAR"/>
        <property key="Nombre técnico" value="Contexto Tarificación e integración"/>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="API Tarifas y transbordos" id="id-42c3df845d1f51ac88e8aca15e769f4d">
        <documentation>Interfaz pública de Contexto Tarificación e integración.</documentation>
        <property key="Nombre técnico" value="API Tarificación e integración"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Contexto resumen del recaudo" id="id-61ba9719635454f3801c54958cfc03f1">
        <documentation>Asigna cada viaje a su modo, ruta, operador y día, suma todo y entrega la base para repartir la plata.</documentation>
        <property key="Dominio" value="DOM-CON"/>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="API Consolidación del recaudo" id="id-abed1efd6d02533698f63ba6da50c220">
        <documentation>Interfaz pública de Contexto Consolidación del recaudo.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Contexto Tarjetas VAMOS y saldos" id="id-4564e1008063577ba3227a09b07e4f58">
        <documentation>Todo lo de la tarjeta VAMOS: venta, recargas, saldo y lista de tarjetas bloqueadas.</documentation>
        <property key="Dominio" value="DOM-MED"/>
        <property key="Nombre técnico" value="Contexto Medios VAMOS y saldos"/>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="API Tarjetas VAMOS y saldos" id="id-98f9d1f112435c9faa2a9bec1fd4db95">
        <documentation>Interfaz pública de Contexto Medios VAMOS y saldos.</documentation>
        <property key="Nombre técnico" value="API Medios VAMOS y saldos"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Contexto Perfiles y descuentos" id="id-3103aa5df4c55dd6a2d73e4b826bd5f4">
        <documentation>Pedir, revisar, activar, vencer y quitar los perfiles con descuento.</documentation>
        <property key="Dominio" value="DOM-TAR"/>
        <property key="Nombre técnico" value="Contexto Perfiles y beneficios"/>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="API Perfiles y descuentos" id="id-1d50acfefc315e66ab6a1c7a24979f72">
        <documentation>Interfaz pública de Contexto Perfiles y beneficios.</documentation>
        <property key="Nombre técnico" value="API Perfiles y beneficios"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Contexto Pago con tarjeta del banco" id="id-0953ed94b1125f26bf204b6e91f036ae">
        <documentation>Los viajes de cada tarjeta del banco, el cobro agrupado, si el cobro pasó o no, y las deudas.</documentation>
        <property key="Dominio" value="DOM-MED"/>
        <property key="Nombre técnico" value="Contexto Pago abierto"/>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="API Pago con tarjeta del banco" id="id-14151d1cfe1d5912bce9e30f5b0dc9bf">
        <documentation>Interfaz pública de Contexto Pago abierto.</documentation>
        <property key="Nombre técnico" value="API Pago abierto"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Contexto Recepción de transacciones" id="id-88c37b33bc0d5ff49b14677382db09c2">
        <documentation>Recibe los paquetes de transacciones de los equipos, descarta las repetidas, les pone su día de servicio y maneja las que llegan tarde.</documentation>
        <property key="Dominio" value="DOM-TRX"/>
        <property key="Nombre técnico" value="Contexto Captura de transacciones"/>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="API Recepción de transacciones" id="id-010b131671b25a0c9288f1b4cdc9af1e">
        <documentation>Interfaz pública de Contexto Captura de transacciones.</documentation>
        <property key="Nombre técnico" value="API Captura de transacciones"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Contexto Ajustes y reclamos" id="id-70f72d69919a582faa63ef9a50bcbcb3">
        <documentation>El historial para atender reclamos, y los ajustes, que siempre aprueba una segunda persona.</documentation>
        <property key="Dominio" value="DOM-CON"/>
        <property key="Nombre técnico" value="Contexto Ajustes y soporte a reclamos"/>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="API Ajustes y reclamos" id="id-b2865c8329f7554c9d4aa739106f52fa">
