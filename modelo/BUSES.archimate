        <documentation>Los empleados que usan la aplicación, sus permisos, y que nadie apruebe lo que él mismo propuso.</documentation>
        <property key="Dominio" value="DOM-GEN"/>
        <property key="Nombre técnico" value="Contexto Identidad y acceso"/>
      </element>
