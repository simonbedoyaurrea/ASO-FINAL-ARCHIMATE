      <element xsi:type="archimate:FlowRelationship" name="Entra: Kilómetros, flota, novedades, objeciones y cuentas de cobro" id="id-a8ee69999e195095b59d319cf515acc5" source="id-41ef738a1cd15671b0e33469d17dbc8a" target="id-22e7f6b9943a58269e999b74226a1462">
        <property key="Dirección" value="Entra (del externo hacia la aplicación)"/>
        <property key="Dirección del documento" value="Bidireccional"/>
        <property key="Origen" value="Documento servicios_recaudo.pdf"/>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="significa" id="id-c2b0825614995b45a391039e20df732e" source="id-e2785daa94b45549a4800cc842504cba" target="id-1c556889cd59563f8d3aa93f7ea40e53">
        <documentation>«Versión tarifaria» significa: Valores del pasaje vigentes durante un periodo.</documentation>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="significa" id="id-46c0338eda385623b7d3536ca62a062b" source="id-4c2525a6fcc15a08b6368d0db6f656dc" target="id-c4a9d50847345c29b113f142e0bf3906">
        <documentation>«Regla de integración» significa: Indica cuándo un viaje cuenta como transbordo y cuánto se cobra.</documentation>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="significa" id="id-0db75e8cbab15b92b86fb6a3e1f63e09" source="id-3a1da6624f2e5c22940be56550f8432b" target="id-5bc7e6507cd956ccac245ce6a307aa2c">
        <documentation>«Viaje» significa: Recorrido que realiza una persona usando el sistema de transporte.</documentation>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="significa" id="id-572ac8acd5de5e9cb7efbba1f449600d" source="id-54de7bf3cc795b2a8445d03e5d9cad1c" target="id-b05a3bb0379c5d2b818949f911eda1bf">
        <documentation>«Perfil especial» significa: Condición que permite acceder a una tarifa diferente, como estudiante o adulto mayor.</documentation>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="significa" id="id-005967d4461e53c1b6871bd9e54891bc" source="id-c7127a688f3452a9866c75e3c222c820" target="id-0596fa8ec59257d088c29d0fed8cfc23">
        <documentation>«Certificado del perfil» significa: Comprobante de que la persona cumple las condiciones para recibir ese beneficio.</documentation>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="significa" id="id-6fa3b0a12bd256aa82eee449d7e8d0ed" source="id-802a9dba401551a5b18ba330f851592d" target="id-073ab31c8f54579eaac949fd85640942">
        <documentation>«Base de distribución» significa: Información utilizada para repartir el recaudo entre los operadores correspondientes.</documentation>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="significa" id="id-c07811cc5bb851af8e38c3ad1d476f11" source="id-1c0f8c1c18365ec8b9a4df29fa21817f" target="id-212251416654596bb395d55e49f2d736">
        <documentation>«Ajuste de saldo» significa: Corrección autorizada del saldo de un medio de pago.</documentation>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="significa" id="id-e69100634e65514980a6d72d003fa0e9" source="id-5f17e2774b915e25a45e99baf769015f" target="id-89227447a88a5038a74dbb5578afe8b5">
        <documentation>«Reclamo» significa: Solicitud de revisión cuando una persona considera que hubo un cobro o registro incorrecto.</documentation>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="significa" id="id-2a91bb3b194b5925b7689357c28a0a40" source="id-546c01ebdb875459945fc530ec8abde8" target="id-a405f7c9fa1b5fbb853762c711881370">
        <documentation>«Lista de tarjetas bloqueadas» significa: Registro de tarjetas que no pueden utilizarse.</documentation>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="significa" id="id-43866e18830d5b8db51528ab792ad49b" source="id-c344314dad335013991d75cbc60a24ff" target="id-f7c53d0d17fa5260af029e8632cafd81">
        <documentation>«Deuda de tarjeta del banco» significa: Valor pendiente cuando un cobro hecho con tarjeta bancaria no se ha completado.</documentation>
      </element>
    </folder>
