      </element>
      <element xsi:type="archimate:Grouping" name="Decisión: Implementar" id="id-74030a46f0ea5f0f8b408822387f7f07">
        <documentation>Es una regla de negocio del recaudo que ningún tercero entrega, controla dinero público o es requisito de trazabilidad, y hoy no existe en la empresa.</documentation>
        <property key="Criterio" value="Es una regla de negocio del recaudo que ningún tercero entrega, controla dinero público o es requisito de trazabilidad, y hoy no existe en la empresa."/>
        <property key="Origen" value="Documento servicios_recaudo.pdf"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Decisión: Reutilizar" id="id-8b749811b6ca576e8627e4469dcc676e">
        <documentation>La empresa ya cuenta con el servicio (SSO, PQRS, tesorería, ERP, gestor documental, monitoreo); se integra por la capa anticorrupción y no se reconstruye.</documentation>
        <property key="Criterio" value="La empresa ya cuenta con el servicio (SSO, PQRS, tesorería, ERP, gestor documental, monitoreo); se integra por la capa anticorrupción y no se reconstruye."/>
        <property key="Origen" value="Documento servicios_recaudo.pdf"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Decisión: Tercero" id="id-b6135888cc5f5b748057719183478cbd">
        <documentation>El servicio lo ejecuta el concesionario, el fabricante o una entidad externa por razones técnicas (tiempo real, equipos propietarios) o contractuales; la aplicación define reglas y audita.</documentation>
        <property key="Criterio" value="El servicio lo ejecuta el concesionario, el fabricante o una entidad externa por razones técnicas (tiempo real, equipos propietarios) o contractuales; la aplicación define reglas y audita."/>
        <property key="Origen" value="Documento servicios_recaudo.pdf"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Decisión: Diferir" id="id-16f97f8d76945642a7cefc9722dd0c66">
        <documentation>Aporta valor pero depende de otras piezas o tiene poco riesgo hoy; se programa para una segunda fase.</documentation>
        <property key="Criterio" value="Aporta valor pero depende de otras piezas o tiene poco riesgo hoy; se programa para una segunda fase."/>
        <property key="Origen" value="Documento servicios_recaudo.pdf"/>
      </element>
    </folder>
