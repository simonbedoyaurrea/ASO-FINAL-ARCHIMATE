        <property key="Nombre técnico" value="[Contexto MED] Último saldo conocido por la aplicación."/>
      </element>
      <element xsi:type="archimate:Meaning" name="[Tarjeta (equipo)] Saldo guardado en el chip, que es el que de verdad se descuenta." id="id-6dcd6f45f79958cbb43fae69b3a0140a">
        <documentation>Significado de «Saldo» en Tarjeta (equipo).</documentation>
        <property key="Término" value="Saldo"/>
