        <property key="Fuente" value="Entrevista B3.4 (l. 229-238)"/>
        <property key="Nombre técnico" value="[Experto] Cuatro momentos: dinero capturado, recaudado (en la fiducia), ingreso por el viaje y distribuible."/>
      </element>
      <element xsi:type="archimate:Meaning" name="[Contexto Consolidación] Valor de las validaciones y cobros consolidados del día de servicio." id="id-c914d8ee991a5d099d844a639a772ea3">
