        <property key="Fuente" value="Entrevista B2.4 (l. 144-149); Entrevista B5.1 (l. 366-371); D-05"/>
        <property key="Nombre técnico" value="[Autoridad y ente gestor] Tarifa técnica (costo por pasajero) frente a tarifa al usuario (la que se cobra)."/>
      </element>
      <element xsi:type="archimate:Meaning" name="[Experto] Cuatro momentos: plata capturada, recaudada (en la fiducia), ganada por el viaje y lista para repartir." id="id-91ecc9f2cf1252acb7e60b3c0f96b419">
        <documentation>Significado de «Recaudado» en Experto.</documentation>
