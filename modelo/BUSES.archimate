        <property key="Fuente" value="Entrevista B2.1 (l. 119-128); Entrevista B10.P (l. 878-885); Entrevista B10.1 (l. 886-895)"/>
        <property key="Nombre técnico" value="[Contexto CON] Operador de transporte al que se atribuye la demanda de una ruta."/>
      </element>
      <element xsi:type="archimate:Meaning" name="[Concesionario (externo)] El experto a veces le dice «operador» al concesionario de recaudo y tecnología." id="id-2840c5526bfd52f6b5070eb2ddcc0308">
