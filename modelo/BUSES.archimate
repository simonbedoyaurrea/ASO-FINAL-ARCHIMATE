      </element>
      <element xsi:type="archimate:Capability" name="Perfiles con descuento y revisión de requisitos" id="id-7c4b445fd82f5d98ba081ad62b3e93d3">
        <documentation>Verifica con la certificadora, activa, vence y revoca perfiles con evidencia.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="Alto: dentro de la aplicación"/>
        <property key="Fuente" value="T4; Entrevista B5.2 (l. 372-380); Entrevista B5.3 (l. 381-387)"/>
        <property key="Nombre técnico" value="Gestión de perfiles y verificación de condiciones"/>
      </element>
      <element xsi:type="archimate:Capability" name="Transbordo entre modos (integración tarifaria)" id="id-361dde67a3895982b36f308cdd96c972">
        <documentation>Define y aplica la ventana y las reglas de transbordo.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="Alto: dentro de la aplicación"/>
        <property key="Fuente" value="T4; Entrevista B5.4 (l. 388-394)"/>
        <property key="Nombre técnico" value="Integración tarifaria entre modos"/>
      </element>
      <element xsi:type="archimate:Capability" name="Cálculo de la tarifa de cada validación" id="id-1eafc28376bf549b8d40ac58b691b791">
        <documentation>Determina la tarifa correcta de cada validación recibida y señala diferencias.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="Alto: dentro de la aplicación"/>
        <property key="Fuente" value="T4; Entrevista B3.1 (l. 198-210); Entrevista B6.3 (l. 465-474)"/>
        <property key="Nombre técnico" value="Tarificación de validaciones"/>
      </element>
      <element xsi:type="archimate:Capability" name="Venta y puntos de recarga" id="id-078b6f3ca187595799e8bf8e8544754c">
        <documentation>Capacidad de nivel 1 (misional).</documentation>
        <property key="Nivel" value="1"/>
        <property key="Tipo" value="Misional"/>
        <property key="Nombre técnico" value="Venta y canales de recarga"/>
      </element>
      <element xsi:type="archimate:Capability" name="Puntos de recarga físicos" id="id-bb62d2bd8fdf52c788dfebb3ea3a1252">
        <documentation>Los aliados venden y recargan; la aplicación registra cada operación.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="Medio: intercambia información con la aplicación"/>
        <property key="Fuente" value="Entrevista B3.2 (l. 211-216); Entrevista B9.3 (l. 752-762)"/>
        <property key="Nombre técnico" value="Red de recarga presencial"/>
      </element>
      <element xsi:type="archimate:Capability" name="Recarga por internet" id="id-e89bcb57e94b5d8a832689bb018a313a">
        <documentation>La pasarela confirma el pago; la aplicación deja la recarga pendiente de acreditación.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="Medio: intercambia información con la aplicación"/>
        <property key="Fuente" value="Entrevista B3.2 (l. 211-216); Entrevista B5.6 (l. 400-406)"/>
        <property key="Nombre técnico" value="Canal virtual de recarga"/>
      </element>
      <element xsi:type="archimate:Capability" name="Manejo de efectivo" id="id-969f745849b85a23a65eb1484cb24319">
        <documentation>Custodia y recolección del efectivo de puntos y taquillas.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="Sin impacto"/>
        <property key="Fuente" value="Entrevista B4.1 (l. 286-299); Entrevista B2.6 (l. 154-166)"/>
        <property key="Nombre técnico" value="Gestión de efectivo y valores"/>
      </element>
      <element xsi:type="archimate:Capability" name="Pago de comisiones a aliados" id="id-43262e7c6be05c5f85fbf74aa3d4b26d">
        <documentation>Cálculo y pago de comisiones de puntos y adquirencia.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="Sin impacto"/>
        <property key="Fuente" value="Entrevista B3.2 (l. 211-216); Entrevista B3.6 (l. 252-267)"/>
        <property key="Nombre técnico" value="Gestión de comisiones a aliados"/>
      </element>
      <element xsi:type="archimate:Capability" name="Validación y entrada" id="id-4be5f0b0e11355a9bde104fee41ca5ec">
        <documentation>Capacidad de nivel 1 (misional).</documentation>
        <property key="Nivel" value="1"/>
        <property key="Tipo" value="Misional"/>
        <property key="Nombre técnico" value="Validación y acceso"/>
      </element>
      <element xsi:type="archimate:Capability" name="Validar en buses y estaciones" id="id-a935408369745dd0a4492805bf0e3cf1">
        <documentation>Los equipos aplican los parámetros publicados y generan transacciones que la aplicación recibe.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="Medio: intercambia información con la aplicación"/>
        <property key="Fuente" value="Entrevista B3.1 (l. 198-210); Entrevista B9.11 (l. 817-829); T4"/>
        <property key="Nombre técnico" value="Validación a bordo y en estaciones"/>
      </element>
      <element xsi:type="archimate:Capability" name="Equipos y conexión" id="id-e9b62c83a49853f8afb6ec28732d9c5a">
        <documentation>Excluida por el Tema 4: la aplicación no gestiona dispositivos.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="Sin impacto"/>
        <property key="Fuente" value="T4"/>
        <property key="Nombre técnico" value="Gestión de equipos y conectividad"/>
      </element>
      <element xsi:type="archimate:Capability" name="Control de colados en estaciones" id="id-d70751b8efdf55cb8f4a097004fdbf7c">
        <documentation>Se mide en campo; el colado no deja transacción.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="Sin impacto"/>
        <property key="Fuente" value="Entrevista B6.6 (l. 497-502); Entrevista B7.2 (l. 560-571)"/>
        <property key="Nombre técnico" value="Control de evasión en estaciones"/>
      </element>
      <element xsi:type="archimate:Capability" name="Captura y envío de transacciones" id="id-8debc4d26a105451a33eb501a45993c5">
        <documentation>El proveedor de los equipos transmite lotes en línea o al llegar a patio.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="Medio: intercambia información con la aplicación"/>
        <property key="Fuente" value="Entrevista B3.1 (l. 198-210); Entrevista B6.4 (l. 475-482)"/>
        <property key="Nombre técnico" value="Captura y transmisión de transacciones"/>
      </element>
      <element xsi:type="archimate:Capability" name="Consolidación y reparto" id="id-7342f8760de65246aab1f1c21d06a540">
        <documentation>Capacidad de nivel 1 (misional).</documentation>
        <property key="Nivel" value="1"/>
        <property key="Tipo" value="Misional"/>
        <property key="Nombre técnico" value="Consolidación y distribución del recaudo"/>
      </element>
      <element xsi:type="archimate:Capability" name="Recibir y limpiar las transacciones" id="id-da3e7d3b25785b0c929c861a8b4efa4b">
        <documentation>Recibe los lotes, descarta duplicados y asigna el día de servicio.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="Alto: dentro de la aplicación"/>
        <property key="Fuente" value="T4; Entrevista B6.4 (l. 475-482)"/>
        <property key="Nombre técnico" value="Recepción y depuración de transacciones"/>
      </element>
      <element xsi:type="archimate:Capability" name="Consolidar por modo, ruta y operador" id="id-001fd1222e575923b42b47d0f3c2e956">
        <documentation>Atribuye cada transacción y consolida el recaudo por día de servicio.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="Alto: dentro de la aplicación"/>
        <property key="Fuente" value="T4; Entrevista B3.1 (l. 198-210); Entrevista B3.5 (l. 240-251)"/>
        <property key="Nombre técnico" value="Consolidación por modo, ruta y operador"/>
      </element>
      <element xsi:type="archimate:Capability" name="Cuadre del dinero (conciliación)" id="id-e29925f610345a42bb6cf61eb0eefbe7">
        <documentation>Analistas del ente gestor, fiduciaria y red de recarga concilian usando la base que entrega la aplicación.</documentation>
