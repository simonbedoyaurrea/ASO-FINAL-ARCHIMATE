        <documentation>«Rol» significa: Conjunto de permisos que determina qué puede hacer cada empleado.</documentation>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="significa" id="id-216c61a27a085a6c9d1a21f202e5a735" source="id-3dc8351e415e57d199213bd9394f6489" target="id-ac48476c717e5f39ba3d64fc5a5fc864">
        <documentation>«Notificación» significa: Aviso enviado para informar sobre un evento o una situación del sistema.</documentation>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="significa" id="id-8f764cf181de548cb949ed6e68062632" source="id-727c6c407a69514f81213967636f5f32" target="id-45daba52692f526f8feee3a626f58edb">
        <documentation>«Rastro de auditoría» significa: Registro de las acciones realizadas para poder revisarlas después.</documentation>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="significa" id="id-6a956f5afc2f501ba00af8cd7a9836dd" source="id-d4223c9f801e5ecda39c1906fdf466c8" target="id-e4936ff1b03e59bfbdf31dcd172ae790">
        <documentation>«Documento de soporte» significa: Archivo que respalda una operación, un ajuste o una atención.</documentation>
      </element>
