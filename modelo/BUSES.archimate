        <property key="Fuente" value="Entrevista B2.3 (l. 136-143); Entrevista B7.5 (l. 592-600); Entrevista B9.6 (l. 779-783)"/>
        <property key="Nombre técnico" value="[Planeación (externo)] Desplazamiento origen-destino estimado; el destino no se conoce porque solo se valida al entrar."/>
      </element>
