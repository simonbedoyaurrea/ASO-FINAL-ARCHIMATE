        <property key="Fuente" value="Entrevista B2.3 (l. 136-143); Entrevista B7.5 (l. 592-600); Entrevista B9.6 (l. 779-783)"/>
        <property key="Nombre técnico" value="[Contexto CON] La demanda se cuenta por abordajes: un viaje con transbordo cuenta dos o tres veces."/>
      </element>
      <element xsi:type="archimate:Meaning" name="[Planeación (externo)] Trayecto de origen a destino estimado; el destino no se sabe porque solo se valida al entrar." id="id-a7611cd981975c5a9617c079b64ea2a3">
        <documentation>Significado de «Viaje» en Planeación (externo).</documentation>
        <property key="Término" value="Viaje"/>
