      <element xsi:type="archimate:DataObject" name="Leyenda · Objeto de datos" id="id-e450aa4d3c9b5e71ac017e2941174e26">
        <property key="Uso" value="Leyenda de notación (no es parte del diseño)"/>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="Leyenda · Interfaz de aplicación" id="id-9a932d0ff9555771a08812c55cc64f89">
        <property key="Uso" value="Leyenda de notación (no es parte del diseño)"/>
      </element>
    </folder>
  </folder>
