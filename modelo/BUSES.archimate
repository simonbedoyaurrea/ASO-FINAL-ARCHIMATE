        <property key="Nombre técnico" value="[Tarjeta (equipo)] Saldo escrito en el chip, el que realmente se descuenta."/>
      </element>
      <element xsi:type="archimate:Meaning" name="[Contabilidad (externo)] Pasivo: plata ajena que no es ingreso hasta que se usa." id="id-725470599dfd50beae6a5727b3db9bf9">
        <documentation>Significado de «Saldo» en Contabilidad (externo).</documentation>
        <property key="Término" value="Saldo"/>
        <property key="Contexto" value="Contabilidad (externo)"/>
        <property key="Fuente" value="Entrevista B3.4 (l. 229-238); Entrevista B6.4 (l. 475-482); Entrevista B9.5 (l. 767-778)"/>
        <property key="Nombre técnico" value="[Contabilidad (externo)] Pasivo: dinero ajeno que no es ingreso hasta que se usa."/>
      </element>
      <element xsi:type="archimate:Meaning" name="[Contexto Tarifas] Tarifa correcta según la versión, el perfil y el transbordo." id="id-20c9e38e30d657a29262a94332670f07">
