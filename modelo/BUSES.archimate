        <property key="Nombre técnico" value="[Contexto CON] Valor de las validaciones y cobros consolidados del día de servicio."/>
      </element>
      <element xsi:type="archimate:Meaning" name="[Contexto Consolidación] Base consolidada: consumo de días cerrados por modo, ruta y operador; la entrega la aplicación." id="id-4ccbb58999ae58b5b36132e10ce45832">
        <documentation>Significado de «Base» en BC-CON.</documentation>
        <property key="Término" value="Base"/>
