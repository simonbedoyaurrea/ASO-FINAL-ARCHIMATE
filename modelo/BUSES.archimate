        <documentation>«Recarga» significa: Dinero agregado a una tarjeta VAMOS para poder usarla.</documentation>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="significa" id="id-0d3c00ed6c0c5ec992b867ce851c2e07" source="id-25c98d0c40a0501484219d901e41cecb" target="id-685ca7efef2b56eab508ec92c73e1bd3">
        <documentation>«Cobro agrupado» significa: Reunión de varios cobros para procesarlos como un solo valor.</documentation>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="significa" id="id-bccac1790741591394e5d96c9c22e3e0" source="id-bab09a3d73d1544aa4e3bdf423f0a40a" target="id-79c59047b4d75582878f12b75ff145b4">
        <documentation>«Lote de transacciones» significa: Grupo de registros de viajes enviado para su procesamiento.</documentation>
      </element>
      <element xsi:type="archimate:AssociationRelationship" name="significa" id="id-063e4f0601065bc0ab90b35ca9312849" source="id-321a94460db052eda290576a0abe6100" target="id-fa807294491658738366cd20b21c2608">
        <documentation>«Transacción de validación» significa: Registro que confirma el uso de una tarjeta o medio de pago al abordar.</documentation>
      </element>
    </folder>
