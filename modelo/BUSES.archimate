        <property key="Soporte de la aplicación" value="No: lo hacen los equipos (fuera del alcance); la aplicación solo publica parámetros"/>
      </element>
      <element xsi:type="archimate:ValueStream" name="4. Calcular la tarifa y cobrar" id="id-8166b5b0341357f0aabc914aa395f47d">
        <documentation>Resultado: Viaje cobrado con la tarifa correcta.</documentation>
        <property key="Resultado" value="Viaje cobrado con la tarifa correcta"/>
        <property key="Soporte de la aplicación" value="Sí"/>
        <property key="Nombre técnico" value="4. Tarificar y cobrar"/>
      </element>
      <element xsi:type="archimate:ValueStream" name="5. Consolidar el recaudo" id="id-963d9a5962c85977bdba652efc813e4c">
        <documentation>Resultado: Recaudo por modo, ruta, operador y día.</documentation>
        <property key="Resultado" value="Recaudo por modo, ruta, operador y día"/>
        <property key="Soporte de la aplicación" value="Sí"/>
      </element>
      <element xsi:type="archimate:ValueStream" name="6. Repartir la plata" id="id-4fe17e48c4bf5ddd9cd03c02071bd8c6">
        <documentation>Resultado: Operadores pagados según contrato.</documentation>
        <property key="Resultado" value="Operadores pagados según contrato"/>
        <property key="Soporte de la aplicación" value="No: entrega la base"/>
        <property key="Nombre técnico" value="6. Distribuir el dinero"/>
      </element>
      <element xsi:type="archimate:ValueStream" name="7. Rendir cuentas y atender" id="id-b4cf9ad9a6ba5e3da5b0e762b2e4442b">
        <documentation>Resultado: Registro contable, reportes y reclamos resueltos.</documentation>
        <property key="Resultado" value="Registro contable, reportes y reclamos resueltos"/>
        <property key="Soporte de la aplicación" value="Parcial: ajustes y datos para reportes"/>
      </element>
    </folder>
