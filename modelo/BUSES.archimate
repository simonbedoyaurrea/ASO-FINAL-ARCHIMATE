        <property key="Fuente" value="Entrevista B3.1 (l. 198-210); Entrevista B3.4 (l. 229-238); D-04"/>
        <property key="Nombre técnico" value="[Conciliación (externo)] Base conciliada: la consolidada ya comparada con el dinero recibido; es la que se liquida y se reparte."/>
      </element>
      <element xsi:type="archimate:Meaning" name="[Contexto Pago con tarjeta del banco] Cargo a la tarjeta del banco después de los viajes: al cierre del día o antes si se pasa el umbral." id="id-751a11c62c0e54b2bed609f27b17adfe">
        <documentation>Significado de «Cobro» en BC-PAB.</documentation>
        <property key="Término" value="Cobro"/>
        <property key="Contexto" value="BC-PAB"/>
        <property key="Fuente" value="Entrevista B3.3 (l. 217-228); Entrevista B2.5 (l. 150-153)"/>
        <property key="Nombre técnico" value="[Contexto PAB] Cargo agrupado a la tarjeta bancaria después de los viajes: al cierre del día o al superar el umbral."/>
      </element>
      <element xsi:type="archimate:Meaning" name="[Contexto Tarjetas] Descuento del saldo de la tarjeta VAMOS al pasarla." id="id-d8be73d745215c00810e9d4d1eb027bd">
        <documentation>Significado de «Cobro» en BC-MED.</documentation>
        <property key="Término" value="Cobro"/>
