        <documentation>Servicio de aplicación de Contexto Auditoría y evidencia.</documentation>
        <property key="Nombre técnico" value="Registro de auditoría"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Sistema de equipos del concesionario" id="id-cc8f72f42d7659d58025432e0ac0de4e">
        <documentation>Sistema externo (Dispositivos (vía proveedor)). No forma parte de la aplicación.</documentation>
        <property key="Tipo" value="Externo"/>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="Interfaz SA01" id="id-19a06e74bd3a551e83315acd3af3b525">
        <documentation>Interfaz de la capa anticorrupción para «Intercambio con los equipos del concesionario». Patrón: Capa anticorrupción. Formatos propietarios del fabricante (B9.11); se traducen a la transacción normalizada.</documentation>
        <property key="Patrón" value="Capa anticorrupción"/>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Traductor SA01: Conexión con los equipos del concesionario" id="id-8f34d121ae325780bb90bc020a713a5f">
        <documentation>Traduce entre el modelo de Contexto Captura de transacciones y «Sistema de equipos del concesionario». Formatos propietarios del fabricante (B9.11); se traducen a la transacción normalizada.</documentation>
        <property key="Patrón" value="Capa anticorrupción"/>
        <property key="Nombre técnico" value="ACL SA01: Intercambio con los equipos del concesionario"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Sistema de equipos del metro" id="id-4cc89b4ba4a755c08d37b8580f5e0bfe">
        <documentation>Sistema externo (Dispositivos (vía proveedor)). No forma parte de la aplicación.</documentation>
        <property key="Tipo" value="Externo"/>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="Interfaz SA15" id="id-3712a5b4065d585885010ad76e431d11">
        <documentation>Interfaz de la capa anticorrupción para «Intercambio con los equipos del metro». Patrón: Capa anticorrupción. El metro puede tener equipos y reglas distintas (B8.2); se traduce igual que SA01.</documentation>
        <property key="Patrón" value="Capa anticorrupción"/>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Traductor SA15: Conexión con los equipos del metro" id="id-e0761b35667b5d6ea41876515bf10d6f">
        <documentation>Traduce entre el modelo de Contexto Captura de transacciones y «Sistema de equipos del metro». El metro puede tener equipos y reglas distintas (B8.2); se traduce igual que SA01.</documentation>
        <property key="Patrón" value="Capa anticorrupción"/>
        <property key="Nombre técnico" value="ACL SA15: Intercambio con los equipos del metro"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Sistema de los puntos de recarga" id="id-60f045bc23d55f71aa5d0518ba4aa57c">
        <documentation>Sistema externo (Proveedor (aliados y comercios)). No forma parte de la aplicación.</documentation>
        <property key="Tipo" value="Externo"/>
        <property key="Nombre técnico" value="Sistema de la red de recarga"/>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="Interfaz SA02" id="id-15f9938f55725c6ab28d27dac9bb04cc">
        <documentation>Interfaz de la capa anticorrupción para «Intercambio con la red de recarga presencial». Patrón: Capa anticorrupción. Cada aliado reporta en su propio formato (B9.3).</documentation>
        <property key="Patrón" value="Capa anticorrupción"/>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Traductor SA02: Conexión con los puntos de recarga" id="id-783dbadc3ee6553cb0f4f8fe39855f8c">
        <documentation>Traduce entre el modelo de Contexto Medios VAMOS y saldos y «Sistema de la red de recarga». Cada aliado reporta en su propio formato (B9.3).</documentation>
        <property key="Patrón" value="Capa anticorrupción"/>
        <property key="Nombre técnico" value="ACL SA02: Intercambio con la red de recarga presencial"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Pasarela de pagos" id="id-16ae5c889ff75925a7ee839a5cca7b87">
        <documentation>Sistema externo (Entidad financiera). No forma parte de la aplicación.</documentation>
        <property key="Tipo" value="Externo"/>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="Interfaz SA03" id="id-5e076f71e89d53d5b09c63ac1d9bb10e">
        <documentation>Interfaz de la capa anticorrupción para «Pasarela de pagos para recarga virtual». Patrón: Conformista + capa anticorrupción. El protocolo de la pasarela no lo define el ente gestor (B8.5).</documentation>
        <property key="Patrón" value="Conformista + capa anticorrupción"/>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Traductor SA03: Pasarela de pagos para recargar por internet" id="id-e9b552287a785e538f69023e10abccb4">
        <documentation>Traduce entre el modelo de Contexto Medios VAMOS y saldos y «Pasarela de pagos». El protocolo de la pasarela no lo define el ente gestor (B8.5).</documentation>
        <property key="Patrón" value="Conformista + capa anticorrupción"/>
        <property key="Nombre técnico" value="ACL SA03: Pasarela de pagos para recarga virtual"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Plataforma del banco adquirente" id="id-2ab3a37dc65052d79ab360e89c4cc460">
        <documentation>Sistema externo (Entidad financiera). No forma parte de la aplicación.</documentation>
        <property key="Tipo" value="Externo"/>
        <property key="Nombre técnico" value="Plataforma del adquirente"/>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="Interfaz SA04" id="id-c141c56039af561f879b00e963ef4fca">
        <documentation>Interfaz de la capa anticorrupción para «Cobro con el adquirente (pago abierto)». Patrón: Conformista + capa anticorrupción. Reglas de franquicias y del adquirente (B9.8).</documentation>
        <property key="Patrón" value="Conformista + capa anticorrupción"/>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Traductor SA04: Cobro con el banco adquirente (tarjeta del banco)" id="id-61097057fece5692acadb50aae616f1b">
        <documentation>Traduce entre el modelo de Contexto Pago abierto y «Plataforma del adquirente». Reglas de franquicias y del adquirente (B9.8).</documentation>
        <property key="Patrón" value="Conformista + capa anticorrupción"/>
        <property key="Nombre técnico" value="ACL SA04: Cobro con el adquirente (pago abierto)"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Sistemas de las entidades que certifican" id="id-e25391e531cb5fa0a00fe115a73a8f5b">
