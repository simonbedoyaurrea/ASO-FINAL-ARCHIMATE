      <element xsi:type="archimate:DataObject" name="Viaje" id="id-a169d22492fc5922b88a530cb0a6b48e">
        <documentation>Entidad raíz del agregado: único punto de acceso y responsable de sus invariantes (9_DDD diap. 20).</documentation>
        <property key="Rol en el agregado" value="Raíz"/>
        <property key="Invariante 1" value="Un abordaje pertenece a un solo viaje."/>
        <property key="Invariante 2" value="Los abordajes de un viaje son del mismo medio y caen dentro de la ventana de la versión vigente en el primer abordaje."/>
        <property key="Invariante 3" value="Volver a subir en la misma ruta no genera transbordo [regla configurable]."/>
        <property key="Invariante 4" value="La tarifa del viaje es la de la regla de integración vigente, con el perfil vigente a la hora de cada abordaje."/>
        <property key="Invariante 5" value="La diferencia entre lo descontado por el equipo y la tarifa correcta queda registrada; nunca se oculta."/>
      </element>
