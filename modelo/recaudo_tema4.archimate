    <folder name="Fase 6 · Bounded Context Canvas" id="id-de22b2d1d895551b84b02e51bd5a8487">
      <element xsi:type="archimate:Meaning" name="Que cada pasada en los tres modos se cobre con la tarifa que le toca al usuario, según la versión vigente de la autoridad, su perfil y el transbordo, y que cualquier diferencia quede a la vista." id="id-953455b92718521098291d89098ad7ac">
        <documentation>Propósito del contexto Tarificación e integración.</documentation>
        <property key="Nombre técnico" value="Que cada validación de los tres modos quede cobrada con la tarifa que le corresponde al usuario, según la versión vigente de la autoridad, su perfil y la integración entre modos, y que cualquier diferencia quede a la vista."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Dominio: Central (core)" id="id-2f03e14c496059218088d4f18bc4457a">
        <documentation>Clasificación estratégica del canvas.</documentation>
      </element>
      <element xsi:type="archimate:Meaning" name="Modelo de negocio: ingreso y cumplimiento (revenue / compliance)" id="id-82dbc48024d2567d9711e613f9a735a1">
        <documentation>Clasificación estratégica del canvas.</documentation>
        <property key="Nombre técnico" value="Modelo de negocio: Ingreso y cumplimiento (revenue / compliance)"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Evolución: hecho a la medida (custom built)" id="id-67cf7c452d605db69e31da1fed4d13e4">
        <documentation>Clasificación estratégica del canvas.</documentation>
        <property key="Nombre técnico" value="Evolución: Hecho a la medida (custom built)"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Rol: aplica las reglas a cada transacción (contexto de ejecución)" id="id-bf8744a21b98537ba2a327e10b60e8d0">
        <documentation>Rol del dominio.</documentation>
        <property key="Nombre técnico" value="Rol del dominio: Contexto de ejecución (execution context): aplica reglas a cada transacción"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Rol secundario: guarda las versiones de tarifas y reglas (contexto de especificación)" id="id-519d5c0858885e4b887a9d0357268148">
        <documentation>Rol del dominio.</documentation>
        <property key="Nombre técnico" value="Rol secundario: Contexto de especificación: versiona tarifas y reglas"/>
      </element>
      <element xsi:type="archimate:Constraint" name="La tarifa del viaje es la que estaba vigente en la primera subida." id="id-cd3d46d960ee5431813ceb2951330e2a">
        <documentation>Decisión de negocio (regla) del contexto.</documentation>
        <property key="Nombre técnico" value="La tarifa del viaje es la de la versión vigente en el primer abordaje."/>
      </element>
      <element xsi:type="archimate:Constraint" name="Se aplica el perfil que estaba vigente en cada subida." id="id-42fbbb5fdd2d54c787056effb19c623a">
        <documentation>Decisión de negocio (regla) del contexto.</documentation>
        <property key="Nombre técnico" value="El perfil que se aplica es el vigente a la hora de cada abordaje."/>
      </element>
      <element xsi:type="archimate:Constraint" name="Volver a subir en la misma ruta no cuenta como transbordo (configurable)." id="id-906afe5183d755788192eff50b9c05c1">
        <documentation>Decisión de negocio (regla) del contexto.</documentation>
        <property key="Nombre técnico" value="Volver a subir en la misma ruta no genera transbordo (configurable)."/>
      </element>
      <element xsi:type="archimate:Constraint" name="La tarjeta del banco paga tarifa normal y sí tiene transbordo." id="id-6b7bba49450b5cabb71c2292b9440553">
        <documentation>Decisión de negocio (regla) del contexto.</documentation>
        <property key="Nombre técnico" value="La tarjeta bancaria paga tarifa plena y sí tiene integración."/>
      </element>
      <element xsi:type="archimate:Constraint" name="Si la tarifa cobrada y la correcta no coinciden, no se corrige sola: se propone un ajuste." id="id-1d93a5495df654b08d1255a6bd898464">
        <documentation>Decisión de negocio (regla) del contexto.</documentation>
        <property key="Nombre técnico" value="Una diferencia entre tarifa aplicada y correcta no se corrige sola: se propone un ajuste."/>
      </element>
      <element xsi:type="archimate:Assessment" name="S-11: el tiempo para hacer transbordo y cuántos se permiten aún no está confirmado (queda configurable)." id="id-8739f6c52cb1504b8325750fcd63dbb4">
        <documentation>Supuesto del contexto.</documentation>
        <property key="Nombre técnico" value="S-11: la ventana de transbordo y el número de transbordos son parámetros sin valor confirmado."/>
      </element>
      <element xsi:type="archimate:Assessment" name="S-05: el equipo descuenta en el momento con lo que se le publicó (funciona sin internet)." id="id-7ab6ce9a04e25b0ba5095c6962605ddb">
        <documentation>Supuesto del contexto.</documentation>
        <property key="Nombre técnico" value="S-05: el equipo descuenta en el momento con los parámetros publicados (opera sin conexión)."/>
      </element>
      <element xsi:type="archimate:Assessment" name="S-02: el metro tiene equipos propios y reglas de integración acordadas por convenio." id="id-5174c7fcc59c51bbaca2e543a6d9bea3">
        <documentation>Supuesto del contexto.</documentation>
        <property key="Nombre técnico" value="S-02: el metro tiene equipos propios y reglas de integración por convenio."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Diferencias entre la tarifa cobrada y la correcta por cada 100.000 validaciones." id="id-1f4fccd31fb953579de76a7ad1933b4d">
        <documentation>Métrica de verificación del diseño del contexto.</documentation>
        <property key="Nombre técnico" value="Diferencias entre tarifa aplicada y correcta por cada 100.000 validaciones."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Reclamos por transbordos no reconocidos (causa de fondo)." id="id-96d0821dad9c5492be0bb337f27d3a58">
        <documentation>Métrica de verificación del diseño del contexto.</documentation>
        <property key="Nombre técnico" value="Reclamos por transbordo no reconocido (causa raíz)."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Tiempo entre que llega una transacción y se le calcula la tarifa." id="id-d92495aa39e6552599226c9a2a2818c4">
        <documentation>Métrica de verificación del diseño del contexto.</documentation>
        <property key="Nombre técnico" value="Tiempo entre la recepción de una transacción y su tarificación."/>
      </element>
      <element xsi:type="archimate:Assessment" name="¿Cuánto tiempo hay para hacer transbordo y cuántos se permiten?" id="id-a91cd50e933c533ba401c28d2ed6dafd">
        <documentation>Pregunta abierta.</documentation>
        <property key="Nombre técnico" value="¿Cuál es la ventana de transbordo y cuántos transbordos se permiten?"/>
      </element>
      <element xsi:type="archimate:Assessment" name="¿Hay un tope diario o semanal de cobro para la tarjeta del banco?" id="id-98c3a121e7ca52bc8c2f7b88b9901e3f">
        <documentation>Pregunta abierta.</documentation>
        <property key="Nombre técnico" value="¿Hay topes diarios o semanales para la tarjeta bancaria?"/>
      </element>
      <element xsi:type="archimate:Assessment" name="¿Cómo se reparte con el metro lo que paga un viaje integrado?" id="id-aa22ccb9fd3856b38e25b925b1acde49">
        <documentation>Pregunta abierta.</documentation>
        <property key="Nombre técnico" value="¿Cómo se reparte el pago integrado con el metro?"/>
      </element>
    </folder>
    <element xsi:type="archimate:Outcome" name="Los visitantes viajan sin tener que comprar una tarjeta" id="id-be565eb3cc374eb3a5c5bc6343c1ddb1">
      <documentation>Resultado que se busca. Se mide con: Participación de las tarjetas bancarias en las validaciones [indicador propuesto por el diseño; el experto no lo nombró]. Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
      <property key="Indicador" value="Participación de las tarjetas bancarias en las validaciones [indicador propuesto por el diseño; el experto no lo nombró]"/>
      <property key="Fuente" value="T4; Entrevista B2.5 (l. 150-153)"/>
      <property key="Nombre técnico" value="Los visitantes viajan sin adquirir una tarjeta propia"/>
    </element>
    <element xsi:type="archimate:Outcome" name="Solo quien tiene el certificado vigente paga tarifa con descuento" id="id-ffcaccc80e2944c48ee0ef7a7a545590">
      <documentation>Resultado que se busca. Se mide con: Uso de tarifas especiales por perfil y casos sospechosos revisados (B7.1). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
      <property key="Indicador" value="Uso de tarifas especiales por perfil y casos sospechosos revisados (B7.1)"/>
      <property key="Fuente" value="Entrevista B6.5 (l. 483-496); Entrevista B7.1 (l. 533-559)"/>
      <property key="Nombre técnico" value="Solo los titulares con certificación vigente usan tarifas especiales"/>
    </element>
    <element xsi:type="archimate:Outcome" name="Cada pasada por el validador queda cobrada con la tarifa y el transbordo vigentes" id="id-6b868e1e05de4596b0f706c42aff1189">
      <documentation>Resultado que se busca. Se mide con: Reclamos por cobro doble o transbordo no reconocido, por causa raíz (B7.1). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
      <property key="Indicador" value="Reclamos por cobro doble o transbordo no reconocido, por causa raíz (B7.1)"/>
      <property key="Fuente" value="Entrevista B6.3 (l. 465-474); Entrevista B7.1 (l. 533-559)"/>
      <property key="Nombre técnico" value="Cada validación queda cobrada con la tarifa y la integración vigentes"/>
    </element>
    <element xsi:type="archimate:Outcome" name="Llegan completas, a tiempo y sin repetir las transacciones de los tres modos" id="id-40f897ea1de4454b912df740284aceb3">
      <documentation>Resultado que se busca. Se mide con: Equipos que reportaron en el plazo ÷ equipos en servicio (B7.2). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
      <property key="Indicador" value="Equipos que reportaron en el plazo ÷ equipos en servicio (B7.2)"/>
      <property key="Fuente" value="Entrevista B6.4 (l. 475-482); Entrevista B7.2 (l. 560-571)"/>
      <property key="Nombre técnico" value="Las transacciones de los tres modos se reciben completas, a tiempo y sin duplicados"/>
    </element>
    <element xsi:type="archimate:Outcome" name="La base consolidada por modo, ruta y operador se entrega cerrada y a tiempo, y cada diferencia que devuelve la conciliación se resuelve con un ajuste" id="id-06cb13703121400ba8e5a67a07fea103">
      <documentation>Resultado que se busca. Se mide con: Días cerrados entregados a tiempo; valor y antigüedad de las diferencias que devuelve la conciliación; ajustes manuales (B7.1, B7.5). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
      <property key="Indicador" value="Días cerrados entregados a tiempo; valor y antigüedad de las diferencias que devuelve la conciliación; ajustes manuales (B7.1, B7.5)"/>
      <property key="Fuente" value="T4; Entrevista B7.1 (l. 533-559); Entrevista B7.5 (l. 592-600)"/>
    </element>
    <element xsi:type="archimate:Outcome" name="Los reclamos de saldo y cobro se resuelven dentro del plazo" id="id-c9fba29506e044af9cdb4ff3eb9b8c15">
      <documentation>Resultado que se busca. Se mide con: Reclamos respondidos en plazo ÷ radicados; reclamos por 100.000 validaciones (B7.2). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
      <property key="Indicador" value="Reclamos respondidos en plazo ÷ radicados; reclamos por 100.000 validaciones (B7.2)"/>
      <property key="Fuente" value="Entrevista B6.7 (l. 503-515); Entrevista B7.2 (l. 560-571)"/>
    </element>
