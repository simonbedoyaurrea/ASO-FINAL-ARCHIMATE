        <property key="Nombre técnico" value="Intercambio con planeación de rutas y operación" />
      </element>
      <element xsi:type="archimate:BusinessService" name="Conexión con la autoridad de transporte" id="id-6603ca0d6ff25777b7fadb6cfbe289c8">
        <documentation>Interoperabilidad con «Autoridad de transporte» (Entidad regulatoria).</documentation>
        <property key="Capa" value="4. Anticorrupción" />
        <property key="Decisión" value="Incluido" />
        <property key="Tipo de parte externa" value="Entidad regulatoria" />
        <property key="Fuente" value="T4; Entrevista B5.1 (l. 366-371); Entrevista B9.10 (l. 808-816)" />
        <property key="Nombre técnico" value="Intercambio con la autoridad de transporte" />
      </element>
      <element xsi:type="archimate:BusinessService" name="Informe de demanda para los operadores" id="id-606708a9fe7350d4832e2cd6ba017f03">
        <documentation>Interoperabilidad con «Operadores de transporte» (Entidad externa (contratistas)).</documentation>
        <property key="Capa" value="4. Anticorrupción" />
        <property key="Decisión" value="Incluido" />
        <property key="Tipo de parte externa" value="Entidad externa (contratistas)" />
        <property key="Fuente" value="T4; Entrevista B9.4 (l. 763-766)" />
        <property key="Nombre técnico" value="Reporte de demanda a los operadores de transporte" />
      </element>
      <element xsi:type="archimate:BusinessService" name="Avisos al usuario" id="id-9cd3366af3a75755b13a53751ad19727">
        <documentation>Interoperabilidad con «Proveedor de notificaciones» (Proveedor).</documentation>
        <property key="Capa" value="4. Anticorrupción" />
        <property key="Decisión" value="Incluido" />
        <property key="Tipo de parte externa" value="Proveedor" />
        <property key="Fuente" value="Entrevista B9.12 (l. 830-840); Entrevista B9.13 (l. 841-852)" />
        <property key="Nombre técnico" value="Notificaciones al usuario" />
      </element>
      <element xsi:type="archimate:BusinessService" name="Conexión con control de fraude" id="id-31c7cb54615e54818155a14f59ae1d91">
        <documentation>Interoperabilidad con «Área de control de fraude» (Proceso interno).</documentation>
        <property key="Capa" value="4. Anticorrupción" />
        <property key="Decisión" value="Incluido" />
        <property key="Tipo de parte externa" value="Proceso interno" />
        <property key="Fuente" value="Entrevista B4.2 (l. 300-310); Entrevista B4.3 (l. 311-318); Entrevista B6.5 (l. 483-496)" />
        <property key="Nombre técnico" value="Intercambio con control de fraude" />
      </element>
      <element xsi:type="archimate:BusinessService" name="Paso de datos desde el sistema viejo" id="id-8d49f287433658049f33393564360c47">
        <documentation>Interoperabilidad con «Concesionario de recaudo y tecnología» (Sistema legado).</documentation>
        <property key="Capa" value="4. Anticorrupción" />
        <property key="Decisión" value="Incluido" />
        <property key="Tipo de parte externa" value="Sistema legado" />
        <property key="Fuente" value="Entrevista B8.2 (l. 632-641); Entrevista B8.5 (l. 670-679); D-01" />
        <property key="Nombre técnico" value="Migración desde la plataforma heredada" />
