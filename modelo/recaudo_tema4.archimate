        <property key="Fuente" value="Entrevista B3.2 (l. 211-216)"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Banco adquirente y bancos de las tarjetas" id="id-75b6246bba535ed6959b06e73eda16ac">
        <documentation>Procesan los cobros con tarjeta bancaria, abonan, rechazan y tramitan contracargos.</documentation>
