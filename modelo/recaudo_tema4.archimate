      <element xsi:type="archimate:DataObject" name="Perfil especial" id="id-bdc8511f2d8456d99bc112a0c5f24aff">
        <documentation>Entidad raíz del agregado: único punto de acceso y responsable de sus invariantes (9_DDD diap. 20).</documentation>
        <property key="Rol en el agregado" value="Raíz"/>
        <property key="Invariante 1" value="Solo una tarjeta personalizada puede tener perfil especial."/>
        <property key="Invariante 2" value="El tipo es uno de los cuatro del Tema 4 y cada tipo exige su certificación: matrícula del colegio o de la universidad, identidad y edad para adulto mayor, certificado de la entidad competente para movilidad reducida."/>
        <property key="Invariante 3" value="Un perfil activo exige una certificación vigente con su evidencia."/>
        <property key="Invariante 4" value="Una tarjeta tiene a lo sumo un perfil especial activo [supuesto, configurable]."/>
        <property key="Invariante 5" value="Al vencer, el perfil deja de aplicarse: no se bloquea la tarjeta ni se toca su saldo."/>
        <property key="Invariante 6" value="Suspender o revocar requiere la decisión de un nivel autorizado y la notificación al titular."/>
      </element>
