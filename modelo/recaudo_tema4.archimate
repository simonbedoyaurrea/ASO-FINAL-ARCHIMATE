    <element xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="archimate:ArchimateDiagramModel" id="id-b36dd21c89e75863978287e39f35a039" name="V11 · Canvas de Tarifas y transbordos" viewpoint="layered">
  <documentation>Versión compacta derivada de V11-boceto-04.scene.json. Conceptos editables y relaciones formales; no es una imagen incrustada.</documentation>
  <child id="id-6b4bfa17a91958bcac23d4a91bc1b611" archimateElement="id-fbdd857cfde15f2881d313951803bfef" fillColor="#f7dfaa" font="1|Arial|10.5|0|COCOA|1|ArialMT" textAlignment="1" textPosition="0" xsi:type="archimate:DiagramObject">
    <feature name="labelExpression" value="Propósito · clasificación · rol&#10;&#10;Calcular tarifa e integración por validación. Contexto central: versiona reglas y calcula importes. Perfiles, saldos y cobros pertenecen a otros contextos." />
    <bounds x="48" y="120" width="1704" height="90" />
  </child>
  <child id="id-26607c73f6c15ccfbcc0d6dcccd9ef3a" archimateElement="id-34335e188c415466a32b475f1a93141d" fillColor="#edf0f2" font="1|Arial|9.8|0|COCOA|1|ArialMT" textAlignment="1" textPosition="0" xsi:type="archimate:DiagramObject">
    <feature name="labelExpression" value="Ente gestor&#10;&#10;C · Registrar acto y vigencia. La autoridad define; el gestor&#10;registra." />
    <bounds x="48" y="270" width="520" height="98" />
    <sourceConnection id="id-ed93e50c14d957e6bfd900548699332a" source="id-26607c73f6c15ccfbcc0d6dcccd9ef3a" target="id-606aecdaf5905e8684e983f5ac971ed0" archimateRelationship="id-88df694091055b5695c1679ac19aeaea" font="1|Arial|9.0|0|COCOA|1|ArialMT" lineColor="#202020" xsi:type="archimate:Connection">
      <feature name="labelExpression" value=" " />
    </sourceConnection>
  </child>
  <child id="id-606aecdaf5905e8684e983f5ac971ed0" archimateElement="id-eac5d863b82152ba90ac6a18857a450d" fillColor="#f7dfaa" font="1|Arial|9.8|0|COCOA|1|ArialMT" textAlignment="1" textPosition="0" xsi:type="archimate:DiagramObject" targetConnections="id-ed93e50c14d957e6bfd900548699332a">
    <feature name="labelExpression" value="Versionar reglas&#10;&#10;Conservar tarifas y reglas de integración versionadas." />
    <bounds x="632" y="270" width="520" height="98" />
    <sourceConnection id="id-62830112b36957c6a876bad9489fd69a" source="id-606aecdaf5905e8684e983f5ac971ed0" target="id-6dc00576955553858a5fc4efe5303d9b" archimateRelationship="id-7d37576c84c554d29d638d962b72f97a" font="1|Arial|9.0|0|COCOA|1|ArialMT" lineColor="#202020" xsi:type="archimate:Connection">
      <feature name="labelExpression" value=" " />
    </sourceConnection>
  </child>
  <child id="id-6dc00576955553858a5fc4efe5303d9b" archimateElement="id-9b5659ce24d05db59fbc3532c78db0ae" fillColor="#dceef3" font="1|Arial|9.8|0|COCOA|1|ArialMT" textAlignment="1" textPosition="0" xsi:type="archimate:DiagramObject" targetConnections="id-62830112b36957c6a876bad9489fd69a">
    <feature name="labelExpression" value="Equipos externos&#10;&#10;E · Versión vigente a equipos mediante ACL; no administrar&#10;hardware." />
    <bounds x="1216" y="270" width="536" height="98" />
  </child>
  <child id="id-dd8b7ba078485edca7cab2fb861eb247" archimateElement="id-28c83a46cf1c5e58877212b085c9c9eb" fillColor="#edf0f2" font="1|Arial|9.8|0|COCOA|1|ArialMT" textAlignment="1" textPosition="0" xsi:type="archimate:DiagramObject">
    <feature name="labelExpression" value="Recepción&#10;&#10;E · Validación: ID, instante, modo, medio y viaje. C/P." />
    <bounds x="48" y="380" width="520" height="98" />
    <sourceConnection id="id-d93dbd7c08515fc3b549f4d27d4e75f7" source="id-dd8b7ba078485edca7cab2fb861eb247" target="id-23ebae6b27ed537c9dfc12fda41af57e" archimateRelationship="id-f3bec0a6da605f9eb8c0a95ab48dc626" font="1|Arial|9.0|0|COCOA|1|ArialMT" lineColor="#202020" xsi:type="archimate:Connection">
      <feature name="labelExpression" value=" " />
    </sourceConnection>
  </child>
  <child id="id-23ebae6b27ed537c9dfc12fda41af57e" archimateElement="id-0e2c5abd12435a599ca1611366d26515" fillColor="#f7dfaa" font="1|Arial|9.8|0|COCOA|1|ArialMT" textAlignment="1" textPosition="0" xsi:type="archimate:DiagramObject" targetConnections="id-d93dbd7c08515fc3b549f4d27d4e75f7">
    <feature name="labelExpression" value="Calcular tarifa&#10;&#10;C · Calcular importe con regla, perfil e integración&#10;vigentes." />
    <bounds x="632" y="380" width="520" height="98" />
    <sourceConnection id="id-e1f049d2d70153418c4511bd78fdc569" source="id-23ebae6b27ed537c9dfc12fda41af57e" target="id-6941bb6833da524cbc0203dbff0ccb33" archimateRelationship="id-7a5d27cfe4715fe9a660a9c707355f85" font="1|Arial|9.0|0|COCOA|1|ArialMT" lineColor="#202020" xsi:type="archimate:Connection">
      <feature name="labelExpression" value=" " />
    </sourceConnection>
  </child>
  <child id="id-6941bb6833da524cbc0203dbff0ccb33" archimateElement="id-76fe10d322d9542ba6f2a0334ec23480" fillColor="#dceef3" font="1|Arial|9.8|0|COCOA|1|ArialMT" textAlignment="1" textPosition="0" xsi:type="archimate:DiagramObject" targetConnections="id-e1f049d2d70153418c4511bd78fdc569">
    <feature name="labelExpression" value="VAMOS / Banco / Consolidación&#10;&#10;E · Tarifa a VAMOS/banco y Consolidación. No concilia. C/P." />
    <bounds x="1216" y="380" width="536" height="98" />
  </child>
  <child id="id-6da9588d68f55c3396f951f467bf2b0f" fillColor="#dceef3" font="1|Arial|9.0|0|COCOA|1|ArialMT" textAlignment="1" borderType="2" xsi:type="archimate:Note">
    <content>Consultas y contrato

Consulta tarifa/regla: responde al solicitante, sin cobrar. Consulta Perfiles (C/P) y Planeación (C/P + ACL). Entrada: validación y contexto. Salida: importe, regla, versión y estado. Recalcular no vuelve a cobrar.</content>
    <bounds x="48" y="505" width="1704" height="90" />
  </child>
  <child id="id-f9e9ec3074b25da1b24b1e2ac7baaa5a" fillColor="#fff0c7" font="1|Arial|9.8|0|COCOA|1|ArialMT" textAlignment="1" borderType="2" xsi:type="archimate:Note">
    <content>Lenguaje ubicuo

Validación: acceso registrado.
Transbordo: continuación integrada por una regla.
Perfil vigente: elegibilidad en el instante del viaje.
Tarifa: importe central, no tarifa técnica del operador.</content>
    <bounds x="48" y="620" width="552" height="170" />
  </child>
  <child id="id-bd9461b2ac6e5e88b3db634c80330834" fillColor="#f7dfaa" font="1|Arial|9.8|0|COCOA|1|ArialMT" textAlignment="1" borderType="2" xsi:type="archimate:Note">
    <content>Decisiones de negocio

Autoridad define; gestor registra.
Perfiles valida; Tarifas calcula.
VAMOS mueve saldo; banco cobra.
Consolidación agrupa, no concilia.
Corregir con rastro, sin editar cobros históricos.</content>
    <bounds x="624" y="620" width="552" height="170" />
  </child>
  <child id="id-64a8901a1fa454a88a547e3772a1ccd3" fillColor="#edf0f2" font="1|Arial|9.8|0|COCOA|1|ArialMT" textAlignment="1" borderType="2" xsi:type="archimate:Note">
    <content>Supuestos y configuración

ID estable y vigencia histórica disponibles. Importes y ventanas vienen de reglas autorizadas. Sin datos suficientes: «no tarifable», con causa.</content>
    <bounds x="1200" y="620" width="552" height="170" />
  </child>
  <child id="id-8ff7a858662555d284aea21de750b85d" fillColor="#dceef3" font="1|Arial|9.0|0|COCOA|1|ArialMT" textAlignment="1" borderType="2" xsi:type="archimate:Note">
    <content>Verificación

Exactitud por modo, medio, perfil y transbordo; causas de no tarifables; diferencias con equipos; tiempo de cálculo.</content>
    <bounds x="48" y="815" width="840" height="90" />
  </child>
  <child id="id-c08cebc7cf065e71bfd93b30808d41c8" fillColor="#edf0f2" font="1|Arial|9.0|0|COCOA|1|ArialMT" textAlignment="1" borderType="2" xsi:type="archimate:Note">
    <content>Límites

Fuera: dispositivos, certificación externa, saldos, cobro bancario, conciliación y pago a operadores.</content>
    <bounds x="912" y="815" width="840" height="90" />
  </child>
  <child id="id-1eda0a3c0a05575e9bc9414adefc562a" font="1|Arial|18.0|1|COCOA|1|ArialMT" textAlignment="1" fillColor="#ffffff" borderType="2" xsi:type="archimate:Note">
    <bounds x="48" y="14" width="1704" height="43" />
    <content>V11 · Canvas — Tarifas y transbordos</content>
  </child>
  <child id="id-3607d9f825885c388ab9892d7725cea9" font="1|Arial|10.5|0|COCOA|1|ArialMT" textAlignment="1" fillColor="#ffffff" borderType="2" xsi:type="archimate:Note">
    <bounds x="48" y="53" width="1704" height="25" />
    <content>Tema 4 · Un contexto principal en una página</content>
  </child>
  <child id="id-1d64299691c350df9545689f751d5c7e" font="1|Arial|10.5|1|COCOA|1|ArialMT" textAlignment="1" fillColor="#ffffff" borderType="2" xsi:type="archimate:Note">
    <bounds x="48" y="227" width="1704" height="25" />
    <content>Entradas</content>
  </child>
  <child id="id-41e8f00a69eb5e2a898d666d851a3fe8" font="1|Arial|10.5|1|COCOA|1|ArialMT" textAlignment="1" fillColor="#ffffff" borderType="2" xsi:type="archimate:Note">
    <bounds x="632" y="227" width="1120" height="25" />
    <content>Dentro de Tarifas y transbordos</content>
  </child>
  <child id="id-8ae1f437bcdd5a869611db1dcf03bebd" font="1|Arial|10.5|1|COCOA|1|ArialMT" textAlignment="1" fillColor="#ffffff" borderType="2" xsi:type="archimate:Note">
    <bounds x="1216" y="227" width="536" height="25" />
    <content>Salidas</content>
  </child>
  <child id="id-747cba19672e5734980c32545a1e6533" font="1|Arial|8.2|0|COCOA|1|ArialMT" textAlignment="1" fillColor="#ffffff" borderType="2" xsi:type="archimate:Note">
    <bounds x="48" y="915" width="1704" height="19" />
    <content>C: comando · Q: consulta · E: evento. Las flechas son colaboraciones lógicas; no requieren un bus de mensajes.</content>
  </child>
  <child id="id-2e81c079cce352e1b1386c68e1abec6e" font="1|Arial|7.5|0|COCOA|1|ArialMT" textAlignment="1" fillColor="#ffffff" borderType="2" xsi:type="archimate:Note">
    <bounds x="48" y="937" width="1704" height="18" />
    <content>Adaptación de DDD Crew · Bounded Context Canvas v5 · CC BY 4.0 · Detalle: Analisis-V10-V11.md</content>
