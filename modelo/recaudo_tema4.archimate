          <child xsi:type="archimate:DiagramObject" id="id-f6fcc226780d546e954ba536faded601" targetConnections="id-769c10543b285ab9bf74709f2a4b3083" font="1|Arial|9.0|0|COCOA|1|ArialMT" fillColor="#f3e5f5" archimateElement="id-9f1beb9c5cba5066ae4b98cf57b2690a">
