      <element xsi:type="archimate:Capability" name="Tarifas y descuentos" id="id-9842481f6d00592bb2b1b83908ced084">
        <documentation>Capacidad de nivel 1 (misional).</documentation>
        <property key="Nivel" value="1" />
        <property key="Tipo" value="Misional" />
        <property key="Nombre técnico" value="Tarifas y beneficios" />
