    <element xsi:type="archimate:Outcome" name="Solo quien tiene el certificado vigente paga tarifa con descuento" id="id-96679c68eca441f680cb199e881bd741">
      <documentation>Resultado que se busca. Se mide con: Uso de tarifas especiales por perfil y casos sospechosos revisados (B7.1). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
      <property key="Indicador" value="Uso de tarifas especiales por perfil y casos sospechosos revisados (B7.1)"/>
      <property key="Fuente" value="Entrevista B6.5 (l. 483-496); Entrevista B7.1 (l. 533-559)"/>
      <property key="Nombre técnico" value="Solo los titulares con certificación vigente usan tarifas especiales"/>
    </element>
    <element xsi:type="archimate:Outcome" name="Cada pasada por el validador queda cobrada con la tarifa y el transbordo vigentes" id="id-43dc0249aa664b85b381ac39c665a4e3">
      <documentation>Resultado que se busca. Se mide con: Reclamos por cobro doble o transbordo no reconocido, por causa raíz (B7.1). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
      <property key="Indicador" value="Reclamos por cobro doble o transbordo no reconocido, por causa raíz (B7.1)"/>
      <property key="Fuente" value="Entrevista B6.3 (l. 465-474); Entrevista B7.1 (l. 533-559)"/>
      <property key="Nombre técnico" value="Cada validación queda cobrada con la tarifa y la integración vigentes"/>
    </element>
    <element xsi:type="archimate:Outcome" name="Llegan completas, a tiempo y sin repetir las transacciones de los tres modos" id="id-56bb9c7b731343678e4e5a843cb16d3e">
      <documentation>Resultado que se busca. Se mide con: Equipos que reportaron en el plazo ÷ equipos en servicio (B7.2). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
      <property key="Indicador" value="Equipos que reportaron en el plazo ÷ equipos en servicio (B7.2)"/>
      <property key="Fuente" value="Entrevista B6.4 (l. 475-482); Entrevista B7.2 (l. 560-571)"/>
      <property key="Nombre técnico" value="Las transacciones de los tres modos se reciben completas, a tiempo y sin duplicados"/>
    </element>
    <element xsi:type="archimate:Outcome" name="La base consolidada por modo, ruta y operador se entrega cerrada y a tiempo, y cada diferencia que devuelve la conciliación se resuelve con un ajuste" id="id-c52caaa2bd8640aaad98e2f66f13bdc3">
      <documentation>Resultado que se busca. Se mide con: Días cerrados entregados a tiempo; valor y antigüedad de las diferencias que devuelve la conciliación; ajustes manuales (B7.1, B7.5). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
      <property key="Indicador" value="Días cerrados entregados a tiempo; valor y antigüedad de las diferencias que devuelve la conciliación; ajustes manuales (B7.1, B7.5)"/>
      <property key="Fuente" value="T4; Entrevista B7.1 (l. 533-559); Entrevista B7.5 (l. 592-600)"/>
    </element>
    <element xsi:type="archimate:Outcome" name="Los reclamos de saldo y cobro se resuelven dentro del plazo" id="id-f71243c8762549c38f454acbd6db6581">
      <documentation>Resultado que se busca. Se mide con: Reclamos respondidos en plazo ÷ radicados; reclamos por 100.000 validaciones (B7.2). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
      <property key="Indicador" value="Reclamos respondidos en plazo ÷ radicados; reclamos por 100.000 validaciones (B7.2)"/>
      <property key="Fuente" value="Entrevista B6.7 (l. 503-515); Entrevista B7.2 (l. 560-571)"/>
    </element>
    <element xsi:type="archimate:Outcome" name="Leyenda · Resultado" id="id-c50f0542e2bb4de58c74f90c0a728730">
      <property key="Uso" value="Leyenda de notación (no es parte del diseño)"/>
    </element>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-84da437262255e028a574d228f3e25eb" type="implementation_migration"/>
  <folder name="Other" id="id-a83d266232ec59a9b693b61f6e46ea7d" type="other">
    <folder name="Fase 1 · Motivación, capacidades y E2E" id="id-0bc692d8935c5aea9a38ad41a2e7e70e">
      <element xsi:type="archimate:Junction" id="id-e9a77e2c2c6a58b6954487dd1d797feb" type="or">
        <documentation>Bifurcación según el medio de pago.</documentation>
      </element>
      <element xsi:type="archimate:Junction" id="id-f05f3d75ce4c574e9273c45721ec90c9" type="or">
        <documentation>¿El usuario tiene una tarjeta VAMOS?</documentation>
      </element>
      <element xsi:type="archimate:Junction" id="id-66ebd702503c58b1afc0f2df7d22af2b" type="or">
        <documentation>¿La tarjeta VAMOS tiene saldo suficiente?</documentation>
      </element>
      <element xsi:type="archimate:Junction" id="id-594d7b92ae5e5a3da4aa874b0d4af48e" type="or">
        <documentation>Bifurcación según el medio de pago de la transacción.</documentation>
      </element>
    </folder>
    <folder name="Fase 2 · Servicios, anticorrupción y contratos" id="id-a0dd326be3a15bf78642851da3a1ce2f">
      <element xsi:type="archimate:Grouping" name="Capa 1. Servicios de plataforma: lo que pide cada paso del proceso" id="id-8741ebc472a853b08864c5642cce3b68">
        <documentation>Capa de servicios «Platform Business Service» (7_SOA diap. 20 y 28).</documentation>
        <property key="Nombre técnico" value="Capa 1. Servicios de negocio de plataforma"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Capa 2. Servicios de dominio: agrupados por tema del negocio" id="id-be9a0a3e1d855f5db2743df158dcf8fe">
        <documentation>Capa de servicios «Functional Domain Service» (7_SOA diap. 20 y 28).</documentation>
        <property key="Nombre técnico" value="Capa 2. Servicios de dominio"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Capa 3. Servicios básicos: tareas puntuales" id="id-6e8f1a3460da5f4aafa6ff8ac9aa85a0">
        <documentation>Capa de servicios «Functional Subdomain Basic Service» (7_SOA diap. 20 y 28).</documentation>
        <property key="Nombre técnico" value="Capa 3. Servicios básicos del subdominio"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Capa 4. Capa anticorrupción: traductores hacia otros sistemas" id="id-309930d10ab355ddaa92d88f51d10c3e">
        <documentation>Capa de servicios «Anti-corruption Layer Service» (7_SOA diap. 20 y 28).</documentation>
        <property key="Nombre técnico" value="Capa 4. Servicios de la capa anticorrupción"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Capa 5. Datos maestros: listas de referencia que usan todos" id="id-45f37bdcef0859ce93c025ab9dc54c71">
        <documentation>Capa de servicios «Fundamental Subdomain Service» (7_SOA diap. 20 y 28).</documentation>
        <property key="Nombre técnico" value="Capa 5. Servicios fundamentales (datos maestros)"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Capa 6. Infraestructura: servicios comunes a toda la aplicación" id="id-a9effff1af8a5e4ba65bc1c446995b09">
        <documentation>Capa de servicios «Infrastructure Service Layer» (7_SOA diap. 20 y 28).</documentation>
        <property key="Nombre técnico" value="Capa 6. Servicios de infraestructura"/>
      </element>
    </folder>
    <folder name="Fase 3 · Dominios y lenguaje ubicuo" id="id-d48e91e0ebb35adda803d7f4fff9850a">
      <element xsi:type="archimate:Grouping" name="Dominios centrales (core): lo que hace única a la aplicación" id="id-7f9c008f77525442b38bc79bea3aff6a">
        <documentation>Lo que diferencia al negocio (9_DDD diap. 11).</documentation>
        <property key="Nombre técnico" value="Dominios centrales (core)"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominios de soporte (supporting): necesarios, pero no son el corazón" id="id-d2614dfe3e9554138e2df352a460e265">
        <documentation>Apoyan al núcleo; su propósito es secundario.</documentation>
        <property key="Nombre técnico" value="Dominios de soporte (supporting)"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominios genéricos (generic): iguales que en cualquier empresa" id="id-d81780d979f2542b9026a04e20a5e8f7">
        <documentation>Comunes a cualquier organización.</documentation>
        <property key="Nombre técnico" value="Dominios genéricos (generic)"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominio: Tarifas y transbordos" id="id-797bdc4108f150249cad8d58d9c336c4">
        <documentation>Es lo que el Tema 4 pide como diferenciador: «la tarifa correcta en cada validación, considerando la integración entre modos». Concentra las reglas más variables (versiones de la autoridad, perfiles, ventana y combinaciones de transbordo) y sus errores son la causa más frecuente de reclamos y de pérdida de dinero (B3.6, B6.1, B6.3). No se puede comprar hecho: depende de las reglas de esta ciudad.</documentation>
        <property key="Clasificación" value="Central"/>
        <property key="Nombre técnico" value="Dominio: Tarificación e integración modal"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominio: Consolidación del recaudo" id="id-b7b574bc4da652288fb2e57fe0a33a52">
        <documentation>Sostiene la meta «cada peso llega a quien corresponde» (B1.4) y es la base de la distribución y la conciliación (T4). Las disputas con operadores son por conteo y atribución (B1.1, B3.6): atribuir bien por modo, ruta, operador y día de servicio es el valor propio del ente gestor.</documentation>
        <property key="Clasificación" value="Central"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominio: Tarjetas VAMOS y saldos" id="id-986ce57095bb5a05bbe811c8d5942a44">
        <documentation>Necesario para el núcleo (sin medio no hay viaje), pero sus reglas son conocidas en el sector: emisión, recarga, saldo, bloqueo y reposición (B3.2, B6.2).</documentation>
        <property key="Clasificación" value="Soporte"/>
        <property key="Nombre técnico" value="Dominio: Medios VAMOS y saldos"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominio: Perfiles y descuentos" id="id-7870e872e1e65920a2c8518b71ee6637">
        <documentation>Alimenta la tarificación con el derecho vigente; su lógica es un ciclo de vida con evidencia externa (B5.2, B5.3, B9.9).</documentation>
        <property key="Clasificación" value="Soporte"/>
        <property key="Nombre técnico" value="Dominio: Perfiles y beneficios"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominio: Pago con tarjeta del banco" id="id-38253c832fe95deea2f7a681dff4b001">
        <documentation>Es un canal de cobro para visitantes que aplica una práctica del sector (cobro agrupado, B3.3) y depende del adquirente; la decisión de cuánto cobrar la toma la tarificación. Por eso no es central, aunque sí complejo.</documentation>
        <property key="Clasificación" value="Soporte"/>
        <property key="Nombre técnico" value="Dominio: Pago abierto con tarjeta bancaria"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominio: Recepción de transacciones" id="id-dcfef684e16f59d29c6c158d1cfb0fa2">
        <documentation>Recibe y depura lo que generan los equipos (idempotencia, día de servicio, tardías: B6.4). Protege al núcleo de los formatos de los proveedores.</documentation>
        <property key="Clasificación" value="Soporte"/>
        <property key="Nombre técnico" value="Dominio: Captura de transacciones"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominio: Ajustes y reclamos" id="id-f836a21b475852e9bb057f04bd520c3c">
        <documentation>Aplica correcciones con doble control y huella (B4.3, B6.3); la gestión del reclamo como tal es de PQRS (externo).</documentation>
        <property key="Clasificación" value="Soporte"/>
        <property key="Nombre técnico" value="Dominio: Ajustes y soporte a reclamos"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominio: Rutas y calendario" id="id-bc73e7b2d15159e39e8ed6bb5c28b9ca">
        <documentation>Copia gobernada de rutas, modos, estaciones, operadores y días de servicio que define planeación (B9.6); el recaudo la necesita para atribuir.</documentation>
        <property key="Clasificación" value="Soporte"/>
        <property key="Nombre técnico" value="Dominio: Referencia de red y calendario"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominio: Usuarios internos y permisos" id="id-84d8f77330f955cb84dd1a7a1df74b92">
        <documentation>Autenticación, roles y segregación de funciones: igual en cualquier organización (B1.6, B4.3).</documentation>
        <property key="Clasificación" value="Genérico"/>
        <property key="Nombre técnico" value="Dominio: Identidad y acceso"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominio: Avisos" id="id-5e6530fb0fc25b8ea3fcd9e27322fad5">
        <documentation>Envío de avisos por SMS, correo o app mediante un proveedor (B9.12).</documentation>
        <property key="Clasificación" value="Genérico"/>
        <property key="Nombre técnico" value="Dominio: Notificaciones"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominio: Auditoría y soportes" id="id-adc93648d9035686aa88b7e0920de245">
        <documentation>Registro inmutable de quién hizo qué y cuándo, y gestión documental de soportes (B1.6, B9.9).</documentation>
        <property key="Clasificación" value="Genérico"/>
        <property key="Nombre técnico" value="Dominio: Auditoría y evidencia"/>
      </element>
    </folder>
    <folder name="Fase 4 · Agregados, comandos y eventos" id="id-ad9d599182ff509a9a3b239c31d4389b">
      <element xsi:type="archimate:Grouping" name="Agregado: Tarjeta VAMOS" id="id-8a3da05952b754318af98ef7230f6ecc">
        <documentation>Incluye los movimientos de saldo porque el saldo y su historial deben cambiar juntos; el titular queda fuera (solo una referencia) porque tiene su propio ciclo y datos personales.</documentation>
        <property key="Dominio" value="DOM-MED"/>
        <property key="Invariante 1" value="Una tarjeta física se registra una sola vez (número único)."/>
        <property key="Invariante 2" value="El saldo conocido solo cambia por movimientos registrados (validación, recarga acreditada o ajuste aprobado); nunca se edita."/>
        <property key="Invariante 3" value="Una tarjeta bloqueada por pérdida no vuelve a activarse: se repone."/>
        <property key="Invariante 4" value="Solo una tarjeta personalizada puede reponerse con traslado de saldo; la anónima no."/>
        <property key="Invariante 5" value="El saldo que se traslada es el saldo conocido a la hora del bloqueo efectivo (cuando la versión de la lista que incluye la tarjeta ya rige en los equipos) y solo se calcula cuando cerraron los días de servicio de esa hora, sin tardías pendientes; lo consumido entre la solicitud y el bloqueo efectivo se descuenta y no se devuelve."/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Recarga" id="id-b37faeaf07c250aa85424f0039ecf050">
        <documentation>Separada de la tarjeta porque nace en canales externos y su estado (pendiente, acreditada) cambia sin tocar la tarjeta hasta que se acredita.</documentation>
        <property key="Dominio" value="DOM-MED"/>
        <property key="Invariante 1" value="El identificador de operación es único: una recarga repetida se descarta."/>
        <property key="Invariante 2" value="El monto está entre el mínimo y el máximo del canal [parámetros configurables]."/>
        <property key="Invariante 3" value="No se recarga una tarjeta bloqueada."/>
        <property key="Invariante 4" value="Una recarga virtual queda pendiente hasta que un equipo confirme que la escribió en la tarjeta."/>
        <property key="Invariante 5" value="Una recarga se acredita una sola vez."/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Lista de bloqueo" id="id-ffe9873e295954d3883b9965bfa4b7d6">
        <documentation>Es una unidad de publicación hacia los equipos; reúne tarjetas VAMOS y tokens bancarios.</documentation>
        <property key="Dominio" value="DOM-MED"/>
        <property key="Invariante 1" value="Una versión publicada no cambia: los cambios van en la siguiente versión."/>
        <property key="Invariante 2" value="Cada entrada tiene causa y origen (titular, fraude o deuda)."/>
        <property key="Invariante 3" value="Un medio aparece una sola vez en cada versión."/>
        <property key="Invariante 4" value="Retirar un medio bloqueado por fraude requiere aprobación de un nivel superior."/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Perfil especial" id="id-276bf0c4b66a56fe945a0fea5556c495">
        <documentation>La certificación vive dentro del perfil porque la vigencia del beneficio depende de ella; la tarjeta queda fuera para no bloquear su uso cuando el perfil cambia.</documentation>
        <property key="Dominio" value="DOM-TAR"/>
        <property key="Invariante 1" value="Solo una tarjeta personalizada puede tener perfil especial."/>
        <property key="Invariante 2" value="El tipo es uno de los cuatro del Tema 4 y cada tipo exige su certificación: matrícula del colegio o de la universidad, identidad y edad para adulto mayor, certificado de la entidad competente para movilidad reducida."/>
        <property key="Invariante 3" value="Un perfil activo exige una certificación vigente con su evidencia."/>
        <property key="Invariante 4" value="Una tarjeta tiene a lo sumo un perfil especial activo [supuesto, configurable]."/>
        <property key="Invariante 5" value="Al vencer, el perfil deja de aplicarse: no se bloquea la tarjeta ni se toca su saldo."/>
        <property key="Invariante 6" value="Suspender o revocar requiere la decisión de un nivel autorizado y la notificación al titular."/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Versión tarifaria" id="id-a10fc0e85db8569d9e7776827cd8027b">
        <documentation>Agrupa tarifas y reglas de integración porque deben entrar en vigencia juntas y a la misma hora en todos los equipos.</documentation>
        <property key="Dominio" value="DOM-TAR"/>
        <property key="Invariante 1" value="Toda versión se apoya en una decisión de la autoridad."/>
        <property key="Invariante 2" value="No hay dos versiones vigentes al mismo tiempo."/>
        <property key="Invariante 3" value="Una versión aprobada no se modifica: un cambio es una versión nueva."/>
        <property key="Invariante 4" value="La vigencia no es retroactiva."/>
        <property key="Invariante 5" value="Cada tipo de perfil ofrecido tiene tarifa en la versión; la ventana y el número de transbordos son parámetros."/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Viaje" id="id-011ca87d74e85c7da85d7ffcc0e646a2">
        <documentation>El viaje es la unidad de cobro con integración: sus abordajes no tienen sentido tarifario por separado.</documentation>
        <property key="Dominio" value="DOM-TAR"/>
        <property key="Invariante 1" value="Un abordaje pertenece a un solo viaje."/>
        <property key="Invariante 2" value="Los abordajes de un viaje son del mismo medio y caen dentro de la ventana de la versión vigente en el primer abordaje."/>
        <property key="Invariante 3" value="Volver a subir en la misma ruta no genera transbordo [regla configurable]."/>
        <property key="Invariante 4" value="La tarifa del viaje es la de la regla de integración vigente, con el perfil vigente a la hora de cada abordaje."/>
        <property key="Invariante 5" value="La diferencia entre lo descontado por el equipo y la tarifa correcta queda registrada; nunca se oculta."/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Lote recibido de un equipo" id="id-5e7c16eb69ce58e5af63d6524ac60b19">
        <documentation>Pequeño a propósito: solo controla la recepción; cada transacción es su propio agregado.</documentation>
        <property key="Dominio" value="DOM-TRX"/>
        <property key="Invariante 1" value="Un lote se recibe una sola vez."/>
        <property key="Invariante 2" value="El estado de recepción refleja cuántas transacciones se aceptaron, descartaron o rechazaron."/>
        <property key="Nombre técnico" value="Agregado: Lote de transmisión"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Transacción de validación" id="id-b61f3314e66758e6a661b3e439c6d18e">
        <documentation>Una transacción por agregado permite recibir millones al día sin bloqueos entre ellas.</documentation>
        <property key="Dominio" value="DOM-TRX"/>
        <property key="Invariante 1" value="El identificador de transacción es único: una repetida se descarta (así nada se cuenta dos veces)."/>
        <property key="Invariante 2" value="El día de servicio es el del momento en que ocurrió, no el de llegada."/>
        <property key="Invariante 3" value="Una tardía fuera del plazo de aceptación pasa a excepción [plazo configurable]."/>
        <property key="Invariante 4" value="Una transacción aceptada no se modifica: se corrige con un ajuste."/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Viajes por cobrar a una tarjeta del banco" id="id-6b674c12ce63509c9613cd27e550e298">
        <documentation>Reúne viajes, intentos y deuda del mismo token y día porque el cobro, los reintentos y el bloqueo dependen del mismo estado.</documentation>
        <property key="Dominio" value="DOM-MED"/>
        <property key="Invariante 1" value="Cada viaje con su tarifa calculada entra en un solo cargo: ningún viaje se cobra dos veces ni queda sin cobrar."/>
        <property key="Invariante 2" value="Se genera un cargo al cierre del día de servicio, o antes si lo acumulado sin cobrar supera el umbral [configurable]; los cargos del día no superan el máximo configurado [1 = solo al cierre]."/>
        <property key="Invariante 3" value="La suma de los cargos del día no supera el tope diario si está configurado [desactivado por defecto; es un supuesto]."/>
        <property key="Invariante 4" value="Un abordaje que llega después de un cargo se tarifa con la integración de su viaje: el cargo siguiente solo cobra la diferencia."/>
        <property key="Invariante 5" value="Los reintentos no superan el máximo configurado."/>
        <property key="Invariante 6" value="Mientras haya deuda abierta, el token debe estar en la lista de bloqueo."/>
        <property key="Invariante 7" value="Nunca se guarda el número completo de la tarjeta: solo el token."/>
        <property key="Nombre técnico" value="Agregado: Cuenta de viajes bancaria"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Consolidado del día de servicio" id="id-74d8c28ca44e5f67a7c37dd9b64da33a">
        <documentation>El día de servicio es la unidad de cierre que pidió el experto (cierres diarios); las líneas por modo, ruta y operador deben cuadrar con el total.</documentation>
        <property key="Dominio" value="DOM-CON"/>
        <property key="Invariante 1" value="Cada transacción aceptada se cuenta una sola vez."/>
        <property key="Invariante 2" value="La suma de las líneas es igual al total de transacciones aceptadas del día."/>
        <property key="Invariante 3" value="Recargas recibidas (dinero ajeno), consumo por validaciones (ingreso) y resultados de cobro a tarjetas bancarias van en líneas separadas que nunca se suman entre sí; la base de distribución solo usa el consumo atribuido."/>
        <property key="Invariante 4" value="Toda línea tiene modo, ruta y operador vigentes en esa fecha."/>
        <property key="Invariante 5" value="Un consolidado cerrado solo cambia con una versión nueva que registra la causa."/>
        <property key="Invariante 6" value="La base de distribución solo se emite de días cerrados y sale como base consolidada: la conciliación (fuera de la aplicación) la compara con el dinero y devuelve las diferencias, que entran como ajustes."/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Ajuste" id="id-dadef602c7055daa9af90c224520c68c">
        <documentation>El ajuste protege el doble control; su efecto en la tarjeta y en el consolidado ocurre por eventos, fuera del agregado.</documentation>
        <property key="Dominio" value="DOM-CON"/>
        <property key="Invariante 1" value="Quien propone un ajuste no lo aprueba."/>
        <property key="Invariante 2" value="Un monto sobre el tope del rol exige aprobación superior [topes configurables]."/>
        <property key="Invariante 3" value="Todo ajuste referencia una transacción o una evidencia."/>
        <property key="Invariante 4" value="Un ajuste se aplica una sola vez."/>
        <property key="Invariante 5" value="La devolución en dinero no se ejecuta aquí: la paga tesorería o la fiducia."/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Ruta" id="id-a8a5aa94f9f35ff4b60090df7bbe07e2">
        <documentation>La consolidación necesita saber qué operador tenía cada ruta en cada fecha.</documentation>
        <property key="Dominio" value="DOM-TRX"/>
        <property key="Invariante 1" value="Una ruta tiene un solo operador asignado por periodo."/>
        <property key="Invariante 2" value="Las asignaciones de una ruta no se solapan en el tiempo."/>
        <property key="Invariante 3" value="Los cambios entran con fecha de vigencia presente o futura."/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Calendario de días de servicio" id="id-7b0db1654b5752baad5ff11ea436e17c">
        <documentation>Define la frontera de cada día de servicio para tardías y consolidación.</documentation>
        <property key="Dominio" value="DOM-TRX"/>
        <property key="Invariante 1" value="Cada día de servicio tiene una sola hora de corte."/>
        <property key="Invariante 2" value="Un día publicado solo cambia antes de comenzar."/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Notificación" id="id-48b5a3ca98da54cb8db3f0361ccbaa76">
        <documentation>Genérico: se adapta del proveedor.</documentation>
        <property key="Dominio" value="DOM-GEN"/>
        <property key="Invariante 1" value="Cada notificación se envía una sola vez por evento de origen."/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Registro de auditoría" id="id-3d29a9b4406c503ca6886da72960262f">
        <documentation>Genérico: cualquier sistema de auditoría lo resuelve.</documentation>
        <property key="Dominio" value="DOM-GEN"/>
        <property key="Invariante 1" value="Los registros solo se agregan; nunca se modifican ni se borran."/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Usuario interno" id="id-61075273e37c5986b74e84733a3f5154">
        <documentation>Genérico: la segregación de funciones es la única regla propia.</documentation>
        <property key="Dominio" value="DOM-GEN"/>
        <property key="Invariante 1" value="Un usuario no puede tener a la vez el rol que propone y el que aprueba un mismo tipo de ajuste."/>
      </element>
    </folder>
    <folder name="Fase 5 · Contextos e interoperabilidad" id="id-ec260f214fe15e87af26a8940a295dc9">
      <element xsi:type="archimate:Grouping" name="Núcleo compartido: códigos que usan todos" id="id-c9ec09251f7e5b1fa8b945fb21dc1132">
        <documentation>Núcleo compartido mínimo (9_DDD diap. 26: «todos los contextos usan el mismo ID»). Solo identificadores y tipos de valor, no reglas.</documentation>
        <property key="Contextos" value="BC-TRX, BC-TAR, BC-CON, BC-PAB, BC-MED"/>
        <property key="Nombre técnico" value="Núcleo compartido: identificadores"/>
      </element>
    </folder>
