        <documentation>Término del lenguaje ubicuo. Ejemplo: Tarjeta comprada en una taquilla.</documentation>
        <property key="Contexto" value="BC-MED"/>
        <property key="Fuente" value="T4; Entrevista B3.2 (l. 211-216)"/>
      </element>
      <element xsi:type="archimate:Representation" name="Tarjeta personalizada" id="id-eb42625cb9b15d498047b2d079bee1ec">
        <documentation>Término del lenguaje ubicuo. Ejemplo: La del estudiante con su documento.</documentation>
        <property key="Contexto" value="BC-MED, BC-PER"/>
        <property key="Fuente" value="Entrevista B3.2 (l. 211-216)"/>
      </element>
      <element xsi:type="archimate:Representation" name="Titular" id="id-78a13de60fde5654af035c6987b61bc9">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Quien reporta la pérdida.</documentation>
        <property key="Contexto" value="BC-MED, BC-PER"/>
        <property key="Fuente" value="Entrevista B3.2 (l. 211-216); Entrevista B6.2 (l. 458-464)"/>
