      <element xsi:type="archimate:BusinessObject" name="Notificación" id="id-3dc8351e415e57d199213bd9394f6489">
        <documentation>Aviso enviado al usuario.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Rastro de auditoría" id="id-727c6c407a69514f81213967636f5f32">
        <documentation>Constancia de quién hizo qué y cuándo.</documentation>
        <property key="Nombre técnico" value="Registro de auditoría" />
      </element>
      <element xsi:type="archimate:BusinessObject" name="Documento de soporte" id="id-d4223c9f801e5ecda39c1906fdf466c8">
        <documentation>Documento que respalda una decisión.</documentation>
        <property key="Nombre técnico" value="Soporte documental" />
      </element>
      <element xsi:type="archimate:BusinessObject" name="Rol" id="id-7047aea8d2b25e62be22102cf630cd06">
        <documentation>Conjunto de permisos de un usuario interno.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Tarjeta del banco" id="id-39c8359e38d9588294cc4499b36007cc">
        <documentation>Tarjeta débito o crédito usada como medio de pago, identificada solo por su token.</documentation>
        <property key="Nombre técnico" value="Tarjeta bancaria" />
      </element>
      <element xsi:type="archimate:Representation" name="Validación" id="id-cfc75fcbba9d54ba92983e4e7b4a5ae1">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Pasar la VAMOS por el validador del alimentador.</documentation>
        <property key="Contexto" value="BC-TRX, BC-TAR" />
        <property key="Fuente" value="Entrevista B3.1 (l. 198-210)" />
      </element>
      <element xsi:type="archimate:Representation" name="Abordaje" id="id-238b9aa8be5555baa1513434b4ea939f">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Un viaje alimentador + articulado tiene dos abordajes.</documentation>
        <property key="Contexto" value="BC-TAR" />
        <property key="Fuente" value="Entrevista B2.3 (l. 136-143)" />
      </element>
      <element xsi:type="archimate:Representation" name="Viaje" id="id-c25b749aba615314b38831394351063a">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Alimentador a las 7:05 y articulado a las 7:30 con una sola tarifa.</documentation>
        <property key="Contexto" value="BC-TAR" />
        <property key="Fuente" value="Entrevista B2.3 (l. 136-143); Entrevista B5.4 (l. 388-394)" />
      </element>
      <element xsi:type="archimate:Representation" name="Transbordo" id="id-a1b525c729db5b45ac65a36758e3549e">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Cambiar de alimentador a articulado.</documentation>
        <property key="Contexto" value="BC-TAR" />
        <property key="Fuente" value="Entrevista B5.4 (l. 388-394)" />
      </element>
      <element xsi:type="archimate:Representation" name="Ventana de transbordo" id="id-b6aa0c3d4a435d73bbcb84a79a2c5d62">
        <documentation>Término del lenguaje ubicuo. Ejemplo: El experto mencionó 60 a 90 minutos como supuesto.</documentation>
        <property key="Contexto" value="BC-TAR" />
        <property key="Fuente" value="Entrevista B2.2 (l. 130-134); Entrevista B5.4 (l. 388-394)" />
      </element>
      <element xsi:type="archimate:Representation" name="Tarifa plena" id="id-cd3684ba53aa54edb2bc4dd61fe37261">
        <documentation>Término del lenguaje ubicuo. Ejemplo: La que paga un visitante con tarjeta bancaria.</documentation>
        <property key="Contexto" value="BC-TAR" />
        <property key="Fuente" value="T4; Entrevista B2.5 (l. 150-153)" />
      </element>
      <element xsi:type="archimate:Representation" name="Tarifa especial" id="id-1479651cd8605302a2a63d463c1d0c5a">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Estudiante universitario.</documentation>
        <property key="Contexto" value="BC-TAR, BC-PER" />
        <property key="Fuente" value="T4; Entrevista B5.2 (l. 372-380)" />
      </element>
      <element xsi:type="archimate:Representation" name="Tarifa aplicada" id="id-8ee7085053f0570cb98508a9775890b3">
        <documentation>Término del lenguaje ubicuo. Ejemplo: El validador descontó una tarifa plena.</documentation>
        <property key="Contexto" value="BC-TRX" />
        <property key="Fuente" value="Entrevista B3.1 (l. 198-210); D-05" />
      </element>
      <element xsi:type="archimate:Representation" name="Tarifa correcta" id="id-3a94d1cb0d8c53a283d5cf3dd9e27ce0">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Debía ser transbordo y el equipo cobró completo: diferencia detectada.</documentation>
        <property key="Contexto" value="BC-TAR" />
        <property key="Fuente" value="T4; D-05" />
      </element>
      <element xsi:type="archimate:Representation" name="Versión tarifaria" id="id-3cf62d8dd6cb57e5b2d1551231fed994">
        <documentation>Término del lenguaje ubicuo. Ejemplo: La versión que entra en vigencia el primer día hábil del año.</documentation>
        <property key="Contexto" value="BC-TAR" />
        <property key="Fuente" value="Entrevista B4.4 (l. 319-324); Entrevista B5.1 (l. 366-371)" />
      </element>
      <element xsi:type="archimate:Representation" name="Perfil especial" id="id-00b01c3e0ab35fb7a460cae84aa1b9e7">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Perfil adulto mayor activo.</documentation>
        <property key="Contexto" value="BC-PER" />
        <property key="Fuente" value="T4; Entrevista B5.2 (l. 372-380); Entrevista B5.3 (l. 381-387)" />
      </element>
      <element xsi:type="archimate:Representation" name="Certificación" id="id-ed787df1a17258ba84ffba31dc51a699">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Listado de matrícula de una universidad.</documentation>
        <property key="Contexto" value="BC-PER" />
        <property key="Fuente" value="Entrevista B9.9 (l. 799-807)" />
      </element>
      <element xsi:type="archimate:Representation" name="Tarjeta VAMOS" id="id-ca97974c465e591dbf1199fc64bf1da8">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Tarjeta comprada en una taquilla.</documentation>
        <property key="Contexto" value="BC-MED" />
        <property key="Fuente" value="T4; Entrevista B3.2 (l. 211-216)" />
      </element>
      <element xsi:type="archimate:Representation" name="Tarjeta personalizada" id="id-eb42625cb9b15d498047b2d079bee1ec">
        <documentation>Término del lenguaje ubicuo. Ejemplo: La del estudiante con su documento.</documentation>
        <property key="Contexto" value="BC-MED, BC-PER" />
        <property key="Fuente" value="Entrevista B3.2 (l. 211-216)" />
      </element>
      <element xsi:type="archimate:Representation" name="Titular" id="id-78a13de60fde5654af035c6987b61bc9">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Quien reporta la pérdida.</documentation>
        <property key="Contexto" value="BC-MED, BC-PER" />
        <property key="Fuente" value="Entrevista B3.2 (l. 211-216); Entrevista B6.2 (l. 458-464)" />
      </element>
      <element xsi:type="archimate:Representation" name="Saldo conocido" id="id-037c7892502b5df2a80729d145bb3730">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Consulta en la app: «saldo a las 18:40 de ayer».</documentation>
        <property key="Contexto" value="BC-MED" />
        <property key="Fuente" value="Entrevista B6.4 (l. 475-482); D-09" />
      </element>
      <element xsi:type="archimate:Representation" name="Recarga pendiente" id="id-c923b684debe517282fdea6bcd92f205">
        <documentation>Término del lenguaje ubicuo. Ejemplo: «Pagué y no tengo saldo».</documentation>
        <property key="Contexto" value="BC-MED" />
        <property key="Fuente" value="Entrevista B3.2 (l. 211-216); Entrevista B5.6 (l. 400-406)" />
      </element>
      <element xsi:type="archimate:Representation" name="Bloqueo" id="id-65cd5170f0e85d82931be2bf2e10e233">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Tarjeta reportada como robada.</documentation>
        <property key="Contexto" value="BC-MED, BC-PAB" />
        <property key="Fuente" value="Entrevista B5.8 (l. 418-427); Entrevista B6.2 (l. 458-464)" />
      </element>
      <element xsi:type="archimate:Representation" name="Reposición" id="id-b41955a11bdb5178bb50bbbfbf6a50a9">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Tras la pérdida, con documento.</documentation>
        <property key="Contexto" value="BC-MED" />
        <property key="Fuente" value="Entrevista B6.2 (l. 458-464)" />
      </element>
      <element xsi:type="archimate:Representation" name="Token" id="id-ce320c17b5ea53299451541edcac3964">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Nunca se ve el número completo.</documentation>
        <property key="Contexto" value="BC-PAB" />
        <property key="Fuente" value="Entrevista B9.8 (l. 789-798); Entrevista B10.3 (l. 903-917)" />
      </element>
      <element xsi:type="archimate:Representation" name="Cobro agrupado" id="id-5e401d793e9e546ab1e1fc8e2c76746d">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Tres abordajes del día se cobran juntos en el cargo del cierre.</documentation>
        <property key="Contexto" value="BC-PAB" />
        <property key="Fuente" value="Entrevista B3.3 (l. 217-228)" />
      </element>
      <element xsi:type="archimate:Representation" name="Deuda" id="id-cd665ec48e4e5889b82b3dacd7b9e684">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Fondos insuficientes al cierre.</documentation>
        <property key="Contexto" value="BC-PAB" />
        <property key="Fuente" value="Entrevista B5.8 (l. 418-427)" />
      </element>
      <element xsi:type="archimate:Representation" name="Contracargo" id="id-0d4398d77ebd5be694ab483165883faa">
        <documentation>Término del lenguaje ubicuo. Ejemplo: El titular desconoce el cargo.</documentation>
        <property key="Contexto" value="BC-PAB" />
        <property key="Fuente" value="Entrevista B3.3 (l. 217-228); Entrevista B5.8 (l. 418-427)" />
      </element>
      <element xsi:type="archimate:Representation" name="Día de servicio" id="id-a416615af55e53f2b09a5216a41c4aef">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Un viaje a las 00:30 puede pertenecer al día anterior.</documentation>
        <property key="Contexto" value="BC-TRX, BC-CON, BC-RED" />
        <property key="Fuente" value="Entrevista B6.4 (l. 475-482); Entrevista B8.6 (l. 680-706)" />
