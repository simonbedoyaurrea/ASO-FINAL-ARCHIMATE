        <property key="Fuente" value="Entrevista B5.8 (l. 418-427)"/>
      </element>
      <element xsi:type="archimate:Representation" name="Contracargo" id="id-0d4398d77ebd5be694ab483165883faa">
        <documentation>Término del lenguaje ubicuo. Ejemplo: El titular desconoce el cargo.</documentation>
        <property key="Contexto" value="BC-PAB"/>
