        <documentation>Término del lenguaje ubicuo. Ejemplo: La versión que entra en vigencia el primer día hábil del año.</documentation>
        <property key="Contexto" value="BC-TAR"/>
        <property key="Fuente" value="Entrevista B4.4 (l. 319-324); Entrevista B5.1 (l. 366-371)"/>
      </element>
