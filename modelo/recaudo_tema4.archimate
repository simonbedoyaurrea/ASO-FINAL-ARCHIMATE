        <property key="Fuente" value="Entrevista B6.2 (l. 458-464)"/>
      </element>
      <element xsi:type="archimate:Representation" name="Token" id="id-ce320c17b5ea53299451541edcac3964">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Nunca se ve el número completo.</documentation>
        <property key="Contexto" value="BC-PAB"/>
        <property key="Fuente" value="Entrevista B9.8 (l. 789-798); Entrevista B10.3 (l. 903-917)"/>
