Formato y protocolo: API del contexto dueño (petición y respuesta en JSON sobre HTTPS) y eventos de dominio publicados para los consumidores; la versión del contrato va en la interfaz [decisión de diseño D-24]
Versión: 1.0</documentation>
        <property key="Servicio" value="SI5"/>
        <property key="Versión" value="1.0"/>
        <property key="Nombre técnico" value="Contrato SI5: Gestión documental"/>
        <property key="Formato y protocolo" value="API del contexto dueño (petición y respuesta en JSON sobre HTTPS) y eventos de dominio publicados para los consumidores; la versión del contrato va en la interfaz [decisión de diseño D-24]"/>
      </element>
    </folder>
    <folder name="Fase 3 · Dominios y lenguaje ubicuo" id="id-9cc45ec922135e289631e8552c446817">
      <element xsi:type="archimate:BusinessObject" name="Abordaje" id="id-7bcb2878f2e053a3bcefa3e744e490fc">
        <documentation>Validación vista como parte de un viaje.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Ruta" id="id-f7e05848fb555f2e80fc4b8848d993f2">
        <documentation>Recorrido de un modo con su operador asignado.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Qué operador tiene cada ruta" id="id-3b0cfc9307a05d8eb7c224b307d3fde4">
        <documentation>Operador asignado a una ruta en un periodo.</documentation>
        <property key="Nombre técnico" value="Asignación ruta-operador"/>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Día de servicio" id="id-226c5d589ec756088350f1ca0df0ce59">
        <documentation>Jornada de operación con su hora de corte.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Empleado que usa la aplicación" id="id-a7cffc02a89252c695a31752936d2751">
        <documentation>Persona del ente gestor que usa la aplicación.</documentation>
        <property key="Nombre técnico" value="Usuario interno"/>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Notificación" id="id-3dc8351e415e57d199213bd9394f6489">
        <documentation>Aviso enviado al usuario.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Rastro de auditoría" id="id-727c6c407a69514f81213967636f5f32">
        <documentation>Constancia de quién hizo qué y cuándo.</documentation>
        <property key="Nombre técnico" value="Registro de auditoría"/>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Documento de soporte" id="id-d4223c9f801e5ecda39c1906fdf466c8">
        <documentation>Documento que respalda una decisión.</documentation>
        <property key="Nombre técnico" value="Soporte documental"/>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Rol" id="id-7047aea8d2b25e62be22102cf630cd06">
        <documentation>Conjunto de permisos de un usuario interno.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Tarjeta del banco" id="id-39c8359e38d9588294cc4499b36007cc">
        <documentation>Tarjeta débito o crédito usada como medio de pago, identificada solo por su token.</documentation>
        <property key="Nombre técnico" value="Tarjeta bancaria"/>
      </element>
      <element xsi:type="archimate:Representation" name="Validación" id="id-cfc75fcbba9d54ba92983e4e7b4a5ae1">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Pasar la VAMOS por el validador del alimentador.</documentation>
        <property key="Contexto" value="BC-TRX, BC-TAR"/>
        <property key="Fuente" value="Entrevista B3.1 (l. 198-210)"/>
      </element>
      <element xsi:type="archimate:Representation" name="Abordaje" id="id-238b9aa8be5555baa1513434b4ea939f">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Un viaje alimentador + articulado tiene dos abordajes.</documentation>
        <property key="Contexto" value="BC-TAR"/>
        <property key="Fuente" value="Entrevista B2.3 (l. 136-143)"/>
      </element>
      <element xsi:type="archimate:Representation" name="Viaje" id="id-c25b749aba615314b38831394351063a">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Alimentador a las 7:05 y articulado a las 7:30 con una sola tarifa.</documentation>
        <property key="Contexto" value="BC-TAR"/>
        <property key="Fuente" value="Entrevista B2.3 (l. 136-143); Entrevista B5.4 (l. 388-394)"/>
      </element>
      <element xsi:type="archimate:Representation" name="Transbordo" id="id-a1b525c729db5b45ac65a36758e3549e">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Cambiar de alimentador a articulado.</documentation>
        <property key="Contexto" value="BC-TAR"/>
        <property key="Fuente" value="Entrevista B5.4 (l. 388-394)"/>
      </element>
      <element xsi:type="archimate:Representation" name="Ventana de transbordo" id="id-b6aa0c3d4a435d73bbcb84a79a2c5d62">
        <documentation>Término del lenguaje ubicuo. Ejemplo: El experto mencionó 60 a 90 minutos como supuesto.</documentation>
        <property key="Contexto" value="BC-TAR"/>
        <property key="Fuente" value="Entrevista B2.2 (l. 130-134); Entrevista B5.4 (l. 388-394)"/>
      </element>
      <element xsi:type="archimate:Representation" name="Tarifa plena" id="id-cd3684ba53aa54edb2bc4dd61fe37261">
        <documentation>Término del lenguaje ubicuo. Ejemplo: La que paga un visitante con tarjeta bancaria.</documentation>
        <property key="Contexto" value="BC-TAR"/>
        <property key="Fuente" value="T4; Entrevista B2.5 (l. 150-153)"/>
      </element>
      <element xsi:type="archimate:Representation" name="Tarifa especial" id="id-1479651cd8605302a2a63d463c1d0c5a">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Estudiante universitario.</documentation>
        <property key="Contexto" value="BC-TAR, BC-PER"/>
        <property key="Fuente" value="T4; Entrevista B5.2 (l. 372-380)"/>
      </element>
      <element xsi:type="archimate:Representation" name="Tarifa aplicada" id="id-8ee7085053f0570cb98508a9775890b3">
        <documentation>Término del lenguaje ubicuo. Ejemplo: El validador descontó una tarifa plena.</documentation>
        <property key="Contexto" value="BC-TRX"/>
        <property key="Fuente" value="Entrevista B3.1 (l. 198-210); D-05"/>
      </element>
      <element xsi:type="archimate:Representation" name="Tarifa correcta" id="id-3a94d1cb0d8c53a283d5cf3dd9e27ce0">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Debía ser transbordo y el equipo cobró completo: diferencia detectada.</documentation>
