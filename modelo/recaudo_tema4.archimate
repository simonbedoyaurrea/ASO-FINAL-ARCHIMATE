            <sourceConnection xsi:type="archimate:Connection" id="id-b9848a4fc6615b7a93a50c41ab5267c3" font="1|Arial|9.0|0|COCOA|1|ArialMT" source="id-acee7b7e60495b93b513c3bfe8e0c5d1" target="id-bc296c1ded0e5ca4bc28c66a92d30fc5" archimateRelationship="id-86a36ff5a66959d69e5dd5f0fb7de90a">
