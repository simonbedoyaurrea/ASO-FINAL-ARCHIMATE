      </element>
      <element xsi:type="archimate:Grouping" name="Métricas de verificación" id="id-d2a61d3bd5155ed9af4fa47a34c51dc2">
        <documentation>Sección «Métricas de verificación» del Bounded Context Canvas (9_DDD diap. 34-35).</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Preguntas abiertas" id="id-d74689969a4150b4a113a43892c12037">
        <documentation>Sección «Preguntas abiertas» del Bounded Context Canvas (9_DDD diap. 34-35).</documentation>
      </element>
    </folder>
  </folder>
  <folder name="Relations" id="id-46e8096e9cdd5e4ca47004862efd4eb2" type="relations">
    <folder name="Fase 1 · Motivación, capacidades y E2E" id="id-e2dc23612847532688826a97454ac69e">
