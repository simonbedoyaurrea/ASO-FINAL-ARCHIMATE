        <property key="Fuente" value="Entrevista B4.3 (l. 311-318); Entrevista B9.7 (l. 784-788)"/>
        <property key="Nombre técnico" value="Separar quien propone un ajuste, una devolución o un desbloqueo de quien lo aprueba"/>
      </element>
