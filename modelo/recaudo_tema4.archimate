  <folder name="Technology &amp; Physical" id="id-40be62ee3f6c5222ac06e837b807e76d" type="technology"/>
  <folder name="Motivation" id="id-7780bc295be25e32a220f76bebb1681f" type="motivation">






    <folder name="Fase 1 · Motivación, capacidades y E2E" id="id-c0fdbf969bbe53688f6a58c60d758a1f">
      <element xsi:type="archimate:Stakeholder" name="Pasajeros (de la ciudad y visitantes)" id="id-bbb0d9f850055e1b99fdbe08154788fe">
        <documentation>Qué espera del recaudo: Cobrar bien, recargar fácil, no perder saldo, transbordar sin pagar dos veces y resolver reclamos rápido.</documentation>
        <property key="Fuente" value="Entrevista B1.1 (l. 49-57); T4"/>
        <property key="Nombre técnico" value="Usuarios (residentes y visitantes)"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Autoridad de transporte" id="id-5ea9c14fc08652009fa2db8dc2737966">
        <documentation>Qué espera del recaudo: Cifras confiables de demanda e ingresos para fijar tarifas, planear y rendir cuentas.</documentation>
        <property key="Fuente" value="Entrevista B1.1 (l. 49-57); Entrevista B2.4 (l. 144-149)"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Ente gestor" id="id-608148ed3ee0520ca88f18e3da202ee7">
        <documentation>Qué espera del recaudo: Planear, contratar, supervisar y conciliar con cifras verificables; es quien opera el sistema integrado y pide el software.</documentation>
        <property key="Fuente" value="Entrevista B2.1 (l. 119-128); T4"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Operadores de transporte" id="id-35434d2179f453d187ac7fcc7face8f7">
        <documentation>Qué espera del recaudo: Que se les liquide lo que les corresponde, a tiempo y de forma verificable.</documentation>
        <property key="Fuente" value="Entrevista B1.1 (l. 49-57)"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Alcaldía, Hacienda y Nación" id="id-97149074a688557294a23f2b91c5048b">
        <documentation>Qué espera del recaudo: Saber cuánto subsidio se necesita y que los recursos públicos no se pierdan.</documentation>
        <property key="Fuente" value="Entrevista B1.1 (l. 49-57)"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Fiduciaria y bancos" id="id-200b7f05760a5f3bb0caf4ab5f5c7fcb">
        <documentation>Qué espera del recaudo: Conciliar y dispersar dinero sin descuadres.</documentation>
        <property key="Fuente" value="Entrevista B1.1 (l. 49-57)"/>
        <property key="Nombre técnico" value="Fiduciaria y entidades financieras"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Tiendas y puntos de recarga" id="id-d821c9e97d4a556c9001d1ce3475a4b6">
        <documentation>Qué espera del recaudo: Comisión justa y pago oportuno.</documentation>
        <property key="Fuente" value="Entrevista B1.1 (l. 49-57)"/>
        <property key="Nombre técnico" value="Comercios y puntos de recarga"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Entes de control" id="id-4e5c658b6e475345b51e8118c40fca0e">
        <documentation>Qué espera del recaudo: Trazabilidad y cumplimiento.</documentation>
        <property key="Fuente" value="Entrevista B1.1 (l. 49-57)"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Veedurías y grupos ciudadanos" id="id-ac364e03d66a51adb3469cc5a9dea6b0">
        <documentation>Qué espera del recaudo: Transparencia y equidad.</documentation>
        <property key="Fuente" value="Entrevista B1.1 (l. 49-57)"/>
        <property key="Nombre técnico" value="Veedurías y organizaciones ciudadanas"/>
      </element>
      <element xsi:type="archimate:Driver" name="Necesidad de plata para operar el sistema" id="id-c0f6808e1692552989fdeb241b8c3776">
        <documentation>La tarifa al usuario suele ser menor que el costo técnico y la demanda cayó [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.2 (l. 58-64)"/>
        <property key="Nombre técnico" value="Presión financiera"/>
      </element>
      <element xsi:type="archimate:Driver" name="Gente que no paga y plata que se pierde" id="id-6b31940d2f9b581b9fd6cd8672e97f49">
        <documentation>Colados, uso indebido de tarifas diferenciales y fraude con tarjetas.</documentation>
        <property key="Fuente" value="Entrevista B1.2 (l. 58-64)"/>
        <property key="Nombre técnico" value="Evasión y fugas de ingreso"/>
      </element>
      <element xsi:type="archimate:Driver" name="Nuevas formas de pagar el pasaje" id="id-8fd25c8195ec59fbad92b4262c12580d">
        <documentation>El usuario espera pagar con su tarjeta bancaria sin comprar antes un medio propio [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.2 (l. 58-64)"/>
        <property key="Nombre técnico" value="Cambio tecnológico en medios de pago"/>
      </element>
      <element xsi:type="archimate:Driver" name="Leyes y normas que hay que cumplir" id="id-fa0a1642ceb758208bc0c0fba010995c">
        <documentation>Protección del consumidor, datos personales, interoperabilidad y control del gasto público.</documentation>
        <property key="Fuente" value="Entrevista B1.2 (l. 58-64)"/>
        <property key="Nombre técnico" value="Regulación"/>
      </element>
      <element xsi:type="archimate:Driver" name="Tarifas justas para quien lo necesita" id="id-951ac8f4e2215aa5acef60b4f62e823e">
        <documentation>Tarifas diferenciales, subsidios focalizados y accesibilidad para quien no tiene cuenta bancaria.</documentation>
        <property key="Fuente" value="Entrevista B1.2 (l. 58-64)"/>
        <property key="Nombre técnico" value="Equidad"/>
      </element>
      <element xsi:type="archimate:Driver" name="Lo que exige la gente" id="id-1eb5240150d55ecdb2af800beae599ca">
        <documentation>Menos tolerancia a las filas, a los saldos «perdidos» y a la falta de explicaciones.</documentation>
        <property key="Fuente" value="Entrevista B1.2 (l. 58-64)"/>
        <property key="Nombre técnico" value="Exigencia ciudadana"/>
      </element>
      <element xsi:type="archimate:Assessment" name="Sin plata no hay buses: el recaudo es la caja del sistema" id="id-7eaa02f16021503e9a7ee148bbec6d7b">
        <documentation>Urgencia 1 según el experto [Supuesto, su criterio].</documentation>
        <property key="Fuente" value="Entrevista B1.3 (l. 65-69)"/>
        <property key="Nombre técnico" value="Sin caja no hay operación: el recaudo es la caja"/>
      </element>
      <element xsi:type="archimate:Assessment" name="Muchos reclamos: recargas que no aparecen, cobros dobles y transbordos que no se reconocen" id="id-c82c840fb374586d9e4b9d533ce724f2">
        <documentation>Problemas más frecuentes [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B2.6 (l. 154-166); Entrevista B6.1 (l. 448-457)"/>
        <property key="Nombre técnico" value="Reclamos frecuentes por recargas no reflejadas, cobros dobles y transbordos no reconocidos"/>
      </element>
      <element xsi:type="archimate:Assessment" name="Errores al cobrar el transbordo o la tarifa con descuento" id="id-c3e0cac62c0757b7b45ffde639977ab7">
        <documentation>Fuente de pérdida de dinero y de reclamos [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B3.6 (l. 252-267); Entrevista B6.3 (l. 465-474)"/>
        <property key="Nombre técnico" value="Errores en la aplicación del transbordo o de la tarifa diferencial"/>
      </element>
      <element xsi:type="archimate:Assessment" name="Diferencias de plata sin cuadrar y cuadres casi a mano con terceros que usan formatos distintos" id="id-caac69bda99455db96d6f5225b624e6c">
        <documentation>Donde más tiempo se pierde [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B3.6 (l. 252-267); Entrevista B8.2 (l. 632-641)"/>
        <property key="Nombre técnico" value="Diferencias sin conciliar y conciliación semimanual con terceros de formatos distintos"/>
      </element>
      <element xsi:type="archimate:Assessment" name="El sistema central de recaudo lo maneja un tercero y hay sistemas viejos" id="id-b9186b7879bc50019019ef63f5842407">
        <documentation>«Es el corazón y no es mío»; cambiarla exige negociar el contrato [Supuesto].</documentation>
        <property key="Fuente" value="Entrevista B8.2 (l. 632-641); Entrevista B8.5 (l. 670-679)"/>
        <property key="Nombre técnico" value="Plataforma central de recaudo en manos de un tercero y sistemas heredados"/>
      </element>
      <element xsi:type="archimate:Assessment" name="Pagar con tarjeta del banco facilita viajar, pero trae cobros rechazados y devoluciones después del viaje" id="id-d5f8044a6dc65c2aa5fdb93a25f73409">
        <documentation>[Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.3 (l. 65-69); Entrevista B2.5 (l. 150-153)"/>
        <property key="Nombre técnico" value="El pago con tarjeta bancaria baja barreras, pero trae rechazos y contracargos después del viaje"/>
      </element>
      <element xsi:type="archimate:Assessment" name="Descuentos usados por otras personas o con certificados vencidos" id="id-a4f6109a826552cd8fb9b227aa6b6c5f">
        <documentation>Uso indebido de tarifas especiales [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B2.6 (l. 154-166); Entrevista B6.5 (l. 483-496)"/>
        <property key="Nombre técnico" value="Beneficios usados por terceros o con certificados vencidos"/>
      </element>
      <element xsi:type="archimate:Goal" name="Residentes y visitantes pagan su viaje de forma ágil y con la tarifa que les corresponde" id="id-63ea7c03c0df5ff48c45324059448cf9">
        <documentation>Solicitud literal del Tema 4.</documentation>
        <property key="Fuente" value="T4"/>
      </element>
      <element xsi:type="archimate:Goal" name="Que cada peso que paga el pasajero llegue completo, a tiempo y con soporte a quien le corresponde" id="id-83f1215f95a35ebfb7f16ef27604bdb5">
        <documentation>Lo que busca la gerencia con el recaudo.</documentation>
        <property key="Fuente" value="Entrevista B1.4 (l. 70-80)"/>
        <property key="Nombre técnico" value="Cada peso pagado por el pasajero llega a quien corresponde, completo, a tiempo y con evidencia"/>
      </element>
      <element xsi:type="archimate:Goal" name="Que los descuentos los reciba solo quien cumple las condiciones" id="id-70411d2053ec5e7d907fdcb6cc06ad40">
        <documentation>Alcance del Tema 4 («validación de que el usuario cumple las condiciones») y control de uso indebido.</documentation>
        <property key="Fuente" value="T4; Entrevista B5.2 (l. 372-380); Entrevista B6.5 (l. 483-496)"/>
        <property key="Nombre técnico" value="Los beneficios tarifarios los reciben solo quienes cumplen las condiciones de su perfil"/>
      </element>
      <element xsi:type="archimate:Goal" name="Que los problemas de saldo y cobro se resuelvan rápido y dejando rastro" id="id-5354d33793d85ec1887321aad20280f0">
        <documentation>Necesidad común a todos los usuarios: saber el saldo, no ser cobrados dos veces y obtener respuesta con plazo.</documentation>
        <property key="Fuente" value="Entrevista B4.5 (l. 325-331); Entrevista B6.7 (l. 503-515)"/>
        <property key="Nombre técnico" value="Los problemas de saldo y cobro del usuario se resuelven con rapidez y trazabilidad"/>
      </element>
      <element xsi:type="archimate:Outcome" name="Cada pasada por el validador queda cobrada con la tarifa y el transbordo vigentes" id="id-7beffbb353d15db99fd8532ab6fbef81">
        <documentation>Resultado que se busca. Se mide con: Reclamos por cobro doble o transbordo no reconocido, por causa raíz (B7.1). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
        <property key="Indicador" value="Reclamos por cobro doble o transbordo no reconocido, por causa raíz (B7.1)"/>
        <property key="Fuente" value="Entrevista B6.3 (l. 465-474); Entrevista B7.1 (l. 533-559)"/>
        <property key="Nombre técnico" value="Cada validación queda cobrada con la tarifa y la integración vigentes"/>
      </element>
      <element xsi:type="archimate:Outcome" name="Los visitantes viajan sin tener que comprar una tarjeta" id="id-f0e9b1d2a62a5b5aa0ab8757a9cfa49f">
        <documentation>Resultado que se busca. Se mide con: Participación de las tarjetas bancarias en las validaciones [indicador propuesto por el diseño; el experto no lo nombró]. Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
        <property key="Indicador" value="Participación de las tarjetas bancarias en las validaciones [indicador propuesto por el diseño; el experto no lo nombró]"/>
        <property key="Fuente" value="T4; Entrevista B2.5 (l. 150-153)"/>
        <property key="Nombre técnico" value="Los visitantes viajan sin adquirir una tarjeta propia"/>
      </element>
      <element xsi:type="archimate:Outcome" name="La plata que entra cuadra con la que debía entrar según las validaciones" id="id-992e0708ded350cfbe267e58a3608852">
        <documentation>Resultado que se busca. Se mide con: Recaudo efectivo ÷ valor de validaciones y recargas del periodo (B7.2). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
        <property key="Indicador" value="Recaudo efectivo ÷ valor de validaciones y recargas del periodo (B7.2)"/>
        <property key="Fuente" value="Entrevista B1.4 (l. 70-80); Entrevista B7.2 (l. 560-571)"/>
        <property key="Nombre técnico" value="El recaudo efectivo coincide con el esperado según las validaciones"/>
      </element>
      <element xsi:type="archimate:Outcome" name="Llegan completas, a tiempo y sin repetir las transacciones de los tres modos" id="id-13a28167b0705e2db6d33d37b46d3ac5">
        <documentation>Resultado que se busca. Se mide con: Equipos que reportaron en el plazo ÷ equipos en servicio (B7.2). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
        <property key="Indicador" value="Equipos que reportaron en el plazo ÷ equipos en servicio (B7.2)"/>
        <property key="Fuente" value="Entrevista B6.4 (l. 475-482); Entrevista B7.2 (l. 560-571)"/>
        <property key="Nombre técnico" value="Las transacciones de los tres modos se reciben completas, a tiempo y sin duplicados"/>
      </element>
      <element xsi:type="archimate:Outcome" name="La base consolidada por modo, ruta y operador se entrega cerrada y a tiempo, y cada diferencia que devuelve la conciliación se resuelve con un ajuste" id="id-662a281a8fa35574a6957d7d8a234ca5">
        <documentation>Resultado que se busca. Se mide con: Días cerrados entregados a tiempo; valor y antigüedad de las diferencias que devuelve la conciliación; ajustes manuales (B7.1, B7.5). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
        <property key="Indicador" value="Días cerrados entregados a tiempo; valor y antigüedad de las diferencias que devuelve la conciliación; ajustes manuales (B7.1, B7.5)"/>
        <property key="Fuente" value="T4; Entrevista B7.1 (l. 533-559); Entrevista B7.5 (l. 592-600)"/>
      </element>
      <element xsi:type="archimate:Outcome" name="Solo quien tiene el certificado vigente paga tarifa con descuento" id="id-e273da232e4f5fa39b005e505fcd8f73">
        <documentation>Resultado que se busca. Se mide con: Uso de tarifas especiales por perfil y casos sospechosos revisados (B7.1). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
        <property key="Indicador" value="Uso de tarifas especiales por perfil y casos sospechosos revisados (B7.1)"/>
        <property key="Fuente" value="Entrevista B6.5 (l. 483-496); Entrevista B7.1 (l. 533-559)"/>
        <property key="Nombre técnico" value="Solo los titulares con certificación vigente usan tarifas especiales"/>
      </element>
      <element xsi:type="archimate:Outcome" name="Los reclamos de saldo y cobro se resuelven dentro del plazo" id="id-c410b7e848f151e9939838c05e6a04ef">
        <documentation>Resultado que se busca. Se mide con: Reclamos respondidos en plazo ÷ radicados; reclamos por 100.000 validaciones (B7.2). Umbrales: el experto aclaró que sus cifras no son estándar (B7.3).</documentation>
        <property key="Indicador" value="Reclamos respondidos en plazo ÷ radicados; reclamos por 100.000 validaciones (B7.2)"/>
        <property key="Fuente" value="Entrevista B6.7 (l. 503-515); Entrevista B7.2 (l. 560-571)"/>
      </element>
      <element xsi:type="archimate:Principle" name="No mezclar la plata: el recaudo no entra a la caja de nadie" id="id-19fab029df085a79b7b7dc3164ee174a">
        <documentation>«Regla de oro» con dinero público de pasajeros [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.6 (l. 90-98)"/>
        <property key="Nombre técnico" value="Separación de dineros: el recaudo no se mezcla con la caja de nadie"/>
      </element>
      <element xsi:type="archimate:Principle" name="Cada peso tiene dueño y deja rastro" id="id-5966fd1f1cdd5a31b50699ad08c3293a">
        <documentation>«Regla de oro» con dinero público de pasajeros [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.6 (l. 90-98)"/>
        <property key="Nombre técnico" value="Todo peso tiene dueño y rastro"/>
      </element>
      <element xsi:type="archimate:Principle" name="Doble revisión: lo que dicen las validaciones se compara con el banco" id="id-a45b0fdfe9195a518d555fa871bc2b86">
        <documentation>«Regla de oro» con dinero público de pasajeros [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.6 (l. 90-98)"/>
        <property key="Nombre técnico" value="Doble verificación: lo que dice la validación se contrasta con el banco"/>
      </element>
      <element xsi:type="archimate:Principle" name="Cierres diarios y cortes claros" id="id-80e0a8c33bcc576a99ee0e06e3c0cf24">
        <documentation>«Regla de oro» con dinero público de pasajeros [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.6 (l. 90-98)"/>
      </element>
      <element xsi:type="archimate:Principle" name="Quien opera, quien liquida y quien audita son personas distintas" id="id-b5680912ca41568c859b52c0b927030d">
        <documentation>«Regla de oro» con dinero público de pasajeros [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.6 (l. 90-98)"/>
        <property key="Nombre técnico" value="Segregación de funciones: quien opera, quien liquida y quien audita son distintos"/>
      </element>
      <element xsi:type="archimate:Principle" name="El saldo del usuario no es ganancia: es plata ajena" id="id-ba107a466f365c2295b0b43fd325856e">
        <documentation>«Regla de oro» con dinero público de pasajeros [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.6 (l. 90-98)"/>
        <property key="Nombre técnico" value="El saldo del usuario no es un ingreso: es dinero ajeno"/>
      </element>
      <element xsi:type="archimate:Principle" name="Nada se cuenta dos veces ni se pierde; cada corrección deja rastro" id="id-10941d4d77205c5e9b271d129306c01e">
        <documentation>«Regla de oro» con dinero público de pasajeros [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.6 (l. 90-98)"/>
        <property key="Nombre técnico" value="Nada se cuenta dos veces ni se pierde; toda corrección deja huella"/>
      </element>
      <element xsi:type="archimate:Principle" name="Cuentas claras ante la autoridad y los operadores" id="id-95a5a363656a57e19c932c2ff9978cc4">
        <documentation>«Regla de oro» con dinero público de pasajeros [Práctica].</documentation>
        <property key="Fuente" value="Entrevista B1.6 (l. 90-98)"/>
        <property key="Nombre técnico" value="Transparencia hacia la autoridad y los operadores"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Recaudar en los tres modos con VAMOS y con tarjetas débito y crédito" id="id-6364f857fddf5beeba44345c1180dab6">
        <documentation>Alcance literal del Tema 4.</documentation>
        <property key="Fuente" value="T4"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Gestionar la tarjeta VAMOS: emisión, recargas, consulta de saldo y bloqueo por pérdida" id="id-ca11ad822ab6573db32566d916e0119a">
        <documentation>Alcance literal del Tema 4.</documentation>
        <property key="Fuente" value="T4"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Gestionar la tarifa plena y las tarifas especiales para estudiantes de colegio, universitarios, adultos mayores y personas con movilidad reducida, validando que el usuario cumple las condiciones de su perfil" id="id-5ac6b0a263ef54baba36839e5839b215">
        <documentation>Alcance literal del Tema 4.</documentation>
        <property key="Fuente" value="T4"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Aplicar la tarifa correcta en cada validación, considerando la integración entre modos" id="id-dc8f1c3f82b158d39c5558ebe77520fb">
