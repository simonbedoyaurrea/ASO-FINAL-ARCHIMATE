      <element xsi:type="archimate:Capability" name="Venta y personalización de la tarjeta VAMOS" id="id-8c699e16b3995d9a8bd59261da48ca29">
        <documentation>Registra la tarjeta, su tipo (anónima o personalizada) y su titular.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Misional"/>
        <property key="Impacto" value="Alto: dentro de la aplicación"/>
