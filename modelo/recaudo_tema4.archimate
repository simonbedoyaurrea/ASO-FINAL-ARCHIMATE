      </element>
      <element xsi:type="archimate:Capability" name="Definir tarifas y subsidios" id="id-3fa75df82843539cb82ee8255e688113">
        <documentation>La autoridad decide y el ente gestor sustenta la tarifa técnica; la aplicación recibe el acto vigente y entrega la demanda real.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Estratégica"/>
        <property key="Impacto" value="Medio: intercambia información con la aplicación"/>
        <property key="Fuente" value="Entrevista B4.4 (l. 319-324); Entrevista B5.1 (l. 366-371); Entrevista B2.4 (l. 144-149)"/>
        <property key="Nombre técnico" value="Estructuración tarifaria y subsidios"/>
      </element>
      <element xsi:type="archimate:Capability" name="Planear el servicio y las rutas" id="id-427ed7088b41574cb1b0f8d42a0191cd">
        <documentation>Entrega rutas, estaciones y asignación ruta-operador; recibe la demanda por ruta y franja.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Estratégica"/>
        <property key="Impacto" value="Medio: intercambia información con la aplicación"/>
        <property key="Fuente" value="Entrevista B9.6 (l. 779-783)"/>
        <property key="Nombre técnico" value="Planeación de la oferta y de las rutas"/>
      </element>
      <element xsi:type="archimate:Capability" name="Manejar riesgos y continuidad del servicio" id="id-15fd3bd534355d8cb020934188c36418">
        <documentation>Define cómo operar sin conexión y reprocesar; la aplicación lo implementa en la recepción de transacciones.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Estratégica"/>
        <property key="Impacto" value="Medio: intercambia información con la aplicación"/>
        <property key="Fuente" value="Entrevista B9.13 (l. 841-852)"/>
        <property key="Nombre técnico" value="Gestión de riesgos y continuidad"/>
      </element>
      <element xsi:type="archimate:Capability" name="Relación con otras entidades" id="id-fed92050bfc75bf3b41004a19906ec57">
        <documentation>Capacidad de nivel 1 (estratégica).</documentation>
        <property key="Nivel" value="1"/>
        <property key="Tipo" value="Estratégica"/>
        <property key="Nombre técnico" value="Relacionamiento institucional"/>
      </element>
      <element xsi:type="archimate:Capability" name="Relación con la autoridad de transporte" id="id-29318c43fb0958a5adcd53fb230f19e6">
        <documentation>Recibe reportes de demanda e ingresos; entrega el acto tarifario.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Estratégica"/>
        <property key="Impacto" value="Medio: intercambia información con la aplicación"/>
        <property key="Fuente" value="Entrevista B2.4 (l. 144-149); Entrevista B9.10 (l. 808-816)"/>
      </element>
      <element xsi:type="archimate:Capability" name="Relación con los operadores de transporte" id="id-a5f2ad8af3b25754beea43908520edcf">
        <documentation>Reciben la demanda atribuida por ruta y día, sin datos personales.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Estratégica"/>
        <property key="Impacto" value="Medio: intercambia información con la aplicación"/>
        <property key="Fuente" value="Entrevista B9.4 (l. 763-766)"/>
      </element>
      <element xsi:type="archimate:Capability" name="Relación con bancos y comercios aliados" id="id-91a23d65fac25646aafbd9203f235348">
        <documentation>Bancos, adquirentes y comercios intercambian recargas, cobros y abonos.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Estratégica"/>
        <property key="Impacto" value="Medio: intercambia información con la aplicación"/>
