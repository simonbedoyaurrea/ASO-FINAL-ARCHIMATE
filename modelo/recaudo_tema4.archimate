        <property key="Rol en el agregado" value="Raíz"/>
        <property key="Invariante 1" value="Quien propone un ajuste no lo aprueba."/>
        <property key="Invariante 2" value="Un monto sobre el tope del rol exige aprobación superior [topes configurables]."/>
        <property key="Invariante 3" value="Todo ajuste referencia una transacción o una evidencia."/>
        <property key="Invariante 4" value="Un ajuste se aplica una sola vez."/>
        <property key="Invariante 5" value="La devolución en dinero no se ejecuta aquí: la paga tesorería o la fiducia."/>
      </element>
      <element xsi:type="archimate:DataObject" name="Causa" id="id-78cf21ba9fbc5ca4a6c79a09b39c7831">
