      <element xsi:type="archimate:Capability" name="Bloqueo por pérdida y reposición" id="id-09e06cf3e1a7564093335b0507dff87a">
        <documentation>Bloquea a solicitud del titular, publica la lista de bloqueo y traslada el saldo a la reposición.</documentation>
        <property key="Nivel" value="2" />
        <property key="Tipo" value="Misional" />
        <property key="Impacto" value="Alto: dentro de la aplicación" />
        <property key="Fuente" value="T4; Entrevista B6.2 (l. 458-464)" />
