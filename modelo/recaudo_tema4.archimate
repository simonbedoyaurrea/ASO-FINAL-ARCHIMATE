        <property key="Contexto" value="Tarjeta (equipo)" />
        <property key="Fuente" value="Entrevista B3.4 (l. 229-238); Entrevista B6.4 (l. 475-482); Entrevista B9.5 (l. 767-778)" />
        <property key="Nombre técnico" value="[Tarjeta (equipo)] Saldo escrito en el chip, el que realmente se descuenta." />
      </element>
      <element xsi:type="archimate:Meaning" name="[Contabilidad (externo)] Pasivo: plata ajena que no es ingreso hasta que se usa." id="id-725470599dfd50beae6a5727b3db9bf9">
        <documentation>Significado de «Saldo» en Contabilidad (externo).</documentation>
        <property key="Término" value="Saldo" />
        <property key="Contexto" value="Contabilidad (externo)" />
        <property key="Fuente" value="Entrevista B3.4 (l. 229-238); Entrevista B6.4 (l. 475-482); Entrevista B9.5 (l. 767-778)" />
        <property key="Nombre técnico" value="[Contabilidad (externo)] Pasivo: dinero ajeno que no es ingreso hasta que se usa." />
      </element>
      <element xsi:type="archimate:Meaning" name="[Contexto Tarifas] Tarifa correcta según la versión, el perfil y el transbordo." id="id-20c9e38e30d657a29262a94332670f07">
        <documentation>Significado de «Tarifa» en BC-TAR.</documentation>
        <property key="Término" value="Tarifa" />
        <property key="Contexto" value="BC-TAR" />
        <property key="Fuente" value="Entrevista B2.4 (l. 144-149); Entrevista B5.1 (l. 366-371); D-05" />
        <property key="Nombre técnico" value="[Contexto TAR] Tarifa correcta según versión, perfil e integración." />
      </element>
      <element xsi:type="archimate:Meaning" name="[Contexto Recepción] Tarifa que descontó el equipo en el momento." id="id-1c0b53686ef55043993b6c149bca5a1b">
        <documentation>Significado de «Tarifa» en BC-TRX.</documentation>
        <property key="Término" value="Tarifa" />
        <property key="Contexto" value="BC-TRX" />
        <property key="Fuente" value="Entrevista B2.4 (l. 144-149); Entrevista B5.1 (l. 366-371); D-05" />
        <property key="Nombre técnico" value="[Contexto TRX] Tarifa aplicada por el equipo en el momento." />
      </element>
      <element xsi:type="archimate:Meaning" name="[Autoridad y ente gestor] Tarifa técnica (lo que cuesta cada pasajero) frente a la tarifa al usuario (la que se cobra)." id="id-92ac657f52785827b0e306f9ae25966e">
        <documentation>Significado de «Tarifa» en Autoridad y ente gestor.</documentation>
        <property key="Término" value="Tarifa" />
        <property key="Contexto" value="Autoridad y ente gestor" />
        <property key="Fuente" value="Entrevista B2.4 (l. 144-149); Entrevista B5.1 (l. 366-371); D-05" />
        <property key="Nombre técnico" value="[Autoridad y ente gestor] Tarifa técnica (costo por pasajero) frente a tarifa al usuario (la que se cobra)." />
      </element>
      <element xsi:type="archimate:Meaning" name="[Experto] Cuatro momentos: plata capturada, recaudada (en la fiducia), ganada por el viaje y lista para repartir." id="id-91ecc9f2cf1252acb7e60b3c0f96b419">
        <documentation>Significado de «Recaudado» en Experto.</documentation>
        <property key="Término" value="Recaudado" />
        <property key="Contexto" value="Experto" />
        <property key="Fuente" value="Entrevista B3.4 (l. 229-238)" />
        <property key="Nombre técnico" value="[Experto] Cuatro momentos: dinero capturado, recaudado (en la fiducia), ingreso por el viaje y distribuible." />
      </element>
      <element xsi:type="archimate:Meaning" name="[Contexto Consolidación] Valor de las validaciones y cobros consolidados del día de servicio." id="id-c914d8ee991a5d099d844a639a772ea3">
