      </element>
      <element xsi:type="archimate:Meaning" name="[Uso general del experto] «Operador» en sentido amplio: ente gestor, empresa de buses, concesionario o fiduciaria." id="id-34c9dc2773ad59c180ce27b6d325264c">
        <documentation>Significado de «Operador» en Uso general del experto.</documentation>
        <property key="Término" value="Operador"/>
        <property key="Contexto" value="Uso general del experto"/>
        <property key="Fuente" value="Entrevista B2.1 (l. 119-128); Entrevista B10.P (l. 878-885); Entrevista B10.1 (l. 886-895)"/>
        <property key="Nombre técnico" value="[Uso general del experto] «Operador» en sentido amplio: ente gestor, operador de buses, concesionario o fiduciaria."/>
      </element>
