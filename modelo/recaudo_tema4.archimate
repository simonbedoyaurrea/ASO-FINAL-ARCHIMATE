      <element xsi:type="archimate:DataObject" name="Viajes por cobrar a la tarjeta" id="id-3976828127a6533794c1ebab9d41f481">
        <documentation>Entidad raíz del agregado: único punto de acceso y responsable de sus invariantes (9_DDD diap. 20).</documentation>
        <property key="Rol en el agregado" value="Raíz"/>
        <property key="Invariante 1" value="Cada viaje con su tarifa calculada entra en un solo cargo: ningún viaje se cobra dos veces ni queda sin cobrar."/>
        <property key="Invariante 2" value="Se genera un cargo al cierre del día de servicio, o antes si lo acumulado sin cobrar supera el umbral [configurable]; los cargos del día no superan el máximo configurado [1 = solo al cierre]."/>
        <property key="Invariante 3" value="La suma de los cargos del día no supera el tope diario si está configurado [desactivado por defecto; es un supuesto]."/>
        <property key="Invariante 4" value="Un abordaje que llega después de un cargo se tarifa con la integración de su viaje: el cargo siguiente solo cobra la diferencia."/>
        <property key="Invariante 5" value="Los reintentos no superan el máximo configurado."/>
        <property key="Invariante 6" value="Mientras haya deuda abierta, el token debe estar en la lista de bloqueo."/>
        <property key="Invariante 7" value="Nunca se guarda el número completo de la tarjeta: solo el token."/>
        <property key="Nombre técnico" value="Cuenta de viajes bancaria"/>
      </element>
