          <child xsi:type="archimate:DiagramObject" id="id-ce34bf6526d25bf78e77728802f2fa85" targetConnections="id-456a2c0e84915f8285f7d697fe41328c" font="1|Arial|10.0|0|COCOA|1|ArialMT" textPosition="1" archimateElement="id-e982b2437a52572da2098a7ad5e7a542">
