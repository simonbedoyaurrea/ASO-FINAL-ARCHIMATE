          <child xsi:type="archimate:DiagramObject" id="id-b955fecbf726558cb74cd7e6322bd052" targetConnections="id-72cb5b0359c85fc593d63e7f4ddc46da" font="1|Arial|9.0|0|COCOA|1|ArialMT" fillColor="#f3e5f5" archimateElement="id-172e6df85761591eb4de0d0d72dc3003">
