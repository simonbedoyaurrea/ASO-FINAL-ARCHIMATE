  <folder name="Strategy" id="id-f995268d4f8c5f0f9d8cd38fc895e0fb" type="strategy">
    <folder name="Fase 1 · Motivación, capacidades y E2E" id="id-995438d71d83525384bbd76a7d4a20f6">
      <element xsi:type="archimate:Capability" name="Dirección y planeación" id="id-5d14c926738857acaf471661781ee0af">
        <documentation>Capacidad de nivel 1 (estratégica).</documentation>
        <property key="Nivel" value="1"/>
        <property key="Tipo" value="Estratégica"/>
      </element>
      <element xsi:type="archimate:Capability" name="Definir el rumbo de la entidad" id="id-479836186e785d8a98db090a232bbeef">
        <documentation>Recibe los indicadores que salen del recaudo consolidado.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Tipo" value="Estratégica"/>
        <property key="Impacto" value="Medio: intercambia información con la aplicación"/>
