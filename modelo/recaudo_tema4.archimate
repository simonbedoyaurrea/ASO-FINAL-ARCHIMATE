      <element xsi:type="archimate:Representation" name="Transacción tardía" id="id-bcca105e077656a4928a2adefcb6b7c1">
        <documentation>Término del lenguaje ubicuo. Ejemplo: Bus que transmite al llegar a patio.</documentation>
