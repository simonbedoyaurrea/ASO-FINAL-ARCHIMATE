        <documentation>Término del lenguaje ubicuo. Ejemplo: Consulta en la app: «saldo a las 18:40 de ayer».</documentation>
        <property key="Contexto" value="BC-MED"/>
        <property key="Fuente" value="Entrevista B6.4 (l. 475-482); D-09"/>
