      <element xsi:type="archimate:Capability" name="Manejo de la lista de tarifas" id="id-ab877ab62a7a5c49b0826beaf695bfb2">
        <documentation>Registra cada versión tarifaria según el acto de la autoridad y la publica a los equipos.</documentation>
        <property key="Nivel" value="2" />
        <property key="Tipo" value="Misional" />
        <property key="Impacto" value="Alto: dentro de la aplicación" />
