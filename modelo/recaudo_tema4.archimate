        <property key="Nombre técnico" value="Corrección autorizada de un saldo o de una transacción que deja huella."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Recorrido de un modo, con el operador que tiene asignado en cada periodo." id="id-12f3edbf9f28512ca911fff17a87b384">
