        <property key="Fuente" value="T4"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Consolidar el recaudo por modo, ruta y operador como base para la distribución y la conciliación" id="id-00d315235aa157aca4bbe201615e7282">
        <documentation>Alcance literal del Tema 4.</documentation>
        <property key="Fuente" value="T4"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Registrar cada transacción una sola vez y en el día de servicio en que pasó" id="id-802d616e654357b1a53b50a747d0314f">
