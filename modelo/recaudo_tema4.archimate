      <element xsi:type="archimate:AggregationRelationship" id="id-6fa2124d85f35753b08ca6d5e06916f2" source="id-c9ec09251f7e5b1fa8b945fb21dc1132" target="id-e6873073d1a256c19fd6fb2ea3a4efdf"/>
