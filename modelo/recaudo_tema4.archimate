      </element>
      <element xsi:type="archimate:Grouping" name="Clasificación estratégica" id="id-6ac3a537cb8b59ac872f70faf5d85f92">
        <documentation>Sección «Clasificación estratégica» del Bounded Context Canvas (9_DDD diap. 34-35).</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Roles del dominio" id="id-d5f1e2c7deb4503a83595f93772594f6">
