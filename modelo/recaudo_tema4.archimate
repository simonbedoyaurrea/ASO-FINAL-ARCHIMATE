        <property key="Nombre técnico" value="[Contexto CON] Base consolidada: consumo de días cerrados por modo, ruta y operador; la entrega la aplicación." />
      </element>
      <element xsi:type="archimate:Meaning" name="[Conciliación (externo)] Base conciliada: la consolidada ya comparada con la plata recibida; es la que se liquida y se reparte." id="id-247cc532605a595599cdc609ad8cce72">
