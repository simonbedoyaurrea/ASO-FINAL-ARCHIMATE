        <property key="Nombre técnico" value="Proveedor de notificaciones"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Área de control de fraude" id="id-f6fdbfb1b31f51dcafaf1a9302b628b4">
        <documentation>Detecta patrones y propone bloqueos o revocaciones.</documentation>
        <property key="Fuente" value="Entrevista B4.2 (l. 300-310); Entrevista B6.5 (l. 483-496)"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Venta y recarga de tarjetas" id="id-958ba65807f8586ea4fa55b70c7030f3">
        <documentation>Emisión y recargas de VAMOS están en el alcance (REQ02).</documentation>
        <property key="Capa" value="1. Plataforma"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B3.2 (l. 211-216)"/>
        <property key="Nombre técnico" value="Venta y recarga de medios de pago"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Manejo de tarjetas y perfiles" id="id-686c94d5a2fd5a5ba0918ba33eaf1674">
        <documentation>Personalización, perfiles especiales con verificación de condiciones y bloqueo por pérdida (REQ02, REQ03).</documentation>
        <property key="Capa" value="1. Plataforma"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B5.2 (l. 372-380); Entrevista B6.2 (l. 458-464)"/>
        <property key="Nombre técnico" value="Gestión de medios de pago y perfiles"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Cálculo de tarifas y registro de viajes" id="id-4034535d235b529ea5a1bcd903a70ca0">
        <documentation>«Aplicación de la tarifa correcta en cada validación, considerando la integración entre modos» (REQ04) y recaudo en los tres modos (REQ01). Publica los parámetros que usan los equipos y tarifica cada transacción recibida (D-05).</documentation>
        <property key="Capa" value="1. Plataforma"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B3.1 (l. 198-210); Entrevista B4.4 (l. 319-324)"/>
        <property key="Nombre técnico" value="Tarificación y registro de viajes"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Cobro de viajes con tarjeta del banco" id="id-93aae68ee108544e99eb0fe5cf5dd415">
        <documentation>Las tarjetas débito y crédito son medio de pago del alcance (REQ01). Se adopta el cobro agrupado que describió el experto (D-11).</documentation>
        <property key="Capa" value="1. Plataforma"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B3.3 (l. 217-228); Entrevista B5.8 (l. 418-427)"/>
        <property key="Nombre técnico" value="Cobro de viajes con tarjeta bancaria"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Consolidación del recaudo" id="id-26da11aac0355ad5b61adcd16603e17c">
        <documentation>«Consolidación del recaudo por modo, ruta y operador, como base para la distribución de ingresos y la conciliación» (REQ05). Entrega la base sin ejecutar la distribución ni la conciliación (D-04).</documentation>
        <property key="Capa" value="1. Plataforma"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B3.1 (l. 198-210); Entrevista B3.5 (l. 240-251)"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Liquidación, cuadre y pago a operadores" id="id-27ad4aa65056563686f235ef04f82654">
        <documentation>EXCLUIDO (D-04): el Tema 4 pide la consolidación «como base para» la distribución y la conciliación, no su ejecución. La conciliación y la liquidación las hacen analistas del ente gestor con fórmulas contractuales y el pago lo ejecuta la fiduciaria. Se integra por SA08.</documentation>
        <property key="Capa" value="1. Plataforma"/>
        <property key="Decisión" value="Excluido"/>
        <property key="Fuente" value="T4; Entrevista B3.1 (l. 198-210); Entrevista B3.5 (l. 240-251); Entrevista B4.2 (l. 300-310)"/>
        <property key="Nombre técnico" value="Liquidación, conciliación y pago a operadores"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Reclamos y ajustes de saldo" id="id-0a3da3281ece5f5a8d24adb264a8b438">
        <documentation>Servicio al cliente es una interoperabilidad del Tema 4. La aplicación es dueña de saldos y transacciones: expone el historial y aplica ajustes autorizados (D-07). La gestión de PQRS queda fuera.</documentation>
        <property key="Capa" value="1. Plataforma"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B6.3 (l. 465-474); Entrevista B6.7 (l. 503-515); Entrevista B9.7 (l. 784-788)"/>
        <property key="Nombre técnico" value="Soporte a reclamos y ajustes del medio de pago"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Contabilidad y reportes" id="id-a849704e3092560386414957d2736a16">
        <documentation>EXCLUIDO: el registro contable es la interoperabilidad «financiero» del Tema 4. La aplicación entrega la información por SA07 y SA10 (D-08).</documentation>
        <property key="Capa" value="1. Plataforma"/>
        <property key="Decisión" value="Excluido"/>
        <property key="Fuente" value="T4; Entrevista B9.5 (l. 767-778); Entrevista B9.10 (l. 808-816)"/>
        <property key="Nombre técnico" value="Contabilidad y reportes institucionales"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Manejo de tarjetas VAMOS" id="id-2a5e79e13d2b5cfd8e6e57f0b2bc15d3">
        <documentation>Emisión, personalización y bloqueo por pérdida (REQ02).</documentation>
        <property key="Capa" value="2. Dominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B3.2 (l. 211-216); Entrevista B6.2 (l. 458-464)"/>
        <property key="Nombre técnico" value="Gestión de tarjetas VAMOS"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Manejo de perfiles con descuento" id="id-f3298f7c15e45d6f818d698f67960020">
        <documentation>Tarifas especiales con «validación de que el usuario cumple las condiciones de su perfil» (REQ03).</documentation>
        <property key="Capa" value="2. Dominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B5.2 (l. 372-380); Entrevista B5.3 (l. 381-387); Entrevista B9.9 (l. 799-807)"/>
        <property key="Nombre técnico" value="Gestión de perfiles especiales"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Manejo de tarifas y reglas de transbordo" id="id-b2b27c3392cc55c293026d2a698b6ca6">
        <documentation>Tarifa plena, especiales (REQ03) y reglas de transbordo (REQ04). La tarifa la fija la autoridad; el ente gestor la registra y verifica (D-05).</documentation>
        <property key="Capa" value="2. Dominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B4.4 (l. 319-324); Entrevista B5.1 (l. 366-371); Entrevista B5.4 (l. 388-394)"/>
        <property key="Nombre técnico" value="Gestión de tarifas y reglas de integración"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Manejo de saldos y recargas" id="id-efc506a86a0a5b6fafd8595a103f11a3">
        <documentation>Recargas y consulta de saldo (REQ02).</documentation>
        <property key="Capa" value="2. Dominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B3.2 (l. 211-216); Entrevista B5.6 (l. 400-406)"/>
        <property key="Nombre técnico" value="Gestión de saldos y recargas"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Manejo de transacciones de viaje" id="id-99f79594555252caa562d01050316e2a">
        <documentation>Recibe las transacciones de los equipos («el software recibe las transacciones», T4) y tarifica cada validación (REQ04).</documentation>
        <property key="Capa" value="2. Dominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B6.4 (l. 475-482); Entrevista B9.11 (l. 817-829)"/>
        <property key="Nombre técnico" value="Gestión de transacciones de viaje"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Manejo del pago con tarjeta del banco" id="id-e173599cd3d55c539713e5756bd3193b">
        <documentation>Tarjetas débito y crédito para visitantes (REQ01). Incluye rechazos y deuda porque bloquean el acceso.</documentation>
        <property key="Capa" value="2. Dominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B3.3 (l. 217-228); Entrevista B5.8 (l. 418-427)"/>
        <property key="Nombre técnico" value="Gestión de pago abierto"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Manejo de la consolidación del recaudo" id="id-fccd05dd40e853409f4eda19fe88415d">
        <documentation>Consolidación por modo, ruta y operador (REQ05).</documentation>
        <property key="Capa" value="2. Dominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B3.1 (l. 198-210); Entrevista B3.5 (l. 240-251)"/>
        <property key="Nombre técnico" value="Gestión de la consolidación del recaudo"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Apoyo a la atención de reclamos" id="id-10e65b7bd01854b9972189db5913bc6b">
        <documentation>La aplicación es la fuente del historial y la que aplica ajustes al saldo; servicio al cliente decide (D-07).</documentation>
        <property key="Capa" value="2. Dominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B4.3 (l. 311-318); Entrevista B6.3 (l. 465-474); Entrevista B9.7 (l. 784-788)"/>
        <property key="Nombre técnico" value="Soporte a la atención de reclamos"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Liquidación a operadores" id="id-9f95899cb07c5fad8e2b0c8e94e702c5">
        <documentation>EXCLUIDO (D-04): las fórmulas contractuales y la prelación las aplica el ente gestor fuera del alcance del Tema 4.</documentation>
        <property key="Capa" value="2. Dominio"/>
        <property key="Decisión" value="Excluido"/>
        <property key="Fuente" value="T4; Entrevista B3.1 (l. 198-210); Entrevista B5.7 (l. 407-417)"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Cuadre del dinero" id="id-2508425a226a5cec95e7c7e575a07d7a">
        <documentation>EXCLUIDO (D-04): la consolidación es la «base para» la conciliación; concilian analistas, fiduciaria y red de recarga.</documentation>
        <property key="Capa" value="2. Dominio"/>
        <property key="Decisión" value="Excluido"/>
        <property key="Fuente" value="T4; Entrevista B3.1 (l. 198-210)"/>
        <property key="Nombre técnico" value="Conciliación del dinero"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Pago a cada uno y cuenta de la fiduciaria" id="id-9c2beb888ce855f18ce4634cfc4b9463">
        <documentation>EXCLUIDO: la fiduciaria custodia y paga por instrucción; no es recaudo del viaje.</documentation>
        <property key="Capa" value="2. Dominio"/>
        <property key="Decisión" value="Excluido"/>
        <property key="Fuente" value="Entrevista B2.7 (l. 168-177); Entrevista B3.1 (l. 198-210)"/>
        <property key="Nombre técnico" value="Dispersión de pagos y patrimonio autónomo"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Manejo de PQRS (recibir, plazos y respuesta)" id="id-1b58f862730b5e31abc1b52c345ade90">
        <documentation>EXCLUIDO: el Tema 4 la lista como interoperabilidad («experiencia y servicio al cliente»). Se integra por SA06.</documentation>
        <property key="Capa" value="2. Dominio"/>
        <property key="Decisión" value="Excluido"/>
        <property key="Fuente" value="T4; Entrevista B6.7 (l. 503-515)"/>
        <property key="Nombre técnico" value="Gestión de PQRS (radicación, plazos y respuesta)"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Análisis de la demanda y de origen y destino" id="id-e5674187dfa2518dbb4a77e3ac317b2d">
        <documentation>EXCLUIDO: no está en el alcance del Tema 4. Planeación recibe la demanda consolidada por SA09.</documentation>
        <property key="Capa" value="2. Dominio"/>
        <property key="Decisión" value="Excluido"/>
        <property key="Fuente" value="T4; Entrevista B9.6 (l. 779-783)"/>
        <property key="Nombre técnico" value="Analítica de demanda y origen-destino"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Manejo de equipos, conexión y aparatos" id="id-5fdaa14bd029559ca68d2198d6b04165">
        <documentation>EXCLUIDO por el Tema 4: «los validadores, lectores y demás dispositivos, y todo lo relacionado con IoT». Solo se intercambian datos por SA01 y SA15.</documentation>
        <property key="Capa" value="2. Dominio"/>
        <property key="Decisión" value="Excluido"/>
        <property key="Fuente" value="T4"/>
        <property key="Nombre técnico" value="Gestión de equipos, conectividad y dispositivos"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Manejo de efectivo y comisiones a aliados" id="id-1ae2779de5565b7d94daaaaf72da82bf">
        <documentation>EXCLUIDO: custodia del efectivo y comisiones son financieras y de aliados, no recaudo del viaje.</documentation>
        <property key="Capa" value="2. Dominio"/>
        <property key="Decisión" value="Excluido"/>
        <property key="Fuente" value="Entrevista B2.6 (l. 154-166); Entrevista B3.2 (l. 211-216); Entrevista B4.1 (l. 286-299)"/>
        <property key="Nombre técnico" value="Gestión de efectivo y comisiones a aliados"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Control de fraude y mal uso" id="id-10a57a0465f1596ea0512c1caa63b284">
        <documentation>EXCLUIDO: es un área de control que propone bloqueos. La aplicación le entrega datos y recibe sus solicitudes por SA13.</documentation>
        <property key="Capa" value="2. Dominio"/>
        <property key="Decisión" value="Excluido"/>
        <property key="Fuente" value="Entrevista B4.2 (l. 300-310); Entrevista B6.5 (l. 483-496)"/>
        <property key="Nombre técnico" value="Control de fraude y uso indebido"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Emitir tarjeta VAMOS" id="id-747c4fa34b845535a02c8a98f7423be8">
        <documentation>Entrada: Punto de venta, tipo (anónima o personalizada), número físico de la tarjeta. Salida: Tarjeta registrada en estado Activa. Reglas: Una tarjeta física se registra una sola vez. Errores: Tarjeta ya registrada; punto de venta no autorizado.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B3.2 (l. 211-216)"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Personalizar tarjeta (ponerle dueño)" id="id-b0bc188ad0325132bd1b1c4425551839">
        <documentation>Entrada: Número de la tarjeta, identificación del titular, autorización de tratamiento de datos. Salida: Tarjeta personalizada vinculada al titular. Reglas: Solo la tarjeta personalizada permite perfil especial y recuperar el saldo ante pérdida. Errores: Titular sin autorización de datos; tarjeta bloqueada.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B3.2 (l. 211-216); Entrevista B5.2 (l. 372-380); Entrevista B10.3 (l. 903-917)"/>
        <property key="Nombre técnico" value="Personalizar tarjeta (asociar titular)"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Consultar estado e historial de la tarjeta" id="id-ed9ef0a6e41c57878bb242bd7c7e7c16">
        <documentation>Entrada: Número de la tarjeta (y titular si es personalizada). Salida: Estado, perfil vigente, último saldo conocido, recargas, validaciones y transbordos. Reglas: El saldo informado es el último conocido por la aplicación (D-09). Errores: Tarjeta inexistente; consulta no autorizada.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B9.7 (l. 784-788); Entrevista B6.4 (l. 475-482)"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Bloquear tarjeta o medio de pago" id="id-432b7466669c564faf07c8a266a4a86a">
        <documentation>Entrada: Medio (tarjeta VAMOS o token bancario), causa (pérdida, robo, fraude o deuda), solicitante, soporte. Salida: Medio en estado Bloqueado e incluido en la próxima lista de bloqueo. Reglas: Pérdida o robo: a solicitud del titular verificado. Fraude o deuda: por reglas o por el área autorizada; un bloqueo masivo requiere decisión del jefe responsable. Errores: Titular no verificado; medio ya bloqueado.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B4.3 (l. 311-318); Entrevista B6.2 (l. 458-464); Entrevista B5.8 (l. 418-427)"/>
        <property key="Nombre técnico" value="Bloquear medio de pago"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Reponer tarjeta y pasar el saldo" id="id-c071bbd375b05827834a72a118f13c74">
        <documentation>Entrada: Tarjeta personalizada bloqueada por pérdida, nueva tarjeta. Salida: Saldo trasladado = saldo conocido a la hora del bloqueo efectivo (cuando la lista que incluye la tarjeta ya rige en los equipos), calculado cuando cerraron esos días de servicio, sin tardías pendientes (D-28). Reglas: Solo para tarjeta personalizada. Espera la consolidación de las últimas validaciones. Límite de reposiciones por persona y periodo [parámetro sin valor]. Errores: Tarjeta anónima; límite de reposiciones superado.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B5.6 (l. 400-406); Entrevista B6.2 (l. 458-464)"/>
        <property key="Nombre técnico" value="Reponer tarjeta y trasladar saldo"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Armar y publicar la lista de bloqueo" id="id-389d922951945c5295a1ad6f075f617f">
        <documentation>Entrada: Medios bloqueados o desbloqueados desde la última versión. Salida: Versión de la lista de bloqueo para los equipos. Reglas: El desfase entre el bloqueo y su efecto en los equipos es una pérdida aceptada. Errores: Fallo de publicación (se reintenta).</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B5.8 (l. 418-427); Entrevista B9.11 (l. 817-829); Entrevista B9.13 (l. 841-852)"/>
        <property key="Nombre técnico" value="Generar y publicar lista de bloqueo"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Pedir perfil con descuento" id="id-c453328f14225f9fbfd21bf16283b83a">
        <documentation>Entrada: Titular, tarjeta personalizada, tipo de perfil, soportes. Salida: Solicitud radicada en estado En verificación. Reglas: Requiere tarjeta personalizada; los tipos de perfil los decide la autoridad. Errores: Tarjeta anónima; perfil no ofrecido.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B5.2 (l. 372-380)"/>
        <property key="Nombre técnico" value="Solicitar perfil especial"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Revisar requisitos del perfil" id="id-a57022f0b93e50b89f4771422eb5b2e0">
        <documentation>Entrada: Solicitud de perfil, condiciones vigentes del tipo de perfil. Salida: Resultado (cumple o no cumple) con evidencia y fecha de vigencia. Reglas: La evidencia de la certificadora se conserva. Las condiciones exactas las fija la autoridad [sin dato]. Errores: Certificadora sin respuesta: plazo de gracia con la última certificación.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B5.2 (l. 372-380); Entrevista B9.9 (l. 799-807); Entrevista B9.13 (l. 841-852)"/>
        <property key="Nombre técnico" value="Verificar condiciones del perfil"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Activar perfil en la tarjeta" id="id-6d3f43d433495c16b09990a1918a8b0c">
        <documentation>Entrada: Resultado de verificación favorable. Salida: Perfil activo con vigencia, publicado para la tarificación y los equipos. Reglas: Un perfil especial activo por tarjeta [S-06, configurable]. Errores: Verificación vencida.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B5.2 (l. 372-380); Entrevista B5.3 (l. 381-387)"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Vigilar vencimiento y renovar perfil" id="id-e30a68c762765ddabe6a578946565a80">
        <documentation>Entrada: Perfiles próximos a vencer o renovación con nuevo soporte. Salida: Aviso previo; perfil renovado o vencido. Reglas: Al vencer, la tarjeta sigue funcionando con tarifa plena y conserva su saldo. Errores: Soporte de renovación inválido.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B5.3 (l. 381-387)"/>
        <property key="Nombre técnico" value="Controlar vigencia y renovar perfil"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Suspender o quitar perfil" id="id-9bbfa7eb70325599a5f75463a2316bd5">
        <documentation>Entrada: Perfil, causa, decisión de un nivel autorizado. Salida: Perfil suspendido o revocado y notificado al titular. Reglas: Debido proceso: el titular puede explicar y apelar; una alerta no es una prueba. El saldo se conserva. Errores: Decisión sin nivel autorizado.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B5.3 (l. 381-387); Entrevista B6.5 (l. 483-496)"/>
        <property key="Nombre técnico" value="Suspender o revocar perfil"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Registrar versión tarifaria" id="id-44ed4ad341b35f7c96e34ef73930f704">
        <documentation>Entrada: Acto administrativo de la autoridad: tarifa plena, tarifas especiales, fecha y hora de vigencia. Salida: Nueva versión del catálogo tarifario, aprobada con doble control. Reglas: La tarifa la fija la autoridad; el ente gestor verifica que lo registrado coincida con el acto. Los saldos cargados se respetan. Errores: Acto sin soporte; vigencia retroactiva; versión que se solapa.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B4.4 (l. 319-324); Entrevista B5.1 (l. 366-371)"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Definir reglas de transbordo" id="id-066afe4ef71d504fab83ec1b23e44f43">
        <documentation>Entrada: Ventana de tiempo, modos combinables, regla de la misma ruta, número de transbordos y tarifa del transbordo. Salida: Versión de las reglas de integración. Reglas: Valores configurables: la ventana de 60-90 min y que la misma ruta no genere transbordo son supuestos del experto. Errores: Regla incompleta o contradictoria.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B2.2 (l. 130-134); Entrevista B5.4 (l. 388-394)"/>
        <property key="Nombre técnico" value="Definir reglas de integración y transbordo"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Consultar qué tarifa aplica" id="id-9916a0ae448e5b6483a1aa2d257e6f1e">
        <documentation>Entrada: Medio, perfil, modo, fecha y hora, viaje previo (si existe). Salida: Tarifa a cobrar y regla aplicada. Reglas: Tarjeta bancaria: tarifa plena, sin beneficios, con integración (D-10). Errores: Sin versión vigente para la fecha.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B2.5 (l. 150-153); Entrevista B5.1 (l. 366-371); Entrevista B5.4 (l. 388-394)"/>
        <property key="Nombre técnico" value="Consultar tarifa aplicable"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Enviar las tarifas a los equipos" id="id-1c7772bc7b135b329e5ae38a9cf61034">
        <documentation>Entrada: Versión del catálogo, de las reglas y de los perfiles activos. Salida: Paquete de parámetros con fecha y hora de entrada en vigencia. Reglas: Entrada en vigencia simultánea en todos los equipos. Errores: Equipos sin actualizar (lo reporta el proveedor).</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B4.4 (l. 319-324); Entrevista B5.1 (l. 366-371); Entrevista B9.11 (l. 817-829)"/>
        <property key="Nombre técnico" value="Publicar parámetros tarifarios a los equipos"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Registrar recarga" id="id-f26b40a3de2d572bb41c2b7908ef61ab">
        <documentation>Entrada: Tarjeta, monto, canal, punto, fecha y hora, identificador único de la operación. Salida: Recarga registrada (presencial: acreditada; virtual: pendiente de acreditación). Reglas: Monto mínimo y máximo por canal y saldo máximo [parámetros sin valor]. Idempotente por identificador único. Errores: Monto fuera de rango; operación duplicada; tarjeta bloqueada.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B3.2 (l. 211-216); Entrevista B5.6 (l. 400-406)"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Abonar recarga pendiente" id="id-bb272777bdca57618c5ea248e5a79a1c">
        <documentation>Entrada: Recargas virtuales pendientes y confirmación del equipo que las escribió en la tarjeta. Salida: Recarga acreditada en la tarjeta. Reglas: La recarga virtual se acredita cuando la tarjeta pasa por un equipo habilitado (D-09). Errores: Confirmación sin recarga pendiente.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B3.2 (l. 211-216); Entrevista B5.6 (l. 400-406)"/>
        <property key="Nombre técnico" value="Acreditar recarga pendiente"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Consultar saldo" id="id-705c97d7e8945b06805569c7047db2e4">
        <documentation>Entrada: Número de la tarjeta. Salida: Último saldo conocido, recargas pendientes y fecha del dato. Reglas: El saldo se guarda en la tarjeta; la aplicación conoce el último saldo transmitido (D-09). Errores: Tarjeta inexistente.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B6.4 (l. 475-482)"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Aplicar ajuste de saldo aprobado" id="id-e3825bad19ba52738f4b42f913c921ac">
        <documentation>Entrada: Tarjeta, valor (+/−), causa, caso y aprobación. Salida: Ajuste registrado y pendiente de escribir en la tarjeta. Reglas: Solo ajustes aprobados; el ajuste se refleja en la consolidación. Errores: Sin aprobación; supera el tope del nivel.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B4.3 (l. 311-318); Entrevista B6.3 (l. 465-474)"/>
        <property key="Nombre técnico" value="Aplicar ajuste de saldo autorizado"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Recibir y guardar transacciones" id="id-c4ef5e43ef5d5bf7ad847709963c8978">
        <documentation>Entrada: Lote: identificador único de cada transacción, equipo, modo, ruta o estación, medio, perfil, valor descontado, saldo, fecha y hora. Salida: Transacciones registradas y estado de recepción del lote. Reglas: Idempotente por identificador único: las repetidas se descartan. Errores: Lote corrupto; equipo desconocido.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B6.4 (l. 475-482); Entrevista B9.11 (l. 817-829)"/>
        <property key="Nombre técnico" value="Recibir y registrar transacciones de validación"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Calcular la tarifa de cada validación" id="id-4023181101ea5c648ae5baf361b258db">
        <documentation>Entrada: Transacción registrada, versión tarifaria vigente a la hora de la validación, viaje previo. Salida: Tarifa correcta, regla aplicada y diferencia frente a lo descontado por el equipo. Reglas: La aplicación determina la tarifa correcta; el equipo la aplicó con los parámetros publicados (D-05). Las diferencias generan una propuesta de ajuste. Errores: Sin versión tarifaria; hora del equipo inválida.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B6.3 (l. 465-474); Entrevista B6.4 (l. 475-482)"/>
        <property key="Nombre técnico" value="Tarificar validación"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Unir los abordajes de un mismo viaje" id="id-d3cbc84a12695ee7bfc4179f6222fca1">
        <documentation>Entrada: Validaciones del mismo medio dentro de la ventana. Salida: Viaje con sus abordajes enlazados (marca de integración). Reglas: Mismo medio en varios abordajes, también con tarjeta bancaria (D-10); la misma ruta no cuenta como transbordo [configurable]. Errores: Reloj del equipo desfasado.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B2.5 (l. 150-153); Entrevista B3.1 (l. 198-210); Entrevista B5.4 (l. 388-394); Entrevista B6.4 (l. 475-482)"/>
        <property key="Nombre técnico" value="Enlazar abordajes de un viaje"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Detectar transacciones repetidas y atrasadas" id="id-f15073adc7905b5387fe292937cb439f">
        <documentation>Entrada: Transacciones recibidas. Salida: Duplicados descartados; tardías marcadas con su día de servicio. Reglas: Las tardías se asignan al día en que ocurrieron; plazo máximo de aceptación [parámetro sin valor]. Errores: Tardía fuera de plazo (pasa a excepción).</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B6.4 (l. 475-482)"/>
        <property key="Nombre técnico" value="Detectar duplicados y transacciones tardías"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Juntar los viajes de cada tarjeta del banco" id="id-ca18b401f9c05525b0867be78eb8f2db">
        <documentation>Entrada: Validaciones con tarjeta bancaria (token). Salida: Viajes acumulados por token y día de servicio. Reglas: Al tocar, el equipo solo verifica que la tarjeta es válida y no está en la lista de bloqueo. No se guarda el número completo. Errores: Token inválido.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B3.3 (l. 217-228); Entrevista B9.8 (l. 789-798)"/>
        <property key="Nombre técnico" value="Acumular viajes por tarjeta bancaria"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Calcular el cobro agrupado (al cierre del día o al pasar el umbral)" id="id-dfca3603a3455995b817e6a0c59525b0">
        <documentation>Entrada: Viajes acumulados por token al cierre del día de servicio o al superar un umbral. Salida: Monto de cada cargo por token: al cierre del día o al superar el umbral, hasta el máximo de cargos del día. Reglas: Aplica transbordo. Tope diario o semanal: práctica común, NO confirmada para la ciudad (configurable, desactivado). Errores: Umbral no definido.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B3.3 (l. 217-228); Entrevista B5.5 (l. 395-399)"/>
        <property key="Nombre técnico" value="Calcular cobro agrupado"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Registrar si el cobro pasó o no" id="id-14a6d479ea9457e4b425bee298a6e61b">
        <documentation>Entrada: Respuesta del adquirente: abono, rechazo o contracargo. Salida: Cobro aprobado, rechazado o partida reabierta. Reglas: Los contracargos pueden llegar semanas después y reabrir la partida. Errores: Respuesta sin cobro asociado.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B3.3 (l. 217-228); Entrevista B5.8 (l. 418-427)"/>
        <property key="Nombre técnico" value="Registrar resultado del cobro"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Registrar la deuda y su pago" id="id-cf3d8e04c0ab5a679ef624cabde15e2e">
        <documentation>Entrada: Cobro rechazado; pago de regularización. Salida: Deuda abierta (medio bloqueado) o saldada (medio desbloqueado). Reglas: Reintentos automáticos limitados; bloqueo mientras la deuda siga abierta. El cobro prejurídico o el castigo son financieros (excluidos). Errores: Pago que no cubre la deuda.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B5.8 (l. 418-427)"/>
        <property key="Nombre técnico" value="Registrar deuda y regularización"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Asignar cada transacción a su día, modo, ruta y operador" id="id-989368f92329509b82b99d8c29209f64">
        <documentation>Entrada: Transacción tarificada. Salida: Transacción atribuida (día de servicio, modo, ruta y operador). Reglas: La asignación a ruta u operador se puede corregir después; no afecta el saldo del usuario. Errores: Ruta sin operador asignado.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B3.1 (l. 198-210); Entrevista B8.4 (l. 654-669)"/>
        <property key="Nombre técnico" value="Atribuir transacción a día de servicio, modo, ruta y operador"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Consolidar recaudo por modo, ruta y operador" id="id-c065f8b7a5ba5f07bd50c279aaf7956e">
        <documentation>Entrada: Transacciones atribuidas, recargas y cobros del día de servicio. Salida: Recaudo consolidado (validaciones, valor e integraciones) por modo, ruta, operador y día. Reglas: Diario, con cierre del día de servicio. Nada se cuenta dos veces. Errores: Día con lotes pendientes (consolidado provisional).</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B3.5 (l. 240-251); Entrevista B1.6 (l. 90-98)"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Generar la base de distribución" id="id-cf46acd5ec2653f0a10f704aedefceb0">
        <documentation>Entrada: Consolidado del periodo cerrado. Salida: Base para la distribución de ingresos y la conciliación, con soportes. Reglas: No aplica fórmulas contractuales (D-04). Errores: Periodo no cerrado.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="T4; Entrevista B3.5 (l. 240-251)"/>
        <property key="Nombre técnico" value="Generar base de distribución y conciliación"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Rehacer el consolidado" id="id-fba37daa2a935425bbb1157fee25f175">
        <documentation>Entrada: Transacciones tardías o ajustes que afectan un día ya consolidado. Salida: Nueva versión del consolidado con trazabilidad del cambio. Reglas: Ajustes retroactivos con huella. Errores: Periodo cerrado definitivamente [regla por definir].</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B1.6 (l. 90-98); Entrevista B3.6 (l. 252-267); Entrevista B6.4 (l. 475-482)"/>
        <property key="Nombre técnico" value="Reprocesar consolidación"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Consultar el historial para un reclamo" id="id-5d7d16d8434a53a8b6a59e7bd57d9aaf">
        <documentation>Entrada: Caso de reclamo con el medio afectado. Salida: Historial de recargas, validaciones, transbordos y cobros con su evidencia. Reglas: Los casos sin transacción registrada requieren evidencia técnica. Errores: Caso sin medio identificado.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B6.7 (l. 503-515); Entrevista B9.7 (l. 784-788)"/>
        <property key="Nombre técnico" value="Consultar historial para reclamo"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Registrar ajuste con doble aprobación" id="id-e7fc12f91eca550eb44402231c73de0e">
        <documentation>Entrada: Propuesta de ajuste (servicio al cliente) y aprobación (nivel superior). Salida: Ajuste aprobado o rechazado con huella. Reglas: Ajustes pequeños dentro del tope del analista; los mayores requieren aprobación; las devoluciones en dinero las paga tesorería o la fiducia. Errores: Quien propone intenta aprobar.</documentation>
        <property key="Capa" value="3. Básico del subdominio"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Fuente" value="Entrevista B4.3 (l. 311-318); Entrevista B9.7 (l. 784-788)"/>
        <property key="Nombre técnico" value="Registrar ajuste con doble control"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Conexión con los equipos del concesionario" id="id-98587c303a405f24bd7fa0aaade550cc">
        <documentation>Interoperabilidad con «Concesionario de recaudo y tecnología» (Dispositivos (vía proveedor)).</documentation>
        <property key="Capa" value="4. Anticorrupción"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Tipo de parte externa" value="Dispositivos (vía proveedor)"/>
        <property key="Fuente" value="T4; Entrevista B8.2 (l. 632-641); Entrevista B9.3 (l. 752-762); Entrevista B9.11 (l. 817-829)"/>
        <property key="Nombre técnico" value="Intercambio con los equipos del concesionario"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Conexión con los equipos del metro" id="id-fdf5f90c84715fcb843b9d6e769f9eb2">
        <documentation>Interoperabilidad con «Empresa del metro» (Dispositivos (vía proveedor)).</documentation>
        <property key="Capa" value="4. Anticorrupción"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Tipo de parte externa" value="Dispositivos (vía proveedor)"/>
        <property key="Fuente" value="T4; Entrevista B2.1 (l. 119-128); Entrevista B8.2 (l. 632-641); Entrevista B8.5 (l. 670-679)"/>
        <property key="Nombre técnico" value="Intercambio con los equipos del metro"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Conexión con los puntos de recarga" id="id-71df64be969457999d316415e3011d37">
        <documentation>Interoperabilidad con «Red de venta y recarga» (Proveedor (aliados y comercios)).</documentation>
        <property key="Capa" value="4. Anticorrupción"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Tipo de parte externa" value="Proveedor (aliados y comercios)"/>
        <property key="Fuente" value="Entrevista B3.2 (l. 211-216); Entrevista B9.3 (l. 752-762)"/>
        <property key="Nombre técnico" value="Intercambio con la red de recarga presencial"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Pasarela de pagos para recargar por internet" id="id-ad68eda3c26f5f35a75fdd22a626b62c">
        <documentation>Interoperabilidad con «Pasarela de pagos (PSE y tarjeta)» (Entidad financiera).</documentation>
        <property key="Capa" value="4. Anticorrupción"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Tipo de parte externa" value="Entidad financiera"/>
        <property key="Fuente" value="Entrevista B3.2 (l. 211-216); Entrevista B8.1 (l. 619-631)"/>
        <property key="Nombre técnico" value="Pasarela de pagos para recarga virtual"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Cobro con el banco adquirente (tarjeta del banco)" id="id-de0b18e2697e5305af15a89289eee31d">
        <documentation>Interoperabilidad con «Adquirente y bancos emisores» (Entidad financiera).</documentation>
        <property key="Capa" value="4. Anticorrupción"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Tipo de parte externa" value="Entidad financiera"/>
        <property key="Fuente" value="Entrevista B3.3 (l. 217-228); Entrevista B5.8 (l. 418-427); Entrevista B9.8 (l. 789-798)"/>
        <property key="Nombre técnico" value="Cobro con el adquirente (pago abierto)"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Verificación con las entidades que certifican perfiles" id="id-1705a46427d55a9f8766b30d15a65735">
        <documentation>Interoperabilidad con «Entidad certificadora de perfiles» (Entidad externa).</documentation>
        <property key="Capa" value="4. Anticorrupción"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Tipo de parte externa" value="Entidad externa"/>
        <property key="Fuente" value="T4; Entrevista B9.9 (l. 799-807)"/>
        <property key="Nombre técnico" value="Verificación con entidades certificadoras de perfiles"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Servicio al cliente (PQRS)" id="id-09672168b96e5d348f80107a35a71e1f">
        <documentation>Interoperabilidad con «Servicio al cliente» (Proceso interno).</documentation>
        <property key="Capa" value="4. Anticorrupción"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Tipo de parte externa" value="Proceso interno"/>
        <property key="Fuente" value="T4; Entrevista B9.7 (l. 784-788)"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Envío a contabilidad" id="id-ac60c534fe4d56f6a3ca78487c8a13a1">
        <documentation>Interoperabilidad con «Área financiera del ente gestor» (Proceso interno).</documentation>
        <property key="Capa" value="4. Anticorrupción"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Tipo de parte externa" value="Proceso interno"/>
        <property key="Fuente" value="T4; Entrevista B3.4 (l. 229-238); Entrevista B9.5 (l. 767-778)"/>
        <property key="Nombre técnico" value="Registro contable del recaudo"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Entrega de la base para liquidar y cuadrar" id="id-f50ff1e01b9058c3affda8674b0fc690">
        <documentation>Interoperabilidad con «Ente gestor: conciliación y liquidación» (Proceso interno).</documentation>
        <property key="Capa" value="4. Anticorrupción"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Tipo de parte externa" value="Proceso interno"/>
        <property key="Fuente" value="T4; Entrevista B3.1 (l. 198-210); Entrevista B8.2 (l. 632-641)"/>
        <property key="Nombre técnico" value="Entrega de la base a liquidación y conciliación"/>
      </element>
      <element xsi:type="archimate:BusinessService" name="Conexión con planeación de rutas" id="id-1820325040865ca19c7683d6c1d233e8">
        <documentation>Interoperabilidad con «Planeación de rutas y operación» (Proceso interno).</documentation>
        <property key="Capa" value="4. Anticorrupción"/>
        <property key="Decisión" value="Incluido"/>
        <property key="Tipo de parte externa" value="Proceso interno"/>
        <property key="Fuente" value="T4; Entrevista B9.6 (l. 779-783)"/>
        <property key="Nombre técnico" value="Intercambio con planeación de rutas y operación"/>
