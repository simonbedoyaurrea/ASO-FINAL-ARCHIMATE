      <element xsi:type="archimate:AssignmentRelationship" id="id-fd95f6bb944155c293a7baa85843efa8" source="id-c7abe6b7430c582bb570181c9c819dbd" target="id-172e6df85761591eb4de0d0d72dc3003" />
      <element xsi:type="archimate:AssignmentRelationship" id="id-dc6b5feb47a85b9eaa7737ed62e2879c" source="id-685a86d79f12562a9e7f546aa18ba5e7" target="id-2d220afa7d0e591aa035fb16849b8868" />
      <element xsi:type="archimate:AssignmentRelationship" id="id-f993f006a00f5c3b825b11827bc0d6f2" source="id-cd6787b01bd75055bc4deba9f5da2e16" target="id-b94433dc794b5cc9b31526818a8712d6" />
      <element xsi:type="archimate:AggregationRelationship" id="id-6fa2124d85f35753b08ca6d5e06916f2" source="id-c9ec09251f7e5b1fa8b945fb21dc1132" target="id-e6873073d1a256c19fd6fb2ea3a4efdf" />
      <element xsi:type="archimate:AggregationRelationship" id="id-df0fd2afff185906848e99a116839b67" source="id-c9ec09251f7e5b1fa8b945fb21dc1132" target="id-b9e85c0cf8b357baa0a80471c3a32b0e" />
      <element xsi:type="archimate:AggregationRelationship" id="id-63377340808458a38835b0c0f557fd41" source="id-c9ec09251f7e5b1fa8b945fb21dc1132" target="id-2e8345a334ff51d59f317e0eb0b5ff5c" />
      <element xsi:type="archimate:AggregationRelationship" id="id-40523cb0a66e5d319aee65c0df11f3f7" source="id-c9ec09251f7e5b1fa8b945fb21dc1132" target="id-cdb42017cf6859f7a2c7ed25dfa0d516" />
      <element xsi:type="archimate:FlowRelationship" id="id-62c7b6469adc5b439517103efc8fb665" source="id-88c37b33bc0d5ff49b14677382db09c2" target="id-fbdd857cfde15f2881d313951803bfef" name="[C/P] Transacción aceptada, en un formato único para todos">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Captura de transacciones. Consumidor (downstream): Contexto Tarificación e integración. TRX garantiza transacciones únicas con su día de servicio; TAR define qué campos necesita y TRX los entrega.</documentation>
        <property key="Patrón" value="Cliente-proveedor" />
        <property key="Responsabilidades" value="TRX garantiza transacciones únicas con su día de servicio; TAR define qué campos necesita y TRX los entrega." />
      </element>
      <element xsi:type="archimate:FlowRelationship" id="id-4fd85b0f297c5e2f97ba6aa67b88c56d" source="id-3103aa5df4c55dd6a2d73e4b826bd5f4" target="id-fbdd857cfde15f2881d313951803bfef" name="[C/P] Perfil activado, vencido o revocado">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Perfiles y beneficios. Consumidor (downstream): Contexto Tarificación e integración. PER es dueño del derecho vigente; TAR solo lo consulta para tarificar y para publicar parámetros.</documentation>
        <property key="Patrón" value="Cliente-proveedor" />
        <property key="Responsabilidades" value="PER es dueño del derecho vigente; TAR solo lo consulta para tarificar y para publicar parámetros." />
      </element>
      <element xsi:type="archimate:FlowRelationship" id="id-89fe86e056b852c49d389c9288ea950e" source="id-4564e1008063577ba3227a09b07e4f58" target="id-fbdd857cfde15f2881d313951803bfef" name="[C/P] Estado y tipo de la tarjeta">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Medios VAMOS y saldos. Consumidor (downstream): Contexto Tarificación e integración. MED es dueño del estado de la tarjeta; TAR no lo modifica.</documentation>
        <property key="Patrón" value="Cliente-proveedor" />
        <property key="Responsabilidades" value="MED es dueño del estado de la tarjeta; TAR no lo modifica." />
      </element>
      <element xsi:type="archimate:FlowRelationship" id="id-fcc71b75c8415e87b0dcbcfb048697fb" source="id-fbdd857cfde15f2881d313951803bfef" target="id-0953ed94b1125f26bf204b6e91f036ae" name="[C/P] Viaje cerrado con su tarifa correcta (tarjeta del banco)">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Tarificación e integración. Consumidor (downstream): Contexto Pago abierto. TAR decide cuánto vale cada viaje; PAB decide cuándo y cómo cobrarlo.</documentation>
        <property key="Patrón" value="Cliente-proveedor" />
        <property key="Responsabilidades" value="TAR decide cuánto vale cada viaje; PAB decide cuándo y cómo cobrarlo." />
      </element>
      <element xsi:type="archimate:FlowRelationship" id="id-ab9c031843b951a7bce25418e737db9f" source="id-fbdd857cfde15f2881d313951803bfef" target="id-61ba9719635454f3801c54958cfc03f1" name="[C/P] Abordaje con su tarifa calculada">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Tarificación e integración. Consumidor (downstream): Contexto Consolidación del recaudo. TAR entrega cada abordaje con su tarifa e integración; CON lo atribuye y lo consolida.</documentation>
        <property key="Patrón" value="Cliente-proveedor" />
        <property key="Responsabilidades" value="TAR entrega cada abordaje con su tarifa e integración; CON lo atribuye y lo consolida." />
      </element>
      <element xsi:type="archimate:FlowRelationship" id="id-e1871404e119540695e22c539299b010" source="id-fbdd857cfde15f2881d313951803bfef" target="id-4564e1008063577ba3227a09b07e4f58" name="[C/P] Transacción con tarifa que mueve el saldo conocido">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Tarificación e integración. Consumidor (downstream): Contexto Medios VAMOS y saldos. MED registra el movimiento de saldo; TAR no toca saldos.</documentation>
        <property key="Patrón" value="Cliente-proveedor" />
        <property key="Responsabilidades" value="MED registra el movimiento de saldo; TAR no toca saldos." />
      </element>
      <element xsi:type="archimate:FlowRelationship" id="id-1d65fe718d925b2a9e8fb7dce6eec9c2" source="id-0953ed94b1125f26bf204b6e91f036ae" target="id-61ba9719635454f3801c54958cfc03f1" name="[C/P] Resultado del cobro agrupado, aparte del consumo">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Pago abierto. Consumidor (downstream): Contexto Consolidación del recaudo. PAB informa cobros aprobados, rechazados y contracargos; CON los incluye en el consolidado.</documentation>
        <property key="Patrón" value="Cliente-proveedor" />
        <property key="Responsabilidades" value="PAB informa cobros aprobados, rechazados y contracargos; CON los incluye en el consolidado." />
      </element>
      <element xsi:type="archimate:FlowRelationship" id="id-ccf7959b000b5c0e92b32c979be8fb40" source="id-0953ed94b1125f26bf204b6e91f036ae" target="id-4564e1008063577ba3227a09b07e4f58" name="[C/P] Deuda pendiente o pagada de una tarjeta del banco">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Pago abierto. Consumidor (downstream): Contexto Medios VAMOS y saldos. MED incluye o retira el token de la lista de bloqueo; PAB es dueño de la deuda.</documentation>
        <property key="Patrón" value="Cliente-proveedor" />
        <property key="Responsabilidades" value="MED incluye o retira el token de la lista de bloqueo; PAB es dueño de la deuda." />
      </element>
      <element xsi:type="archimate:FlowRelationship" id="id-b2452441eb685f9285cb0d43c3e6279c" source="id-4564e1008063577ba3227a09b07e4f58" target="id-61ba9719635454f3801c54958cfc03f1" name="[C/P] Recargas del día, aparte del consumo (dinero ajeno)">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Medios VAMOS y saldos. Consumidor (downstream): Contexto Consolidación del recaudo. MED entrega las recargas; CON las suma al recaudo del día.</documentation>
        <property key="Patrón" value="Cliente-proveedor" />
        <property key="Responsabilidades" value="MED entrega las recargas; CON las suma al recaudo del día." />
      </element>
      <element xsi:type="archimate:FlowRelationship" id="id-b6224e59cbfb58979bd26469052ef5b9" source="id-70f72d69919a582faa63ef9a50bcbcb3" target="id-4564e1008063577ba3227a09b07e4f58" name="[C/P] Ajuste aprobado que mueve el saldo">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Ajustes y soporte a reclamos. Consumidor (downstream): Contexto Medios VAMOS y saldos. AJU garantiza doble control; MED aplica el movimiento y rechaza ajustes sin aprobación.</documentation>
        <property key="Patrón" value="Cliente-proveedor" />
        <property key="Responsabilidades" value="AJU garantiza doble control; MED aplica el movimiento y rechaza ajustes sin aprobación." />
      </element>
      <element xsi:type="archimate:FlowRelationship" id="id-602b46b944e4573cbd570fea3b1b48f2" source="id-70f72d69919a582faa63ef9a50bcbcb3" target="id-61ba9719635454f3801c54958cfc03f1" name="[C/P] Ajuste que rehace un día">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Ajustes y soporte a reclamos. Consumidor (downstream): Contexto Consolidación del recaudo. CON reprocesa con una nueva versión; AJU no modifica consolidados.</documentation>
        <property key="Patrón" value="Cliente-proveedor" />
        <property key="Responsabilidades" value="CON reprocesa con una nueva versión; AJU no modifica consolidados." />
      </element>
      <element xsi:type="archimate:FlowRelationship" id="id-ebe976ff95375478bc12cd0107872920" source="id-fbdd857cfde15f2881d313951803bfef" target="id-70f72d69919a582faa63ef9a50bcbcb3" name="[C/P] Diferencia de tarifa encontrada">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Tarificación e integración. Consumidor (downstream): Contexto Ajustes y soporte a reclamos. TAR detecta; AJU decide si propone un ajuste de oficio.</documentation>
        <property key="Patrón" value="Cliente-proveedor" />
        <property key="Responsabilidades" value="TAR detecta; AJU decide si propone un ajuste de oficio." />
      </element>
      <element xsi:type="archimate:FlowRelationship" id="id-6b01d487b5865334abbd9d7a6a450932" source="id-5c92a98f717a5ace8382f8d16398da33" target="id-61ba9719635454f3801c54958cfc03f1" name="[OHS/PL] Rutas, operadores asignados y calendario">
        <documentation>Servicio abierto + lenguaje publicado. Proveedor (upstream): Contexto Referencia de red. Consumidor (downstream): Contexto Consolidación del recaudo. RED publica un formato estable; los consumidores se adaptan a él (conformistas).</documentation>
        <property key="Patrón" value="Servicio abierto + lenguaje publicado" />
        <property key="Responsabilidades" value="RED publica un formato estable; los consumidores se adaptan a él (conformistas)." />
      </element>
      <element xsi:type="archimate:FlowRelationship" id="id-0923c72cb9bd503eb464cfc182c77759" source="id-5c92a98f717a5ace8382f8d16398da33" target="id-fbdd857cfde15f2881d313951803bfef" name="[OHS/PL] Modos y rutas para las reglas de transbordo">
        <documentation>Servicio abierto + lenguaje publicado. Proveedor (upstream): Contexto Referencia de red. Consumidor (downstream): Contexto Tarificación e integración. Igual que la anterior.</documentation>
        <property key="Patrón" value="Servicio abierto + lenguaje publicado" />
        <property key="Responsabilidades" value="Igual que la anterior." />
      </element>
      <element xsi:type="archimate:FlowRelationship" id="id-0321002e468058fe82985187792c80f3" source="id-5c92a98f717a5ace8382f8d16398da33" target="id-88c37b33bc0d5ff49b14677382db09c2" name="[OHS/PL] Dónde está cada equipo y calendario de días de servicio">
        <documentation>Servicio abierto + lenguaje publicado. Proveedor (upstream): Contexto Referencia de red. Consumidor (downstream): Contexto Captura de transacciones. Igual que la anterior.</documentation>
        <property key="Patrón" value="Servicio abierto + lenguaje publicado" />
        <property key="Responsabilidades" value="Igual que la anterior." />
      </element>
      <element xsi:type="archimate:FlowRelationship" id="id-b605444e1bee5c76ba5e67888418d366" source="id-cd6787b01bd75055bc4deba9f5da2e16" target="id-70f72d69919a582faa63ef9a50bcbcb3" name="[CF] Roles y permisos de los empleados">
        <documentation>Conformista. Proveedor (upstream): Contexto Identidad y acceso. Consumidor (downstream): Contexto Ajustes y soporte a reclamos. Los contextos aceptan el modelo de identidad tal como es (genérico).</documentation>
        <property key="Patrón" value="Conformista" />
        <property key="Responsabilidades" value="Los contextos aceptan el modelo de identidad tal como es (genérico)." />
      </element>
      <element xsi:type="archimate:ServingRelationship" id="id-c9bdfbe44b215a589dece52a2beacd51" source="id-c7abe6b7430c582bb570181c9c819dbd" target="id-0953ed94b1125f26bf204b6e91f036ae" name="[OHS] Envía los avisos de cobro, deuda y bloqueo">
        <documentation>Servicio abierto. Proveedor (upstream): Contexto Notificaciones. Consumidor (downstream): Contexto Pago abierto. NOT ofrece un servicio genérico de envío.</documentation>
        <property key="Patrón" value="Servicio abierto" />
        <property key="Responsabilidades" value="NOT ofrece un servicio genérico de envío." />
      </element>
      <element xsi:type="archimate:ServingRelationship" id="id-d9e6122e82b458c0aa1e8d633587c0bd" source="id-c7abe6b7430c582bb570181c9c819dbd" target="id-3103aa5df4c55dd6a2d73e4b826bd5f4" name="[OHS] Envía los avisos de vencimiento y revocación">
        <documentation>Servicio abierto. Proveedor (upstream): Contexto Notificaciones. Consumidor (downstream): Contexto Perfiles y beneficios. Igual que la anterior.</documentation>
        <property key="Patrón" value="Servicio abierto" />
        <property key="Responsabilidades" value="Igual que la anterior." />
      </element>
