    <folder name="Fase 1 · Motivación, capacidades y E2E" id="id-372a4dcb200450798ba7dec4a3b6b345">
      <element xsi:type="archimate:BusinessRole" name="Pasajero" id="id-edab0ba75990577ba5253e7a9b97163e">
        <documentation>Residente o visitante que viaja.</documentation>
        <property key="Fuente" value="T4; Entrevista B2.5 (l. 150-153)"/>
        <property key="Nombre técnico" value="Usuario"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Puntos de venta y recarga" id="id-e36d28f3dd7a5532a04836766fb2b404">
        <documentation>Taquillas, máquinas, comercios y canal virtual con su pasarela.</documentation>
        <property key="Fuente" value="Entrevista B3.2 (l. 211-216); Entrevista B4.1 (l. 286-299)"/>
        <property key="Nombre técnico" value="Red de venta y recarga"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Proveedor de los validadores" id="id-39a884838b185163a7c88e3b3176e53d">
        <documentation>Rol que cumplen el concesionario y la empresa del metro: operan validadores y torniquetes (fuera del alcance) y transmiten las transacciones.</documentation>
        <property key="Fuente" value="Entrevista B4.1 (l. 286-299); Entrevista B8.2 (l. 632-641); T4"/>
        <property key="Nombre técnico" value="Proveedor de los equipos de validación"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Ente gestor: área de recaudo" id="id-22dffc168f7d53bab628fa1f51ae83ca">
        <documentation>Área de recaudo del ente gestor, que usa la aplicación.</documentation>
        <property key="Fuente" value="Entrevista B2.1 (l. 119-128); D-01"/>
        <property key="Nombre técnico" value="Ente gestor: gestión del recaudo"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Ente gestor: cuadre y liquidación" id="id-76a6f428d2455f1a9e2ddf9057688b66">
        <documentation>Analistas de conciliación y de liquidación.</documentation>
        <property key="Fuente" value="Entrevista B4.2 (l. 300-310); Entrevista B3.1 (l. 198-210)"/>
        <property key="Nombre técnico" value="Ente gestor: conciliación y liquidación"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Fiduciaria" id="id-1c7db553232559e0a1a9e9fd19168040">
        <documentation>Custodia el dinero en el patrimonio autónomo y paga por instrucción del ente gestor.</documentation>
        <property key="Fuente" value="Entrevista B2.7 (l. 168-177); Entrevista B4.1 (l. 286-299)"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Área financiera del ente gestor" id="id-ed5e682ec1685e4a8ba3360ec04e1f8c">
        <documentation>Contabilidad y tesorería; reporta a la autoridad y a los entes de control.</documentation>
        <property key="Fuente" value="Entrevista B9.5 (l. 767-778); Entrevista B9.10 (l. 808-816)"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Servicio al cliente" id="id-eabaa81631c45782a5d180ae22242db6">
        <documentation>Recibe reclamos y trámites del usuario y propone ajustes.</documentation>
        <property key="Fuente" value="Entrevista B4.2 (l. 300-310); Entrevista B9.7 (l. 784-788)"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Entidad que certifica los perfiles" id="id-610798c95e595a16bde5fd653c74190f">
        <documentation>Instituciones educativas y fuentes oficiales que comprueban el derecho.</documentation>
        <property key="Fuente" value="T4; Entrevista B9.9 (l. 799-807)"/>
        <property key="Nombre técnico" value="Entidad certificadora de perfiles"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Autoridad de transporte" id="id-b544cbebad61539f9370a5efdc994650">
        <documentation>Expide el acto tarifario.</documentation>
        <property key="Fuente" value="Entrevista B4.4 (l. 319-324)"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Ente gestor" id="id-0385c980707154e091f3c722157d09b3">
        <documentation>Empresa pública que gerencia el sistema integrado; no conduce buses ni custodia el dinero [Supuesto del experto].</documentation>
        <property key="Fuente" value="Entrevista B2.1 (l. 119-128)"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Concesionario (empresa de recaudo y tecnología)" id="id-6dac63475241530ebb4eda0a1e51dd54">
        <documentation>Provee validadores, emisión de tarjetas, red de recarga y hoy el sistema central (B8.2).</documentation>
        <property key="Fuente" value="Entrevista B2.1 (l. 119-128); Entrevista B8.2 (l. 632-641)"/>
        <property key="Nombre técnico" value="Concesionario de recaudo y tecnología"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Empresa del metro" id="id-2557360c4d095d6180a953ea48d6e28a">
        <documentation>Opera el metro; puede tener equipos propios [Supuesto del experto].</documentation>
        <property key="Fuente" value="Entrevista B2.1 (l. 119-128); Entrevista B8.2 (l. 632-641)"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Una persona necesita viajar" id="id-71518183b450517a875f9d59c399e8a1">
        <documentation>Inicio del E2E.</documentation>
        <property key="Fuente" value="Entrevista B3.1 (l. 198-210)"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Plata repartida y reportada con soporte" id="id-21fdd8624aa35773913ffdeaf9993b06">
        <documentation>Fin del E2E.</documentation>
        <property key="Fuente" value="Entrevista B3.1 (l. 198-210)"/>
        <property key="Nombre técnico" value="Recaudo distribuido y reportado con evidencia"/>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Tarjeta VAMOS" id="id-669007943248551cbad1470d01b0d2c2">
        <documentation>Medio de pago propio, anónimo o personalizado.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Recarga" id="id-37973bf5c8dd537bac7e05b849fc80b9">
        <documentation>Valor cargado a una tarjeta VAMOS por un canal.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Transacción de validación" id="id-321a94460db052eda290576a0abe6100">
        <documentation>Registro que genera el equipo en cada abordaje: equipo, hora, modo, ruta o estación, medio, perfil y valor descontado.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Lote de transacciones" id="id-bab09a3d73d1544aa4e3bdf423f0a40a">
        <documentation>Conjunto de transacciones transmitidas por un equipo.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Viaje con su tarifa calculada" id="id-93b10f6f4f385541b5ba653b9c173923">
        <documentation>Abordajes enlazados por la integración con su tarifa correcta.</documentation>
        <property key="Nombre técnico" value="Viaje tarificado"/>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Cobro agrupado" id="id-25c98d0c40a0501484219d901e41cecb">
        <documentation>Cargo a una tarjeta bancaria por los viajes acumulados: al cierre del día de servicio o al superar el umbral (D-11).</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Recaudo consolidado" id="id-28c26485525a5882a154fad494651a05">
        <documentation>Recaudo por modo, ruta, operador y día de servicio: base de la distribución y la conciliación.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Partidas conciliadas" id="id-11cdaa38f84853e5a72c8473f889c2e9">
        <documentation>Resultado de la conciliación del dinero.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Liquidación por operador" id="id-8ad2e1ce44c7540099d4f898126b49cc">
        <documentation>Valor que corresponde a cada operador según su contrato.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Orden de pago" id="id-2facb1d67c8254afba99eaeb9c0b3925">
        <documentation>Instrucción a la fiduciaria.</documentation>
      </element>
      <element xsi:type="archimate:BusinessObject" name="Informes y registros contables" id="id-29d228a5db8854a785d8925d4ac70ee9">
        <documentation>Registros contables e informes a la autoridad.</documentation>
      </element>
