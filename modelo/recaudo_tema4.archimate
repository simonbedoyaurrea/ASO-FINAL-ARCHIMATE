      <element xsi:type="archimate:AggregationRelationship" id="id-40523cb0a66e5d319aee65c0df11f3f7" source="id-c9ec09251f7e5b1fa8b945fb21dc1132" target="id-cdb42017cf6859f7a2c7ed25dfa0d516"/>
      <element xsi:type="archimate:FlowRelationship" name="[C/P] Transacción aceptada, en un formato único para todos" id="id-62c7b6469adc5b439517103efc8fb665" source="id-88c37b33bc0d5ff49b14677382db09c2" target="id-fbdd857cfde15f2881d313951803bfef">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Captura de transacciones. Consumidor (downstream): Contexto Tarificación e integración. TRX garantiza transacciones únicas con su día de servicio; TAR define qué campos necesita y TRX los entrega.</documentation>
        <property key="Patrón" value="Cliente-proveedor"/>
        <property key="Responsabilidades" value="TRX garantiza transacciones únicas con su día de servicio; TAR define qué campos necesita y TRX los entrega."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="[C/P] Perfil activado, vencido o revocado" id="id-4fd85b0f297c5e2f97ba6aa67b88c56d" source="id-3103aa5df4c55dd6a2d73e4b826bd5f4" target="id-fbdd857cfde15f2881d313951803bfef">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Perfiles y beneficios. Consumidor (downstream): Contexto Tarificación e integración. PER es dueño del derecho vigente; TAR solo lo consulta para tarificar y para publicar parámetros.</documentation>
        <property key="Patrón" value="Cliente-proveedor"/>
        <property key="Responsabilidades" value="PER es dueño del derecho vigente; TAR solo lo consulta para tarificar y para publicar parámetros."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="[C/P] Estado y tipo de la tarjeta" id="id-89fe86e056b852c49d389c9288ea950e" source="id-4564e1008063577ba3227a09b07e4f58" target="id-fbdd857cfde15f2881d313951803bfef">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Medios VAMOS y saldos. Consumidor (downstream): Contexto Tarificación e integración. MED es dueño del estado de la tarjeta; TAR no lo modifica.</documentation>
        <property key="Patrón" value="Cliente-proveedor"/>
        <property key="Responsabilidades" value="MED es dueño del estado de la tarjeta; TAR no lo modifica."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="[C/P] Viaje cerrado con su tarifa correcta (tarjeta del banco)" id="id-fcc71b75c8415e87b0dcbcfb048697fb" source="id-fbdd857cfde15f2881d313951803bfef" target="id-0953ed94b1125f26bf204b6e91f036ae">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Tarificación e integración. Consumidor (downstream): Contexto Pago abierto. TAR decide cuánto vale cada viaje; PAB decide cuándo y cómo cobrarlo.</documentation>
        <property key="Patrón" value="Cliente-proveedor"/>
        <property key="Responsabilidades" value="TAR decide cuánto vale cada viaje; PAB decide cuándo y cómo cobrarlo."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="[C/P] Abordaje con su tarifa calculada" id="id-ab9c031843b951a7bce25418e737db9f" source="id-fbdd857cfde15f2881d313951803bfef" target="id-61ba9719635454f3801c54958cfc03f1">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Tarificación e integración. Consumidor (downstream): Contexto Consolidación del recaudo. TAR entrega cada abordaje con su tarifa e integración; CON lo atribuye y lo consolida.</documentation>
        <property key="Patrón" value="Cliente-proveedor"/>
        <property key="Responsabilidades" value="TAR entrega cada abordaje con su tarifa e integración; CON lo atribuye y lo consolida."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="[C/P] Transacción con tarifa que mueve el saldo conocido" id="id-e1871404e119540695e22c539299b010" source="id-fbdd857cfde15f2881d313951803bfef" target="id-4564e1008063577ba3227a09b07e4f58">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Tarificación e integración. Consumidor (downstream): Contexto Medios VAMOS y saldos. MED registra el movimiento de saldo; TAR no toca saldos.</documentation>
        <property key="Patrón" value="Cliente-proveedor"/>
        <property key="Responsabilidades" value="MED registra el movimiento de saldo; TAR no toca saldos."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="[C/P] Resultado del cobro agrupado, aparte del consumo" id="id-1d65fe718d925b2a9e8fb7dce6eec9c2" source="id-0953ed94b1125f26bf204b6e91f036ae" target="id-61ba9719635454f3801c54958cfc03f1">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Pago abierto. Consumidor (downstream): Contexto Consolidación del recaudo. PAB informa cobros aprobados, rechazados y contracargos; CON los incluye en el consolidado.</documentation>
        <property key="Patrón" value="Cliente-proveedor"/>
        <property key="Responsabilidades" value="PAB informa cobros aprobados, rechazados y contracargos; CON los incluye en el consolidado."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="[C/P] Deuda pendiente o pagada de una tarjeta del banco" id="id-ccf7959b000b5c0e92b32c979be8fb40" source="id-0953ed94b1125f26bf204b6e91f036ae" target="id-4564e1008063577ba3227a09b07e4f58">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Pago abierto. Consumidor (downstream): Contexto Medios VAMOS y saldos. MED incluye o retira el token de la lista de bloqueo; PAB es dueño de la deuda.</documentation>
        <property key="Patrón" value="Cliente-proveedor"/>
        <property key="Responsabilidades" value="MED incluye o retira el token de la lista de bloqueo; PAB es dueño de la deuda."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="[C/P] Recargas del día, aparte del consumo (dinero ajeno)" id="id-b2452441eb685f9285cb0d43c3e6279c" source="id-4564e1008063577ba3227a09b07e4f58" target="id-61ba9719635454f3801c54958cfc03f1">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Medios VAMOS y saldos. Consumidor (downstream): Contexto Consolidación del recaudo. MED entrega las recargas; CON las suma al recaudo del día.</documentation>
        <property key="Patrón" value="Cliente-proveedor"/>
        <property key="Responsabilidades" value="MED entrega las recargas; CON las suma al recaudo del día."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="[C/P] Ajuste aprobado que mueve el saldo" id="id-b6224e59cbfb58979bd26469052ef5b9" source="id-70f72d69919a582faa63ef9a50bcbcb3" target="id-4564e1008063577ba3227a09b07e4f58">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Ajustes y soporte a reclamos. Consumidor (downstream): Contexto Medios VAMOS y saldos. AJU garantiza doble control; MED aplica el movimiento y rechaza ajustes sin aprobación.</documentation>
        <property key="Patrón" value="Cliente-proveedor"/>
        <property key="Responsabilidades" value="AJU garantiza doble control; MED aplica el movimiento y rechaza ajustes sin aprobación."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="[C/P] Ajuste que rehace un día" id="id-602b46b944e4573cbd570fea3b1b48f2" source="id-70f72d69919a582faa63ef9a50bcbcb3" target="id-61ba9719635454f3801c54958cfc03f1">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Ajustes y soporte a reclamos. Consumidor (downstream): Contexto Consolidación del recaudo. CON reprocesa con una nueva versión; AJU no modifica consolidados.</documentation>
        <property key="Patrón" value="Cliente-proveedor"/>
        <property key="Responsabilidades" value="CON reprocesa con una nueva versión; AJU no modifica consolidados."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="[C/P] Diferencia de tarifa encontrada" id="id-ebe976ff95375478bc12cd0107872920" source="id-fbdd857cfde15f2881d313951803bfef" target="id-70f72d69919a582faa63ef9a50bcbcb3">
        <documentation>Cliente-proveedor. Proveedor (upstream): Contexto Tarificación e integración. Consumidor (downstream): Contexto Ajustes y soporte a reclamos. TAR detecta; AJU decide si propone un ajuste de oficio.</documentation>
        <property key="Patrón" value="Cliente-proveedor"/>
        <property key="Responsabilidades" value="TAR detecta; AJU decide si propone un ajuste de oficio."/>
      </element>
      <element xsi:type="archimate:FlowRelationship" name="[OHS/PL] Rutas, operadores asignados y calendario" id="id-6b01d487b5865334abbd9d7a6a450932" source="id-5c92a98f717a5ace8382f8d16398da33" target="id-61ba9719635454f3801c54958cfc03f1">
        <documentation>Servicio abierto + lenguaje publicado. Proveedor (upstream): Contexto Referencia de red. Consumidor (downstream): Contexto Consolidación del recaudo. RED publica un formato estable; los consumidores se adaptan a él (conformistas).</documentation>
        <property key="Patrón" value="Servicio abierto + lenguaje publicado"/>
        <property key="Responsabilidades" value="RED publica un formato estable; los consumidores se adaptan a él (conformistas)."/>
      </element>
