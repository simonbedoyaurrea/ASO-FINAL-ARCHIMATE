      </element>
      <element xsi:type="archimate:Grouping" name="Comunicación entrante" id="id-3d275a3a7110575a903b57df454945dc">
        <documentation>Sección «Comunicación entrante» del Bounded Context Canvas (9_DDD diap. 34-35).</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Lenguaje ubicuo" id="id-5365cb4229c05874be7b9ee5a49d676d">
        <documentation>Sección «Lenguaje ubicuo» del Bounded Context Canvas (9_DDD diap. 34-35).</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Decisiones de negocio" id="id-22b3e1521e35519496cd6864d15a5245">
        <documentation>Sección «Decisiones de negocio» del Bounded Context Canvas (9_DDD diap. 34-35).</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Comunicación saliente" id="id-f01514dca8f157d1b8f481c7ade223cc">
        <documentation>Sección «Comunicación saliente» del Bounded Context Canvas (9_DDD diap. 34-35).</documentation>
      </element>
      <element xsi:type="archimate:Grouping" name="Supuestos" id="id-3c73b767788452009376f2a2dab1fbec">
