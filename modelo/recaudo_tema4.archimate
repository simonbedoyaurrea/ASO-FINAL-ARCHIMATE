      </element>
      <element xsi:type="archimate:AssociationRelationship" id="id-34b09a8a8e0f564fb8825bfe5bd18658" source="id-ac364e03d66a51adb3469cc5a9dea6b0" target="id-951ac8f4e2215aa5acef60b4f62e823e">
        <documentation>Interés del interesado en esa fuerza, según lo que espera del recaudo (B1.1).</documentation>
      </element>
      <element xsi:type="archimate:AssociationRelationship" id="id-4443073d744a502b97f1086d5084905b" source="id-ac364e03d66a51adb3469cc5a9dea6b0" target="id-1eb5240150d55ecdb2af800beae599ca">
