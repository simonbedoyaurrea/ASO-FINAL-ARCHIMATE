        <property key="Versión" value="1.0"/>
        <property key="Nombre técnico" value="Contrato SA01: Intercambio con los equipos del concesionario"/>
        <property key="Formato y protocolo" value="Interfaz con el sistema central y archivos planos por lote; en línea cuando hay conexión o por lotes al llegar a patio o estación; formato propietario del fabricante, que la capa traduce (Entrevista B9.3 (l. 752-762); Entrevista B9.11 (l. 817-829))"/>
