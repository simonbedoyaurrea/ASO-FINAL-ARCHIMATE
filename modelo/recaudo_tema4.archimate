    <folder name="Fase 2 · Servicios, anticorrupción y contratos" id="id-7ea6479f1d3b5aceb3ec6604725231fe">
      <element xsi:type="archimate:BusinessActor" name="Pasarela de pagos (PSE y tarjeta)" id="id-9989f50586225c1f88099fd453c9545b">
