        <property key="Fuente" value="Entrevista B1.5 (l. 81-89); Entrevista B4.4 (l. 319-324)"/>
        <property key="Nombre técnico" value="La tarifa al usuario la fija la autoridad; el recaudo no la decide"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Los validadores, lectores y demás aparatos no son parte de la aplicación: solo se reciben sus transacciones" id="id-c2937893139d5212b91eaa988328c045">
        <documentation>Limita cómo se pueden cumplir los requerimientos.</documentation>
        <property key="Fuente" value="T4"/>
        <property key="Nombre técnico" value="Los validadores, lectores, dispositivos e IoT están fuera del alcance: solo se reciben sus transacciones"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Es plata pública: tiene control fiscal, contratación pública y control interno [normas por verificar]" id="id-985901f1bd0950d1a8afabd0f9a423e1">
        <documentation>Limita cómo se pueden cumplir los requerimientos.</documentation>
        <property key="Fuente" value="Entrevista B1.5 (l. 81-89); Entrevista B10.4 (l. 918-928)"/>
        <property key="Nombre técnico" value="Recursos públicos sujetos a control fiscal, contratación pública y control interno [normas por verificar]"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Protección de datos personales (Ley 1581 de 2012), incluidos datos sensibles de perfiles y de menores" id="id-47dbfbcf46fc5ff5908d390330884910">
        <documentation>Limita cómo se pueden cumplir los requerimientos.</documentation>
        <property key="Fuente" value="Entrevista B1.5 (l. 81-89); Entrevista B10.3 (l. 903-917); contrastada con el texto de la ley publicado por la Rama Judicial (H-41)"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Plazos de ley para responder peticiones (Ley 1755 de 2015: 15 días en general, 10 para documentos, 30 para consultas)" id="id-9e4202f5e6125735af15815db24c0d3d">
        <documentation>Limita cómo se pueden cumplir los requerimientos.</documentation>
        <property key="Fuente" value="Entrevista B10.5 (l. 929-937); contrastada con el texto de la ley publicado por entidades públicas (H-42)"/>
        <property key="Nombre técnico" value="Plazos legales de respuesta a peticiones (Ley 1755 de 2015: 15 días como regla general, 10 para documentos, 30 para consultas)"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Contratos largos con el concesionario y formatos de otros que el ente gestor no define" id="id-31b47fd6c4b250debb685167ce6e4a52">
        <documentation>Limita cómo se pueden cumplir los requerimientos.</documentation>
        <property key="Fuente" value="Entrevista B8.5 (l. 670-679)"/>
        <property key="Nombre técnico" value="Contratos de largo plazo con el concesionario y formatos externos que no define el ente gestor"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Mala conexión en estaciones y buses, y hora pico con miles de personas por validador" id="id-1532473414e5588bbb8f59d5373f5c68">
        <documentation>Limita cómo se pueden cumplir los requerimientos.</documentation>
        <property key="Fuente" value="Entrevista B1.5 (l. 81-89); Entrevista B6.4 (l. 475-482)"/>
        <property key="Nombre técnico" value="Conectividad imperfecta en estaciones y buses, y hora pico con miles de personas por validador"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Reglas de las franquicias de tarjetas y norma PCI-DSS para sus datos (norma del sector, no ley)" id="id-3b24906aa01658478ab3d5787b26cdfa">
        <documentation>Limita cómo se pueden cumplir los requerimientos.</documentation>
        <property key="Fuente" value="Entrevista B3.3 (l. 217-228); Entrevista B10.3 (l. 903-917)"/>
        <property key="Nombre técnico" value="Reglas de franquicias y estándar PCI-DSS para datos de tarjeta (estándar del sector, no ley)"/>
      </element>
      <element xsi:type="archimate:Value" name="Pagar rápido, con la tarifa correcta y sabiendo dónde está cada peso" id="id-af0f54603b915d09a662360e30450e96">
        <documentation>Valor que entrega la cadena al usuario y al ente gestor.</documentation>
        <property key="Fuente" value="T4; Entrevista B1.4 (l. 70-80)"/>
        <property key="Nombre técnico" value="Pago ágil con la tarifa correcta y cada peso trazable"/>
      </element>
    </folder>
    <folder name="Fase 3 · Dominios y lenguaje ubicuo" id="id-b6b1792c3270580b90e54426c7ba5ed2">
      <element xsi:type="archimate:Meaning" name="Pasar el medio de pago por un equipo para entrar; deja una transacción." id="id-25233cc108a55452a90dabdc8f6a5ee5">
        <documentation>Definición de «Validación».</documentation>
        <property key="Término" value="Validación"/>
        <property key="Contexto" value="BC-TRX, BC-TAR"/>
        <property key="Ejemplo" value="Pasar la VAMOS por el validador del alimentador."/>
        <property key="Nombre técnico" value="Uso del medio de pago en un equipo para acceder a un servicio: genera una transacción."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Cada subida al sistema, vista como parte de un viaje." id="id-044e3c8a85e452b8996b23f89ec3d262">
        <documentation>Definición de «Abordaje».</documentation>
        <property key="Término" value="Abordaje"/>
        <property key="Contexto" value="BC-TAR"/>
        <property key="Ejemplo" value="Un viaje alimentador + articulado tiene dos abordajes."/>
        <property key="Nombre técnico" value="Cada validación vista como parte de un viaje."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Varias subidas con el mismo medio que se unen por el transbordo." id="id-3d7a5081a8635ffb80898078dadb5a23">
        <documentation>Definición de «Viaje».</documentation>
        <property key="Término" value="Viaje"/>
        <property key="Contexto" value="BC-TAR"/>
        <property key="Ejemplo" value="Alimentador a las 7:05 y articulado a las 7:30 con una sola tarifa."/>
        <property key="Nombre técnico" value="Conjunto de abordajes del mismo medio enlazados por la integración tarifaria."/>
      </element>
      <element xsi:type="archimate:Meaning" name="La siguiente subida, dentro del tiempo permitido, que no paga la tarifa completa." id="id-0ed9019c33955b33ba7b536ef51370f5">
        <documentation>Definición de «Transbordo».</documentation>
        <property key="Término" value="Transbordo"/>
        <property key="Contexto" value="BC-TAR"/>
        <property key="Ejemplo" value="Cambiar de alimentador a articulado."/>
        <property key="Nombre técnico" value="Abordaje siguiente dentro de la ventana que no paga tarifa completa."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Tiempo desde la primera subida en el que vale el transbordo [valor configurable]." id="id-582b19ec936c5631851c46e76b443397">
        <documentation>Definición de «Ventana de transbordo».</documentation>
        <property key="Término" value="Ventana de transbordo"/>
        <property key="Contexto" value="BC-TAR"/>
        <property key="Ejemplo" value="El experto mencionó 60 a 90 minutos como supuesto."/>
        <property key="Nombre técnico" value="Tiempo desde el primer abordaje en el que aplica la integración [valor configurable]."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Tarifa normal, sin descuento." id="id-438029447412518cb1edc6a0008874a6">
        <documentation>Definición de «Tarifa plena».</documentation>
        <property key="Término" value="Tarifa plena"/>
        <property key="Contexto" value="BC-TAR"/>
        <property key="Ejemplo" value="La que paga un visitante con tarjeta bancaria."/>
        <property key="Nombre técnico" value="Tarifa al usuario sin beneficio."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Tarifa con descuento para un perfil autorizado por la autoridad." id="id-3223d33575c45cd592de8812ba8af383">
        <documentation>Definición de «Tarifa especial».</documentation>
        <property key="Término" value="Tarifa especial"/>
        <property key="Contexto" value="BC-TAR, BC-PER"/>
        <property key="Ejemplo" value="Estudiante universitario."/>
        <property key="Nombre técnico" value="Tarifa reducida de un perfil autorizado por la autoridad."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Lo que descontó el equipo en el momento de pasar el medio de pago." id="id-3c8d7e3dc72f5035b1c3428af5e30c08">
        <documentation>Definición de «Tarifa aplicada».</documentation>
        <property key="Término" value="Tarifa aplicada"/>
        <property key="Contexto" value="BC-TRX"/>
        <property key="Ejemplo" value="El validador descontó una tarifa plena."/>
        <property key="Nombre técnico" value="Valor que descontó el equipo en el momento de la validación."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Lo que debía cobrarse según la versión tarifaria, el perfil y el transbordo; la calcula la aplicación." id="id-95aadad562205dfdbe15ba65d4538968">
        <documentation>Definición de «Tarifa correcta».</documentation>
        <property key="Término" value="Tarifa correcta"/>
        <property key="Contexto" value="BC-TAR"/>
        <property key="Ejemplo" value="Debía ser transbordo y el equipo cobró completo: diferencia detectada."/>
        <property key="Nombre técnico" value="Valor que corresponde según la versión tarifaria, el perfil y la integración; la determina la aplicación."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Tarifas y reglas de transbordo que rigen desde una fecha, según una decisión de la autoridad." id="id-d708d9ec310c57a39ba926b02830a9cd">
        <documentation>Definición de «Versión tarifaria».</documentation>
        <property key="Término" value="Versión tarifaria"/>
        <property key="Contexto" value="BC-TAR"/>
        <property key="Ejemplo" value="La versión que entra en vigencia el primer día hábil del año."/>
        <property key="Nombre técnico" value="Conjunto de tarifas y reglas de integración con una vigencia, según un acto de la autoridad."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Derecho de una persona a tarifa con descuento: estudiante de colegio, universitario, adulto mayor o persona con movilidad reducida (Tema 4), con vigencia y estado." id="id-19c4d0c2bd1e5a349189dd1d0f422fd8">
        <documentation>Definición de «Perfil especial».</documentation>
        <property key="Término" value="Perfil especial"/>
        <property key="Contexto" value="BC-PER"/>
        <property key="Ejemplo" value="Perfil adulto mayor activo."/>
        <property key="Nombre técnico" value="Derecho de un titular a una tarifa especial: estudiante de colegio, universitario, adulto mayor o persona con movilidad reducida (T4), con vigencia y estado."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Soporte de una entidad certificadora de que la persona cumple las condiciones." id="id-cc56487a60795e2a8fe67f3503c4cf28">
        <documentation>Definición de «Certificación».</documentation>
        <property key="Término" value="Certificación"/>
        <property key="Contexto" value="BC-PER"/>
        <property key="Ejemplo" value="Listado de matrícula de una universidad."/>
        <property key="Nombre técnico" value="Evidencia de una entidad certificadora de que el titular cumple las condiciones."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Tarjeta de pago propia de la ciudad, anónima o personalizada." id="id-a6a732b5d7535b95b9de314a47eec222">
        <documentation>Definición de «Tarjeta VAMOS».</documentation>
        <property key="Término" value="Tarjeta VAMOS"/>
        <property key="Contexto" value="BC-MED"/>
        <property key="Ejemplo" value="Tarjeta comprada en una taquilla."/>
        <property key="Nombre técnico" value="Medio de pago propio de la ciudad, anónimo o personalizado."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Tarjeta VAMOS a nombre de una persona; permite perfil y reposición con saldo." id="id-b82be760c7bc5de1b0e9f3192f97b7d9">
        <documentation>Definición de «Tarjeta personalizada».</documentation>
        <property key="Término" value="Tarjeta personalizada"/>
        <property key="Contexto" value="BC-MED, BC-PER"/>
        <property key="Ejemplo" value="La del estudiante con su documento."/>
        <property key="Nombre técnico" value="Tarjeta VAMOS registrada a nombre de un titular; permite perfil y reposición con saldo."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Persona dueña de una tarjeta personalizada." id="id-9bdac85588915de8bdf3941bb1be6ef0">
        <documentation>Definición de «Titular».</documentation>
        <property key="Término" value="Titular"/>
        <property key="Contexto" value="BC-MED, BC-PER"/>
        <property key="Ejemplo" value="Quien reporta la pérdida."/>
        <property key="Nombre técnico" value="Persona registrada en una tarjeta personalizada."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Último saldo que la aplicación conoce por las transacciones que le llegan; el saldo real está en la tarjeta." id="id-f61f4f6a26dc5ddeb74395e62c3daedc">
        <documentation>Definición de «Saldo conocido».</documentation>
        <property key="Término" value="Saldo conocido"/>
        <property key="Contexto" value="BC-MED"/>
        <property key="Ejemplo" value="Consulta en la app: «saldo a las 18:40 de ayer»."/>
        <property key="Nombre técnico" value="Último saldo de una tarjeta que la aplicación conoce por las transacciones recibidas; el saldo real está en la tarjeta."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Recarga por internet ya pagada que todavía no se ha escrito en la tarjeta." id="id-2f4469ca15b15edcafdc9cd17658e401">
        <documentation>Definición de «Recarga pendiente».</documentation>
        <property key="Término" value="Recarga pendiente"/>
        <property key="Contexto" value="BC-MED"/>
        <property key="Ejemplo" value="«Pagué y no tengo saldo»."/>
        <property key="Nombre técnico" value="Recarga virtual pagada que aún no se escribió en la tarjeta."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Tarjeta que los equipos deben rechazar, con su causa (pérdida, fraude o deuda)." id="id-13f37efa6ef750b5af258e20d8800aac">
        <documentation>Definición de «Bloqueo».</documentation>
        <property key="Término" value="Bloqueo"/>
        <property key="Contexto" value="BC-MED, BC-PAB"/>
        <property key="Ejemplo" value="Tarjeta reportada como robada."/>
        <property key="Nombre técnico" value="Estado de un medio que los equipos deben rechazar, con causa (pérdida, fraude o deuda)."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Tarjeta personalizada nueva con el saldo que tenía la anterior a la hora en que el bloqueo ya regía en los equipos; se calcula cuando cerraron esos días." id="id-18d59fadd6c95577a5f700c9e35a0607">
        <documentation>Definición de «Reposición».</documentation>
        <property key="Término" value="Reposición"/>
        <property key="Contexto" value="BC-MED"/>
        <property key="Ejemplo" value="Tras la pérdida, con documento."/>
        <property key="Nombre técnico" value="Entrega de una nueva tarjeta personalizada con el saldo conocido a la hora del bloqueo efectivo, calculado cuando ya cerraron esos días de servicio."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Código que reemplaza el número de la tarjeta del banco." id="id-f96c19ad72335b13a0cc44c00f79442d">
        <documentation>Definición de «Token».</documentation>
        <property key="Término" value="Token"/>
        <property key="Contexto" value="BC-PAB"/>
        <property key="Ejemplo" value="Nunca se ve el número completo."/>
        <property key="Nombre técnico" value="Identificador que reemplaza el número de la tarjeta bancaria."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Cargo a la tarjeta del banco por los viajes acumulados: al cierre del día o antes si se pasa el umbral; puede haber más de un cargo al día, hasta el máximo configurado." id="id-9a20a235c6f5539ea45192ba07eae6d9">
        <documentation>Definición de «Cobro agrupado».</documentation>
        <property key="Término" value="Cobro agrupado"/>
        <property key="Contexto" value="BC-PAB"/>
        <property key="Ejemplo" value="Tres abordajes del día se cobran juntos en el cargo del cierre."/>
        <property key="Nombre técnico" value="Cargo a una tarjeta bancaria por los viajes acumulados: al cierre del día de servicio o antes si se supera el umbral; puede haber más de un cargo al día, hasta el máximo configurado."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Viajes ya hechos cuyo cobro fue rechazado." id="id-5a46cbdb519a5aaa94fca4c715520e6c">
        <documentation>Definición de «Deuda».</documentation>
        <property key="Término" value="Deuda"/>
        <property key="Contexto" value="BC-PAB"/>
        <property key="Ejemplo" value="Fondos insuficientes al cierre."/>
        <property key="Nombre técnico" value="Valor de viajes ya prestados cuyo cobro fue rechazado."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Cuando el dueño de la tarjeta le pide a su banco devolver un cobro, semanas después." id="id-24d7af8751d25a2c9a1e9e3fb458a048">
        <documentation>Definición de «Contracargo».</documentation>
        <property key="Término" value="Contracargo"/>
        <property key="Contexto" value="BC-PAB"/>
        <property key="Ejemplo" value="El titular desconoce el cargo."/>
        <property key="Nombre técnico" value="Reversión de un cobro que pide el titular a su banco, semanas después."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Jornada de operación con su hora de cierre; no es igual al día del calendario." id="id-7e1f00b118b054ef87d164d033e774dc">
        <documentation>Definición de «Día de servicio».</documentation>
        <property key="Término" value="Día de servicio"/>
        <property key="Contexto" value="BC-TRX, BC-CON, BC-RED"/>
        <property key="Ejemplo" value="Un viaje a las 00:30 puede pertenecer al día anterior."/>
        <property key="Nombre técnico" value="Jornada de operación con su hora de corte; no coincide con el día calendario."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Transacción que llega después del cierre de su día de servicio." id="id-6661e44b7c495b368e0fadddec65222a">
        <documentation>Definición de «Transacción tardía».</documentation>
        <property key="Término" value="Transacción tardía"/>
        <property key="Contexto" value="BC-TRX, BC-CON"/>
        <property key="Ejemplo" value="Bus que transmite al llegar a patio."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Transacción con un código que ya había llegado; se descarta." id="id-35c7cd35211554daa5d552e37be0c2cb">
        <documentation>Definición de «Transacción duplicada».</documentation>
        <property key="Término" value="Transacción duplicada"/>
        <property key="Contexto" value="BC-TRX"/>
        <property key="Ejemplo" value="Reintento del equipo."/>
        <property key="Nombre técnico" value="Transacción con un identificador ya recibido; se descarta."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Lo recaudado en un día de servicio, sumado por modo, ruta y operador." id="id-ac8491660c9f51d4a8bc1b0ecd15fbc1">
        <documentation>Definición de «Consolidado».</documentation>
        <property key="Término" value="Consolidado"/>
        <property key="Contexto" value="BC-CON"/>
        <property key="Ejemplo" value="El cierre del martes."/>
        <property key="Nombre técnico" value="Recaudo de un día de servicio por modo, ruta y operador."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Consumo consolidado de días cerrados por modo, ruta y operador que la aplicación entrega para cuadrar y liquidar; todavía no está conciliado." id="id-2fb669acbac15423a460710dece2fa13">
        <documentation>Definición de «Base de distribución».</documentation>
        <property key="Término" value="Base de distribución"/>
        <property key="Contexto" value="BC-CON"/>
        <property key="Ejemplo" value="La que recibe el analista de liquidación."/>
        <property key="Nombre técnico" value="Consumo consolidado de días cerrados por modo, ruta y operador que la aplicación entrega para conciliar y liquidar; todavía no está conciliado."/>
      </element>
      <element xsi:type="archimate:Meaning" name="Corrección autorizada de un saldo o de una transacción, que deja rastro." id="id-45a233f9908f556ba8ae00ffd0e4d71b">
