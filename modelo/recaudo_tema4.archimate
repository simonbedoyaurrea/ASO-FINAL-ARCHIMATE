      </element>
      <element xsi:type="archimate:Requirement" name="Corregir saldos y transacciones solo con ajustes autorizados que dejan rastro, nunca editándolos" id="id-745c4e30845a57c997f3122bbfab2c27">
        <documentation>Derivado de lo que dijo el experto (la entrevista no preguntó requerimientos).</documentation>
        <property key="Fuente" value="Entrevista B8.4 (l. 654-669); Entrevista B4.3 (l. 311-318)"/>
        <property key="Nombre técnico" value="Corregir saldos y transacciones solo con ajustes autorizados que dejan huella, nunca editándolos"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Que quien propone un ajuste, una devolución o un desbloqueo no sea quien lo aprueba" id="id-aeef26ab26e25356bcdbc0ac2625f716">
