  <folder name="Application" id="id-3fbdcd056e695ef19845dd026febcfc2" type="application">
<folder xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="V10–V11 · Trazabilidad y canvas" id="id-b7519c72ba1159d3818463e0651bfd02">
  <element xsi:type="archimate:ApplicationProcess" id="id-0e2c5abd12435a599ca1611366d26515" name="Tarifar validación">
    <documentation>Calcular la tarifa correcta
C · Tarifar validación. Usar versión y perfil vigentes en el instante del viaje; reconocer transbordo.</documentation>
    <property key="Fuente de diseño" value="Bocetos/Analisis-V10-V11.md; Tema 4; revisión V10/V11" />
  </element>
  <element xsi:type="archimate:ApplicationEvent" id="id-76fe10d322d9542ba6f2a0334ec23480" name="Validación tarificada">
    <documentation>VAMOS / Pago bancario / Consolidación
E · Validación tarificada: importe y versión. VAMOS mueve saldo; banco cobra; Consolidación atribuye sin conciliar. C/P.</documentation>
    <property key="Fuente de diseño" value="Bocetos/Analisis-V10-V11.md; Tema 4; revisión V10/V11" />
  </element>
  <element xsi:type="archimate:ApplicationEvent" id="id-9b5659ce24d05db59fbc3532c78db0ae" name="Versión tarifaria publicada">
    <documentation>Equipos de validación (externos)
E · Versión tarifaria publicada, a través de la integración ACL. No administrar el equipo.</documentation>
    <property key="Fuente de diseño" value="Bocetos/Analisis-V10-V11.md; Tema 4; revisión V10/V11" />
  </element>
  <element xsi:type="archimate:ApplicationProcess" id="id-eac5d863b82152ba90ac6a18857a450d" name="Versionar las reglas tarifarias">
    <documentation>Versionar las reglas
Guardar tarifa plena, reglas de perfil e integración; validar que la versión sea aplicable.</documentation>
    <property key="Fuente de diseño" value="Bocetos/Analisis-V10-V11.md; Tema 4; revisión V10/V11" />
  </element>
</folder>









    <folder name="Fase 1 · Motivación, capacidades y E2E" id="id-9b1d59cfd98f5f45ba74613449bbf1e8">
      <element xsi:type="archimate:ApplicationComponent" name="Aplicación de recaudo" id="id-fd77f19172d056f9b2255385107149ce">
        <documentation>La aplicación que se diseña: plataforma de recaudo del ente gestor (D-01). Se descompone en contextos delimitados en la Fase 5.</documentation>
      </element>
    </folder>
    <folder name="Fase 4 · Agregados, comandos y eventos" id="id-ed65e81247a753d490531e9891127a31">
      <element xsi:type="archimate:DataObject" name="Tarjeta VAMOS" id="id-293c5c7d28e35dbeba975b57ebf59903">
        <documentation>Entidad raíz del agregado: único punto de acceso y responsable de sus invariantes (9_DDD diap. 20).</documentation>
        <property key="Rol en el agregado" value="Raíz"/>
        <property key="Invariante 1" value="Una tarjeta física se registra una sola vez (número único)."/>
        <property key="Invariante 2" value="El saldo conocido solo cambia por movimientos registrados (validación, recarga acreditada o ajuste aprobado); nunca se edita."/>
        <property key="Invariante 3" value="Una tarjeta bloqueada por pérdida no vuelve a activarse: se repone."/>
        <property key="Invariante 4" value="Solo una tarjeta personalizada puede reponerse con traslado de saldo; la anónima no."/>
        <property key="Invariante 5" value="El saldo que se traslada es el saldo conocido a la hora del bloqueo efectivo (cuando la versión de la lista que incluye la tarjeta ya rige en los equipos) y solo se calcula cuando cerraron los días de servicio de esa hora, sin tardías pendientes; lo consumido entre la solicitud y el bloqueo efectivo se descuenta y no se devuelve."/>
      </element>
      <element xsi:type="archimate:DataObject" name="Movimiento de saldo" id="id-e8e4137ffb35570a8eb60490b113c4ba">
        <documentation>Entidad interna de Tarjeta VAMOS: tiene identidad local y solo se accede por la raíz.</documentation>
        <property key="Rol en el agregado" value="Entidad"/>
      </element>
      <element xsi:type="archimate:DataObject" name="Número de tarjeta" id="id-e6873073d1a256c19fd6fb2ea3a4efdf">
        <documentation>Objeto de valor: sin identidad propia e inmutable (9_DDD diap. 32).</documentation>
        <property key="Rol en el agregado" value="Objeto de valor"/>
      </element>
      <element xsi:type="archimate:DataObject" name="Tipo de tarjeta" id="id-1f345775d937508e9981ffce0509e4f5">
        <documentation>Objeto de valor: sin identidad propia e inmutable (9_DDD diap. 32).</documentation>
        <property key="Rol en el agregado" value="Objeto de valor"/>
      </element>
      <element xsi:type="archimate:DataObject" name="Estado de la tarjeta" id="id-0404005cc21c59499a33074f9a5ccf48">
        <documentation>Objeto de valor: sin identidad propia e inmutable (9_DDD diap. 32).</documentation>
        <property key="Rol en el agregado" value="Objeto de valor"/>
      </element>
      <element xsi:type="archimate:DataObject" name="Saldo conocido" id="id-9bf8235dc6e85a41bf532d2be694346c">
        <documentation>Objeto de valor: sin identidad propia e inmutable (9_DDD diap. 32).</documentation>
        <property key="Rol en el agregado" value="Objeto de valor"/>
      </element>
      <element xsi:type="archimate:DataObject" name="Referencia al titular" id="id-c8a5452e3d3f5a59b13fd25c6f0c335a">
        <documentation>Objeto de valor: sin identidad propia e inmutable (9_DDD diap. 32).</documentation>
        <property key="Rol en el agregado" value="Objeto de valor"/>
      </element>
