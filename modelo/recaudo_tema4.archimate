      <element xsi:type="archimate:ApplicationService" name="Enviar avisos" id="id-b5ce198017b55c59a24543d8d385be1d">
        <documentation>Servicio de aplicación de Contexto Notificaciones.</documentation>
        <property key="Nombre técnico" value="Envío de notificaciones"/>
      </element>
