        <property key="Tipo" value="Externo"/>
        <property key="Nombre técnico" value="Sistemas de las certificadoras"/>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="Interfaz SA05" id="id-f68c25cdbd955da3a6a2d2720c059335">
        <documentation>Interfaz de la capa anticorrupción para «Verificación con entidades certificadoras de perfiles». Patrón: Capa anticorrupción. Listados, certificados y consultas heterogéneas (B9.9).</documentation>
        <property key="Patrón" value="Capa anticorrupción"/>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Traductor SA05: Verificación con las entidades que certifican perfiles" id="id-0af83b81aad4540684f3c8aaa7333537">
        <documentation>Traduce entre el modelo de Contexto Perfiles y beneficios y «Sistemas de las certificadoras». Listados, certificados y consultas heterogéneas (B9.9).</documentation>
        <property key="Patrón" value="Capa anticorrupción"/>
        <property key="Nombre técnico" value="ACL SA05: Verificación con entidades certificadoras de perfiles"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Sistema de quejas y reclamos (PQRS)" id="id-72bc9af26c1e5503b23799dde9e07d42">
        <documentation>Sistema externo (Proceso interno). No forma parte de la aplicación.</documentation>
        <property key="Tipo" value="Externo"/>
        <property key="Nombre técnico" value="Sistema de PQRS"/>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="Interfaz SA06" id="id-ffa5b52c722755529f2232d177adfb21">
        <documentation>Interfaz de la capa anticorrupción para «Servicio al cliente (PQRS)». Patrón: Servicio abierto + lenguaje publicado. La aplicación ofrece el historial y los ajustes a PQRS.</documentation>
        <property key="Patrón" value="Servicio abierto + lenguaje publicado"/>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Traductor SA06: Servicio al cliente (PQRS)" id="id-9d013ca9266a5f7b94901a345ef73f51">
        <documentation>Traduce entre el modelo de Contexto Ajustes y soporte a reclamos y «Sistema de PQRS». La aplicación ofrece el historial y los ajustes a PQRS.</documentation>
        <property key="Patrón" value="Servicio abierto + lenguaje publicado"/>
        <property key="Nombre técnico" value="ACL SA06: Servicio al cliente (PQRS)"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Sistema contable y financiero (ERP)" id="id-f983fc45a02556809b0180d1568d20d0">
        <documentation>Sistema externo (Proceso interno). No forma parte de la aplicación.</documentation>
        <property key="Tipo" value="Externo"/>
        <property key="Nombre técnico" value="Sistema financiero (ERP)"/>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="Interfaz SA07" id="id-759c711c2837598e9f45da93e313c8fb">
        <documentation>Interfaz de la capa anticorrupción para «Registro contable del recaudo». Patrón: Lenguaje publicado. Resumen contable en un formato acordado con el área financiera.</documentation>
        <property key="Patrón" value="Lenguaje publicado"/>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Traductor SA07: Envío a contabilidad" id="id-b01b3e57354a56a3b7a90b099bd2cdec">
        <documentation>Traduce entre el modelo de Contexto Consolidación del recaudo y «Sistema financiero (ERP)». Resumen contable en un formato acordado con el área financiera.</documentation>
        <property key="Patrón" value="Lenguaje publicado"/>
        <property key="Nombre técnico" value="ACL SA07: Registro contable del recaudo"/>
      </element>
